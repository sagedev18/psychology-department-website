                  <img alt=\"ESUT Crest\" class=\"w-full h-full object-contain\" data-kid=\"2-10-1-1-1-1-1\" data-name=\"footer crest image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Enugu-State-University-of-Science-and-Technology-logo.jpg\"/>\n                    </div>\n                    <div data-kid=\"2-10-1-1-1-2\" data-name=\"footer brand text\">\n                        <p class=\"font-bold text-white text-sm\" data-kid=\"2-10-1-1-1-2-1\" data-name=\"footer department name\">\n                            Department of Psychology\n                        </p>\n                        <p class=\"text-[11px] text-stone-400\" data-kid=\"2-10-1-1-1-2-2\" data-name=\"footer campus line\">\n                            ESUT Agbani Campus\n                        </p>\n                    </div>\n                </div>\n                <p class=\"text-stone-400 leading-relaxed text-[11px] mt-1\" data-kid=\"2-10-1-1-2\" data-name=\"footer full address\">\n                    Enugu State University of Science and Technology (ESUT), P.M.B. 01660, Agbani, Enugu State, Nigeria.\n                </p>\n                <p class=\"text-amber-400 text-[11px] font-semibold\" data-kid=\"2-10-1-1-3\" data-name=\"NUC accreditation badge\">\n                    <i class=\"fa-solid fa-shield-halved mr-1\" data-kid=\"2-10-1-1-3-1\" data-name=\"shield icon\">\n                    </i>\n                    NUC Fully Accredited Programmes\n                </p>\n            </div>\n            <!-- Degree Routes Links -->\n            <div data-kid=\"2-10-1-2\" data-name=\"academic programmes link column\">\n                <p class=\"font-bold text-white text-sm mb-3\" data-kid=\"2-10-1-2-1\" data-name=\"programmes column heading\">\n                    Academic Programmes\n                </p>\n                <ul class=\"space-y-2 text-stone-400\" data-kid=\"2-10-1-2-2\" data-name=\"programmes link list\">\n                    <li data-kid=\"2-10-1-2-2-1\" data-name=\"UTME link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-2-2-1-1\" data-name=\"UTME link\" href=\"programs.html#undergrad\">\n                            4-Year B.Sc Psychology (UTME)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-2-2-2\" data-name=\"direct entry link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-2-2-2-1\" data-name=\"direct entry link\" href=\"programs.html#direct-entry\">\n                            3-Year B.Sc Psychology (Direct Entry)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-2-2-3\" data-name=\"ICS link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-2-2-3-1\" data-name=\"ICS link\" href=\"programs.html#ics\">\n                            Continuing Studies (ICS 3, 4, 5-Year)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-2-2-4\" data-name=\"PGD link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-2-2-4-1\" data-name=\"PGD link\" href=\"programs.html#pgd\">\n                            Postgraduate Diploma (PGD)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-2-2-5\" data-name=\"M.Sc link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-2-2-5-1\" data-name=\"M.Sc link\" href=\"programs.html#msc\">\n                            Master of Science (M.Sc)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-2-2-6\" data-name=\"Ph.D link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-2-2-6-1\" data-name=\"Ph.D link\" href=\"programs.html#phd\">\n                            Doctor of Philosophy (Ph.D)\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <!-- Curriculum & Research Links -->\n            <div data-kid=\"2-10-1-3\" data-name=\"curriculum governance link column\">\n                <p class=\"font-bold text-white text-sm mb-3\" data-kid=\"2-10-1-3-1\" data-name=\"governance column heading\">\n                    Curriculum & Governance\n                </p>\n                <ul class=\"space-y-2 text-stone-400\" data-kid=\"2-10-1-3-2\" data-name=\"governance link list\">\n                    <li data-kid=\"2-10-1-3-2-1\" data-name=\"history link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-3-2-1-1\" data-name=\"history link\" href=\"about.html\">\n                            Department History & Mission\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-3-2-2\" data-name=\"course descriptions link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-3-2-2-1\" data-name=\"course descriptions link\" href=\"course-descriptions.html\">\n                            Course Descriptions Directory\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-3-2-3\" data-name=\"undergraduate curriculum link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-3-2-3-1\" data-name=\"undergraduate curriculum link\" href=\"academics.html\">\n                            Undergraduate Curriculum\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-3-2-4\" data-name=\"faculty profiles link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-3-2-4-1\" data-name=\"faculty profiles link\" href=\"staff.html\">\n                            Academic Faculty Profiles\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-3-2-5\" data-name=\"seminar series link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-3-2-5-1\" data-name=\"seminar series link\" href=\"news.html\">\n                            Departmental Seminar Series\n                        </a>\n                    </li>\n                    <li data-kid=\"2-10-1-3-2-6\" data-name=\"exam schedule link item\">\n                        <a class=\"hover:text-white transition-colors\" data-kid=\"2-10-1-3-2-6-1\" data-name=\"exam schedule link\" href=\"exam-timetable.pdf\" target=\"_blank\">\n                            Current Exam Schedule\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <!-- Official Contact Info -->\n            <div data-kid=\"2-10-1-4\" data-name=\"contact admin column\">\n                <p class=\"font-bold text-white text-sm mb-3\" data-kid=\"2-10-1-4-1\" data-name=\"contact column heading\">\n                    Contact Administration\n                </p>\n                <div class=\"space-y-2.5 text-stone-400 text-[11px]\" data-kid=\"2-10-1-4-2\" data-name=\"contact details list\">\n                    <p class=\"flex items-start gap-2\" data-kid=\"2-10-1-4-2-1\" data-name=\"department email row\">\n                        <i class=\"fa-solid fa-envelope text-stone-300 mt-0.5\" data-kid=\"2-10-1-4-2-1-1\" data-name=\"envelope icon\">\n                        </i>\n                        <span data-kid=\"2-10-1-4-2-1-2\" data-name=\"department email text\">\n                            psychology@esut.edu.ng\n                        </span>\n                    </p>\n                    <p class=\"flex items-start gap-2\" data-kid=\"2-10-1-4-2-2\" data-name=\"HOD email row\">\n                        <i class=\"fa-solid fa-envelope text-stone-300 mt-0.5\" data-kid=\"2-10-1-4-2-2-1\" data-name=\"envelope icon\">\n                        </i>\n                        <span data-kid=\"2-10-1-4-2-2-2\" data-name=\"HOD email text\">\n                            hod.psychology@esut.edu.ng\n                        </span>\n                    </p>\n                    <p class=\"flex items-start gap-2\" data-kid=\"2-10-1-4-2-3\" data-name=\"location row\">\n                        <i class=\"fa-solid fa-location-dot text-stone-300 mt-0.5\" data-kid=\"2-10-1-4-2-3-1\" data-name=\"location pin icon\">\n                        </i>\n                        <span data-kid=\"2-10-1-4-2-3-2\" data-name=\"location text\">\n                            Faculty of Social Sciences Building, ESUT Campus, Agbani\n                        </span>\n                    </p>\n                    <div class=\"pt-2\" data-kid=\"2-10-1-4-2-4\" data-name=\"contact CTA block\">\n                        <a class=\"inline-flex items-center gap-1.5 bg-stone-800 hover:bg-stone-700 text-stone-200 px-3 py-1.5 rounded font-semibold text-xs border border-stone-700 transition-colors\" data-kid=\"2-10-1-4-2-4-1\" data-name=\"send official enquiry button\" href=\"contact.html\">\n                            <span data-kid=\"2-10-1-4-2-4-1-1\" data-name=\"enquiry label\">\n                                Send Official Enquiry\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-10-1-4-2-4-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Bottom Copyright -->\n        <div class=\"max-w-7xl mx-auto pt-6 flex flex-wrap items-center justify-between gap-4 text-[11px] text-stone-500\" data-kid=\"2-10-2\" data-name=\"footer bottom bar\">\n            <p data-kid=\"2-10-2-1\" data-name=\"copyright notice\">\n                © 2026 Department of Psychology, Enugu State University of Science and Technology (ESUT). All Rights Reserved.\n            </p>\n            <div class=\"flex items-center gap-4\" data-kid=\"2-10-2-2\" data-name=\"footer bottom right group\">\n                <span data-kid=\"2-10-2-2-1\" data-name=\"campus location text\">\n                    Agbani Campus, Enugu\n                </span>\n                <span data-kid=\"2-10-2-2-2\" data-name=\"separator dot\">\n                    ·\n                </span>\n                <a class=\"hover:text-stone-300\" data-kid=\"2-10-2-2-3\" data-name=\"university portal link\" href=\"https://portal.esut.edu.ng\">\n                    University Main Portal\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n",
