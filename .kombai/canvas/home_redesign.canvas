      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap');\n  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');\n\n  :root {\n    --primary: #701500;\n    --primary-dark: #4a0d00;\n    --primary-light: #8e1f06;\n    --secondary: #f67665;\n    --secondary-soft: #fff1ef;\n    --gold: #d9b15a;\n    --surface-warm: #faf7f5;\n    --text-ink: #191c1f;\n    --text-muted: #5e646e;\n    --border-subtle: rgba(112, 21, 0, 0.12);\n  }\n\n  body {\n    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n    color: var(--text-ink);\n    background-color: #ffffff;\n    margin: 0;\n    padding: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  h1, h2, h3, h4, .font-heading {\n    font-family: 'Poppins', sans-serif;\n  }\n\n  .route-tab.active {\n    background-color: #701500;\n    color: #ffffff;\n    border-color: #701500;\n  }\n\n  .route-tab:not(.active) {\n    background-color: #ffffff;\n    color: #5e646e;\n    border-color: #e5e7eb;\n  }\n\n  .route-tab:not(.active):hover {\n    background-color: #faf7f5;\n    color: #191c1f;\n    border-color: #d1d5db;\n  }\n</style>\n<div class=\"min-h-screen flex flex-col bg-white text-[#191c1f]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Institutional Utility Topbar -->\n    <aside class=\"bg-[#4a0d00] text-white/90 text-xs py-2 px-6 border-b border-white/10\" data-kid=\"1-1\" data-name=\"institutional utility topbar\">\n        <div class=\"max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4\" data-kid=\"1-1-1\" data-name=\"topbar content flex container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"university and faculty identification group\">\n                <span class=\"inline-flex items-center gap-1.5 font-medium tracking-wide text-[#f67665]\" data-kid=\"1-1-1-1-1\" data-name=\"university name with graduation cap icon\">\n                    <i class=\"fa-solid fa-graduation-cap\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                    Enugu State University of Science and Technology\n                </span>\n                <span class=\"text-white/30\" data-kid=\"1-1-1-1-2\" data-name=\"identifier vertical separator\">\n                    |\n                </span>\n                <span class=\"text-white/80\" data-kid=\"1-1-1-1-3\" data-name=\"faculty name text\">\n                    Faculty of Social Sciences & Humanities\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5 text-white/80\" data-kid=\"1-1-1-2\" data-name=\"topbar quick action links group\">\n                <a class=\"hover:text-white transition flex items-center gap-1.5\" data-kid=\"1-1-1-2-1\" data-name=\"notice board link\" href=\"#bulletin\">\n                    <i class=\"fa-solid fa-bell text-[#f67665]\" data-kid=\"1-1-1-2-1-1\" data-name=\"bell notification icon\">\n                    </i>\n                    Notice Board (2025/2026)\n                </a>\n                <a class=\"hover:text-white transition flex items-center gap-1.5\" data-kid=\"1-1-1-2-2\" data-name=\"student downloads link\" href=\"#resources\">\n                    <i class=\"fa-solid fa-download text-[#d9b15a]\" data-kid=\"1-1-1-2-2-1\" data-name=\"download arrow icon\">\n                    </i>\n                    Student Downloads\n                </a>\n                <a class=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded bg-white/10 hover:bg-white/20 text-white text-[11px] font-medium transition\" data-kid=\"1-1-1-2-3\" data-name=\"staff portal link with lock badge\" href=\"admin website/index.html\">\n                    <i class=\"fa-solid fa-lock text-[10px]\" data-kid=\"1-1-1-2-3-1\" data-name=\"lock icon\">\n                    </i>\n                    Staff Portal\n                </a>\n            </div>\n        </div>\n    </aside>\n    <!-- Main Navigation Masthead -->\n    <header class=\"sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-[#701500]/10 shadow-xs\" data-kid=\"1-2\" data-name=\"main navigation masthead\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between gap-6\" data-kid=\"1-2-1\" data-name=\"masthead inner flex container\">\n            <a class=\"flex items-center gap-3.5 group\" data-kid=\"1-2-1-1\" data-name=\"department logo and name brand link\" href=\"index.html\">\n                <img alt=\"ESUT Crest\" class=\"w-13 h-13 object-contain rounded-md border border-[#701500]/15 p-1 bg-white shadow-2xs group-hover:border-[#701500]/40 transition\" data-kid=\"1-2-1-1-1\" data-name=\"ESUT crest logo image\" src=\"/api/local/images/Enugu-State-University-of-Science-and-Technology-logo.jpg\"/>\n                <div class=\"flex flex-col\" data-kid=\"1-2-1-1-2\" data-name=\"brand text block\">\n                    <span class=\"text-xl font-bold font-heading text-[#701500] leading-tight tracking-tight\" data-kid=\"1-2-1-1-2-1\" data-name=\"department name headline\">\n                        Department of Psychology\n                    </span>\n                    <span class=\"text-xs text-stone-600 font-medium tracking-wide\" data-kid=\"1-2-1-1-2-2\" data-name=\"campus location subtitle\">\n                        ESUT Agbani Campus · Enugu State, Nigeria\n                    </span>\n                </div>\n            </a>\n            <!-- Desktop Nav Links -->\n            <nav class=\"hidden lg:flex items-center gap-1 text-[14px] font-medium text-stone-700\" data-kid=\"1-2-1-2\" data-name=\"desktop navigation links\">\n                <a class=\"px-3 py-2 rounded-lg text-[#701500] font-semibold bg-[#701500]/8\" data-kid=\"1-2-1-2-1\" data-name=\"home nav link (active)\" href=\"index.html\">\n                    Home\n                </a>\n                <a class=\"px-3 py-2 rounded-lg hover:text-[#701500] hover:bg-stone-100 transition\" data-kid=\"1-2-1-2-2\" data-name=\"about us nav link\" href=\"about.html\">\n                    About Us\n                </a>\n                <a class=\"px-3 py-2 rounded-lg hover:text-[#701500] hover:bg-stone-100 transition\" data-kid=\"1-2-1-2-3\" data-name=\"degree programmes nav link\" href=\"programs.html\">\n                    Degree Programmes\n                </a>\n                <a class=\"px-3 py-2 rounded-lg hover:text-[#701500] hover:bg-stone-100 transition\" data-kid=\"1-2-1-2-4\" data-name=\"curriculum nav link\" href=\"academics.html\">\n                    Curriculum\n                </a>\n                <a class=\"px-3 py-2 rounded-lg hover:text-[#701500] hover:bg-stone-100 transition\" data-kid=\"1-2-1-2-5\" data-name=\"seminars and news nav link\" href=\"news.html\">\n                    Seminars & News\n                </a>\n                <a class=\"px-3 py-2 rounded-lg hover:text-[#701500] hover:bg-stone-100 transition\" data-kid=\"1-2-1-2-6\" data-name=\"faculty nav link\" href=\"staff.html\">\n                    Faculty\n                </a>\n                <a class=\"px-3 py-2 rounded-lg hover:text-[#701500] hover:bg-stone-100 transition\" data-kid=\"1-2-1-2-7\" data-name=\"contact nav link\" href=\"contact.html\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-3\" data-name=\"apply action area\">\n                <a class=\"hidden sm:inline-flex items-center gap-2 bg-[#701500] hover:bg-[#8e1f06] text-white text-xs font-semibold px-4 py-2.5 rounded-lg shadow-xs transition\" data-kid=\"1-2-1-3-1\" data-name=\"apply or enroll call-to-action button\" href=\"#routes\">\n                    <span data-kid=\"1-2-1-3-1-1\" data-name=\"apply or enroll label\">\n                        Apply / Enroll\n                    </span>\n                    <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"1-2-1-3-1-2\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- Hero Section with Disciplinary Anchor & Leadership Statement -->\n    <section class=\"relative bg-gradient-to-b from-[#faf7f5] via-white to-white border-b border-[#701500]/10 pt-12 pb-16 px-6\" data-kid=\"1-3\" data-name=\"hero section with disciplinary anchor\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-3-1\" data-name=\"hero content max-width container\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\" data-kid=\"1-3-1-1\" data-name=\"hero two-column grid\">\n                <!-- Disciplinary Headline & Primary Actions -->\n                <div class=\"lg:col-span-7 space-y-6\" data-kid=\"1-3-1-1-1\" data-name=\"hero headline and actions column\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#701500]/8 text-[#701500] text-xs font-semibold tracking-wide\" data-kid=\"1-3-1-1-1-1\" data-name=\"accreditation badge pill\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#701500]\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"badge leading dot indicator\">\n                        </span>\n                        <span data-kid=\"1-3-1-1-1-1-2\" data-name=\"accreditation badge text\">\n                            Accredited Academic Department · Founded 2008\n                        </span>\n                    </div>\n                    <h1 class=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#701500] font-heading tracking-tight leading-[1.18]\" data-kid=\"1-3-1-1-1-2\" data-name=\"hero headline text\">\n                        Scientific Understanding of Behaviour, Mind, and Human Potential.\n                    </h1>\n                    <p class=\"text-stone-700 text-base sm:text-lg leading-relaxed max-w-2xl\" data-kid=\"1-3-1-1-1-3\" data-name=\"hero supporting description\">\n                        From biological foundations to social dynamics, our programmes equip students to explain, predict, and guide human behaviour through ethical research, psychometrics, clinical care, and organizational leadership.\n                    </p>\n                    <!-- Primary Direct Actions -->\n                    <div class=\"flex flex-wrap items-center gap-4 pt-2\" data-kid=\"1-3-1-1-1-4\" data-name=\"hero primary actions row\">\n                        <a class=\"inline-flex items-center gap-2.5 bg-[#701500] hover:bg-[#8e1f06] text-white font-semibold text-sm px-6 py-3 rounded-lg shadow-sm transition\" data-kid=\"1-3-1-1-1-4-1\" data-name=\"compare degree pathways button\" href=\"#routes\">\n                            <i class=\"fa-solid fa-table-list text-xs\" data-kid=\"1-3-1-1-1-4-1-1\" data-name=\"table list icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-1-4-1-2\" data-name=\"compare pathways label\">\n                                Compare Degree Pathways\n                            </span>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 bg-white hover:bg-stone-50 text-stone-800 font-semibold text-sm px-5 py-3 rounded-lg border border-stone-300 shadow-2xs transition\" data-kid=\"1-3-1-1-1-4-2\" data-name=\"academic prospectus button\" href=\"#prospectus\">\n                            <i class=\"fa-solid fa-book-open text-xs text-[#701500]\" data-kid=\"1-3-1-1-1-4-2-1\" data-name=\"open book icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-1-4-2-2\" data-name=\"prospectus label\">\n                                Academic Prospectus\n                            </span>\n                        </a>\n                        <a class=\"inline-flex items-center gap-1.5 text-xs font-semibold text-[#701500] hover:underline px-2 py-3\" data-kid=\"1-3-1-1-1-4-3\" data-name=\"student downloads link\" href=\"#resources\">\n                            <span data-kid=\"1-3-1-1-1-4-3-1\" data-name=\"downloads link label\">\n                                Student Downloads & Timetable\n                            </span>\n                            <i class=\"fa-solid fa-arrow-up-right-from-square text-[10px]\" data-kid=\"1-3-1-1-1-4-3-2\" data-name=\"external link arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <!-- Academic Highlights Trust Band -->\n                    <div class=\"pt-4 border-t border-stone-200/80 flex flex-wrap items-center gap-y-3 gap-x-8 text-xs text-stone-600\" data-kid=\"1-3-1-1-1-5\" data-name=\"academic highlights trust band\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-1-5-1\" data-name=\"academic highlight item 1\">\n                            <i class=\"fa-solid fa-circle-check text-[#701500]\" data-kid=\"1-3-1-1-1-5-1-1\" data-name=\"checkmark circle icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-1-5-1-2\" data-name=\"B.Sc NUC approved label\">\n                                B.Sc Psychology (NUC Approved)\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-1-5-2\" data-name=\"academic highlight item 2\">\n                            <i class=\"fa-solid fa-circle-check text-[#701500]\" data-kid=\"1-3-1-1-1-5-2-1\" data-name=\"checkmark circle icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-1-5-2-2\" data-name=\"ICS evening options label\">\n                                ICS Flexible Evening Options\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-1-5-3\" data-name=\"academic highlight item 3\">\n                            <i class=\"fa-solid fa-circle-check text-[#701500]\" data-kid=\"1-3-1-1-1-5-3-1\" data-name=\"checkmark circle icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-1-5-3-2\" data-name=\"PGD and PhD specializations label\">\n                                PGD, M.Sc & Ph.D Specializations\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Head of Department Signed Welcome Address Card -->\n                <div class=\"lg:col-span-5\" data-kid=\"1-3-1-1-2\" data-name=\"department head card column\">\n                    <div class=\"bg-white rounded-2xl border border-[#701500]/15 shadow-sm p-7 relative overflow-hidden\" data-kid=\"1-3-1-1-2-1\" data-name=\"department head signed welcome card\">\n                        <div class=\"absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#701500] via-[#f67665] to-[#d9b15a]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"card top gradient accent bar\">\n                        </div>\n                        <div class=\"flex items-center gap-4 mb-5\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"department head identity row\">\n                            <div class=\"w-14 h-14 rounded-full bg-[#701500]/10 border border-[#701500]/20 flex items-center justify-center text-[#701500] shrink-0\" data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"head portrait avatar circle\">\n                                <i class=\"fa-solid fa-user-tie text-2xl\" data-kid=\"1-3-1-1-2-1-2-1-1\" data-name=\"user with tie icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-3-1-1-2-1-2-2\" data-name=\"head name and title block\">\n                                <span class=\"text-[11px] font-bold uppercase tracking-wider text-[#f67665]\" data-kid=\"1-3-1-1-2-1-2-2-1\" data-name=\"department leadership label\">\n                                    Department Leadership\n                                </span>\n                                <h3 class=\"text-base font-bold text-stone-900 font-heading\" data-kid=\"1-3-1-1-2-1-2-2-2\" data-name=\"head of department name\">\n                                    Dr. Ada Okafor\n                                </h3>\n                                <p class=\"text-xs text-stone-600\" data-kid=\"1-3-1-1-2-1-2-2-3\" data-name=\"head role and rank subtitle\">\n                                    Head of Department · Senior Lecturer\n                                </p>\n                            </div>\n                        </div>\n                        <blockquote class=\"text-sm text-stone-700 leading-relaxed italic border-l-2 border-[#701500]/30 pl-3.5 mb-5\" data-kid=\"1-3-1-1-2-1-3\" data-name=\"welcome quote blockquote\">\n                            \"We prepare rigorous, ethical thinkers capable of addressing Nigeria's mental health, organizational, and educational challenges. Whether starting with our undergraduate degree or advancing research at the doctoral level, you enter a vibrant community of empirical inquiry.\"\n                        </blockquote>\n                        <div class=\"pt-4 border-t border-stone-100 flex items-center justify-between text-xs\" data-kid=\"1-3-1-1-2-1-4\" data-name=\"card footer with contact and link\">\n                            <span class=\"text-stone-600 flex items-center gap-1.5\" data-kid=\"1-3-1-1-2-1-4-1\" data-name=\"head email with envelope icon\">\n                                <i class=\"fa-solid fa-envelope text-[#701500]\" data-kid=\"1-3-1-1-2-1-4-1-1\" data-name=\"envelope icon\">\n                                </i>\n                                hod.psychology@esut.edu.ng\n                            </span>\n                            <a class=\"font-semibold text-[#701500] hover:underline flex items-center gap-1\" data-kid=\"1-3-1-1-2-1-4-2\" data-name=\"full welcome and bio link\" href=\"about.html\">\n                                <span data-kid=\"1-3-1-1-2-1-4-2-1\" data-name=\"full bio link label\">\n                                    Full Welcome & Bio\n                                </span>\n                                <i class=\"fa-solid fa-chevron-right text-[10px]\" data-kid=\"1-3-1-1-2-1-4-2-2\" data-name=\"right chevron icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Verified Institutional Facts Row (No odometer counters, auditable specifics) -->\n    <section class=\"bg-[#701500] text-white py-8 px-6\" data-kid=\"1-4\" data-name=\"verified institutional facts row\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/15\" data-kid=\"1-4-1\" data-name=\"facts grid container\">\n            <div class=\"pt-4 md:pt-0 px-4\" data-kid=\"1-4-1-1\" data-name=\"alumni stat cell\">\n                <div class=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#d9b15a] tracking-tight\" data-kid=\"1-4-1-1-1\" data-name=\"alumni count number\">\n                    1,000+\n                </div>\n                <p class=\"text-xs sm:text-sm text-white/80 mt-1 font-medium\" data-kid=\"1-4-1-1-2\" data-name=\"alumni stat label\">\n                    Alumni in Practice & Research\n                </p>\n                <span class=\"text-[11px] text-white/50 block mt-0.5\" data-kid=\"1-4-1-1-3\" data-name=\"alumni sectors sublabel\">\n                    Clinical, Corporate & Public Sectors\n                </span>\n            </div>\n            <div class=\"pt-4 md:pt-0 px-4\" data-kid=\"1-4-1-2\" data-name=\"academic staff stat cell\">\n                <div class=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#d9b15a] tracking-tight\" data-kid=\"1-4-1-2-1\" data-name=\"academic staff count number\">\n                    30+\n                </div>\n                <p class=\"text-xs sm:text-sm text-white/80 mt-1 font-medium\" data-kid=\"1-4-1-2-2\" data-name=\"academic staff label\">\n                    Academic Staff & Supervisors\n                </p>\n                <span class=\"text-[11px] text-white/50 block mt-0.5\" data-kid=\"1-4-1-2-3\" data-name=\"academic staff roles sublabel\">\n                    Professors, Senior Lecturers, Fellows\n                </span>\n            </div>\n            <div class=\"pt-4 md:pt-0 px-4\" data-kid=\"1-4-1-3\" data-name=\"study tracks stat cell\">\n                <div class=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#d9b15a] tracking-tight\" data-kid=\"1-4-1-3-1\" data-name=\"study tracks number\">\n                    3 Study Tracks\n                </div>\n                <p class=\"text-xs sm:text-sm text-white/80 mt-1 font-medium\" data-kid=\"1-4-1-3-2\" data-name=\"study tracks label\">\n                    Undergraduate, ICS & Postgraduate\n                </p>\n                <span class=\"text-[11px] text-white/50 block mt-0.5\" data-kid=\"1-4-1-3-3\" data-name=\"study tracks detail sublabel\">\n                    Full-time, Flexible & Advanced Degrees\n                </span>\n            </div>\n            <div class=\"pt-4 md:pt-0 px-4\" data-kid=\"1-4-1-4\" data-name=\"years of excellence stat cell\">\n                <div class=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#d9b15a] tracking-tight\" data-kid=\"1-4-1-4-1\" data-name=\"years number\">\n                    15+ Years\n                </div>\n                <p class=\"text-xs sm:text-sm text-white/80 mt-1 font-medium\" data-kid=\"1-4-1-4-2\" data-name=\"years label\">\n                    Academic & Research Excellence\n                </p>\n                <span class=\"text-[11px] text-white/50 block mt-0.5\" data-kid=\"1-4-1-4-3\" data-name=\"faculty affiliation sublabel\">\n                    ESUT Faculty of Social Sciences\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- Main Event: Interactive Degree Route Comparison Instrument (#routes) -->\n    <section class=\"py-16 px-6 bg-stone-50 border-b border-stone-200\" data-kid=\"1-5\" data-name=\"degree route comparison section\" id=\"routes\">\n        <div class=\"max-w-7xl mx-auto space-y-10\" data-kid=\"1-5-1\" data-name=\"degree routes container\">\n            <div class=\"max-w-3xl\" data-kid=\"1-5-1-1\" data-name=\"section intro block\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-[#701500]/10 text-[#701500] text-xs font-semibold mb-3\" data-kid=\"1-5-1-1-1\" data-name=\"section eyebrow badge\">\n                    <i class=\"fa-solid fa-compass\" data-kid=\"1-5-1-1-1-1\" data-name=\"compass icon\">\n                    </i>\n                    <span data-kid=\"1-5-1-1-1-2\" data-name=\"eyebadge label\">\n                        Degree Pathway Explorer\n                    </span>\n                </div>\n                <h2 class=\"text-2xl sm:text-3xl font-bold font-heading text-stone-900 tracking-tight\" data-kid=\"1-5-1-1-2\" data-name=\"section headline\">\n                    Find the Right Study Route for Your Educational Goals\n                </h2>\n                <p class=\"text-stone-600 text-sm sm:text-base mt-2\" data-kid=\"1-5-1-1-3\" data-name=\"section description text\">\n                    Compare admission requirements, duration, and qualification scope across all approved departmental offerings.\n                </p>\n            </div>\n            <!-- Side-by-Side Aligned Comparison Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\" data-kid=\"1-5-1-2\" data-name=\"route comparison grid\">\n                <!-- Route 1: Regular Undergraduate (B.Sc) -->\n                <div class=\"bg-white rounded-xl border-2 border-[#701500]/20 shadow-sm flex flex-col justify-between overflow-hidden\" data-kid=\"1-5-1-2-1\" data-name=\"regular undergraduate route card\">\n                    <div class=\"p-6\" data-kid=\"1-5-1-2-1-1\" data-name=\"route card body\">\n                        <div class=\"flex items-center justify-between gap-2 mb-3\" data-kid=\"1-5-1-2-1-1-1\" data-name=\"route card header row\">\n                            <span class=\"px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider bg-[#701500]/10 text-[#701500]\" data-kid=\"1-5-1-2-1-1-1-1\" data-name=\"route type badge (Regular UG)\">\n                                Regular UG\n                            </span>\n                            <span class=\"text-xs text-stone-500 font-medium\" data-kid=\"1-5-1-2-1-1-1-2\" data-name=\"route award subtitle\">\n                                B.Sc Psychology\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold font-heading text-stone-900 mb-2\" data-kid=\"1-5-1-2-1-1-2\" data-name=\"route title (Undergraduate Degree)\">\n                            Undergraduate Degree\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mb-6 leading-relaxed\" data-kid=\"1-5-1-2-1-1-3\" data-name=\"route description\">\n                            Standard collegiate degree providing foundational and applied mastery in experimental, developmental, and social psychology.\n                        </p>\n                        <!-- Aligned Feature Rows -->\n                        <div class=\"space-y-4 text-xs divide-y divide-stone-100\" data-kid=\"1-5-1-2-1-1-4\" data-name=\"route feature rows container\">\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-1-1-4-1\" data-name=\"duration feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-1-1-4-1-1\" data-name=\"duration label\">\n                                    Duration:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-1-1-4-1-2\" data-name=\"duration value\">\n                                    4 Years (UTME) · 3 Years (Direct Entry)\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-1-1-4-2\" data-name=\"schedule feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-1-1-4-2-1\" data-name=\"schedule label\">\n                                    Schedule:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-1-1-4-2-2\" data-name=\"schedule value\">\n                                    Full-Time Weekday Classes\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-1-1-4-3\" data-name=\"entry gateway feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-1-1-4-3-1\" data-name=\"entry gateway label\">\n                                    Entry Gateway:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-1-1-4-3-2\" data-name=\"entry gateway value\">\n                                    JAMB/UTME or OND/HND/A-Level Direct Entry\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-1-1-4-4\" data-name=\"key curricula feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-1-1-4-4-1\" data-name=\"key curricula label\">\n                                    Key Curricula:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-1-1-4-4-2\" data-name=\"key curricula value\">\n                                    Psychometrics, Neuropsychology, Research Practicum\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-1-1-4-5\" data-name=\"award feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-1-1-4-5-1\" data-name=\"award label\">\n                                    Award:\n                                </span>\n                                <span class=\"font-bold text-[#701500] text-right\" data-kid=\"1-5-1-2-1-1-4-5-2\" data-name=\"award value\">\n                                    Bachelor of Science (B.Sc)\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"p-6 bg-stone-50/80 border-t border-stone-100\" data-kid=\"1-5-1-2-1-2\" data-name=\"route card footer\">\n                        <a class=\"w-full inline-flex items-center justify-center gap-2 bg-[#701500] hover:bg-[#8e1f06] text-white text-xs font-semibold py-2.5 px-4 rounded-lg transition shadow-xs\" data-kid=\"1-5-1-2-1-2-1\" data-name=\"view B.Sc admission guide button\" href=\"programs.html#undergrad\">\n                            <span data-kid=\"1-5-1-2-1-2-1-1\" data-name=\"button label\">\n                                View B.Sc Admission Guide\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"1-5-1-2-1-2-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Route 2: Institute of Continuing Studies (ICS) -->\n                <div class=\"bg-white rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between overflow-hidden\" data-kid=\"1-5-1-2-2\" data-name=\"flexible evening (ICS) route card\">\n                    <div class=\"p-6\" data-kid=\"1-5-1-2-2-1\" data-name=\"route card body\">\n                        <div class=\"flex items-center justify-between gap-2 mb-3\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"route card header row\">\n                            <span class=\"px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800\" data-kid=\"1-5-1-2-2-1-1-1\" data-name=\"route type badge (Flexible Evening)\">\n                                Flexible Evening\n                            </span>\n                            <span class=\"text-xs text-stone-500 font-medium\" data-kid=\"1-5-1-2-2-1-1-2\" data-name=\"route award subtitle\">\n                                B.Sc (Part-Time)\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold font-heading text-stone-900 mb-2\" data-kid=\"1-5-1-2-2-1-2\" data-name=\"route title (Continuing Studies ICS)\">\n                            Continuing Studies (ICS)\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mb-6 leading-relaxed\" data-kid=\"1-5-1-2-2-1-3\" data-name=\"route description\">\n                            Designed for working professionals, civil servants, and educators seeking university qualification without interrupting daytime employment.\n                        </p>\n                        <!-- Aligned Feature Rows -->\n                        <div class=\"space-y-4 text-xs divide-y divide-stone-100\" data-kid=\"1-5-1-2-2-1-4\" data-name=\"route feature rows container\">\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-2-1-4-1\" data-name=\"duration feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-2-1-4-1-1\" data-name=\"duration label\">\n                                    Duration:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-2-1-4-1-2\" data-name=\"duration value\">\n                                    3, 4, or 5 Years (Based on Prior Qualifications)\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-2-1-4-2\" data-name=\"schedule feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-2-1-4-2-1\" data-name=\"schedule label\">\n                                    Schedule:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-2-1-4-2-2\" data-name=\"schedule value\">\n                                    Evenings & Weekend Modular Lectures\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-2-1-4-3\" data-name=\"entry gateway feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-2-1-4-3-1\" data-name=\"entry gateway label\">\n                                    Entry Gateway:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-2-1-4-3-2\" data-name=\"entry gateway value\">\n                                    SSCE Credits or Diploma / NCE Transfers\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-2-1-4-4\" data-name=\"key curricula feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-2-1-4-4-1\" data-name=\"key curricula label\">\n                                    Key Curricula:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-2-1-4-4-2\" data-name=\"key curricula value\">\n                                    Industrial Psychology, Counseling, Adult Cognition\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-2-1-4-5\" data-name=\"award feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-2-1-4-5-1\" data-name=\"award label\">\n                                    Award:\n                                </span>\n                                <span class=\"font-bold text-[#701500] text-right\" data-kid=\"1-5-1-2-2-1-4-5-2\" data-name=\"award value\">\n                                    Bachelor of Science (B.Sc)\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"p-6 bg-stone-50/80 border-t border-stone-100\" data-kid=\"1-5-1-2-2-2\" data-name=\"route card footer\">\n                        <a class=\"w-full inline-flex items-center justify-center gap-2 bg-stone-800 hover:bg-stone-900 text-white text-xs font-semibold py-2.5 px-4 rounded-lg transition shadow-xs\" data-kid=\"1-5-1-2-2-2-1\" data-name=\"view ICS programmes button\" href=\"programs.html#ics\">\n                            <span data-kid=\"1-5-1-2-2-2-1-1\" data-name=\"button label\">\n                                View ICS Programmes\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"1-5-1-2-2-2-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Route 3: Postgraduate Studies (PGD, M.Sc, Ph.D) -->\n                <div class=\"bg-white rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between overflow-hidden\" data-kid=\"1-5-1-2-3\" data-name=\"postgraduate route card\">\n                    <div class=\"p-6\" data-kid=\"1-5-1-2-3-1\" data-name=\"route card body\">\n                        <div class=\"flex items-center justify-between gap-2 mb-3\" data-kid=\"1-5-1-2-3-1-1\" data-name=\"route card header row\">\n                            <span class=\"px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800\" data-kid=\"1-5-1-2-3-1-1-1\" data-name=\"route type badge (Advanced Research)\">\n                                Advanced Research\n                            </span>\n                            <span class=\"text-xs text-stone-500 font-medium\" data-kid=\"1-5-1-2-3-1-1-2\" data-name=\"route awards subtitle\">\n                                PGD · M.Sc · Ph.D\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold font-heading text-stone-900 mb-2\" data-kid=\"1-5-1-2-3-1-2\" data-name=\"route title (Postgraduate School)\">\n                            Postgraduate School\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mb-6 leading-relaxed\" data-kid=\"1-5-1-2-3-1-3\" data-name=\"route description\">\n                            Specialized master's and doctoral degrees for clinical psychotherapists, academic researchers, and organizational consultants.\n                        </p>\n                        <!-- Aligned Feature Rows -->\n                        <div class=\"space-y-4 text-xs divide-y divide-stone-100\" data-kid=\"1-5-1-2-3-1-4\" data-name=\"route feature rows container\">\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-3-1-4-1\" data-name=\"duration feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-3-1-4-1-1\" data-name=\"duration label\">\n                                    Duration:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-3-1-4-1-2\" data-name=\"duration value\">\n                                    PGD (1–2 yrs) · M.Sc (1.5–2 yrs) · Ph.D (3–5 yrs)\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-3-1-4-2\" data-name=\"specializations feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-3-1-4-2-1\" data-name=\"specializations label\">\n                                    Specializations:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-3-1-4-2-2\" data-name=\"specializations value\">\n                                    Clinical, Social, Neurobiological, Org. Psychology\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-3-1-4-3\" data-name=\"entry gateway feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-3-1-4-3-1\" data-name=\"entry gateway label\">\n                                    Entry Gateway:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-3-1-4-3-2\" data-name=\"entry gateway value\">\n                                    Accredited B.Sc (Min. 2nd Class Lower) or PGD\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-3-1-4-4\" data-name=\"dissertation feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-3-1-4-4-1\" data-name=\"dissertation label\">\n                                    Dissertation:\n                                </span>\n                                <span class=\"font-semibold text-stone-800 text-right\" data-kid=\"1-5-1-2-3-1-4-4-2\" data-name=\"dissertation value\">\n                                    Original Empirical Research & Defense\n                                </span>\n                            </div>\n                            <div class=\"pt-3 flex justify-between items-start gap-3\" data-kid=\"1-5-1-2-3-1-4-5\" data-name=\"award feature row\">\n                                <span class=\"font-medium text-stone-500 shrink-0\" data-kid=\"1-5-1-2-3-1-4-5-1\" data-name=\"award label\">\n                                    Award:\n                                </span>\n                                <span class=\"font-bold text-[#701500] text-right\" data-kid=\"1-5-1-2-3-1-4-5-2\" data-name=\"award value\">\n                                    PGD, M.Sc, Doctor of Philosophy (Ph.D)\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"p-6 bg-stone-50/80 border-t border-stone-100\" data-kid=\"1-5-1-2-3-2\" data-name=\"route card footer\">\n                        <a class=\"w-full inline-flex items-center justify-center gap-2 bg-stone-800 hover:bg-stone-900 text-white text-xs font-semibold py-2.5 px-4 rounded-lg transition shadow-xs\" data-kid=\"1-5-1-2-3-2-1\" data-name=\"view postgraduate prospectus button\" href=\"programs.html#postgrad\">\n                            <span data-kid=\"1-5-1-2-3-2-1-1\" data-name=\"button label\">\n                                View Postgraduate Prospectus\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"1-5-1-2-3-2-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Curated Academic Prospectus: Structured Discipline & 21st-Century Skills (#prospectus) -->\n    <section class=\"py-16 px-6 bg-white border-b border-stone-200\" data-kid=\"1-6\" data-name=\"curriculum prospectus section\" id=\"prospectus\">\n        <div class=\"max-w-7xl mx-auto space-y-12\" data-kid=\"1-6-1\" data-name=\"prospectus container\">\n            <!-- Section Intro -->\n            <div class=\"max-w-3xl\" data-kid=\"1-6-1-1\" data-name=\"section intro block\">\n                <span class=\"text-xs font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"1-6-1-1-1\" data-name=\"section eyebrow label\">\n                    Curriculum Philosophy & Graduate Outcomes\n                </span>\n                <h2 class=\"text-2xl sm:text-3xl font-bold font-heading text-stone-900 tracking-tight mt-1\" data-kid=\"1-6-1-1-2\" data-name=\"section headline\">\n                    A Disciplined Science Built for 21st-Century Impact\n                </h2>\n                <p class=\"text-stone-600 text-sm sm:text-base mt-2\" data-kid=\"1-6-1-1-3\" data-name=\"section description text\">\n                    Rather than abstract theory, our pedagogical model links behavioral science directly to social, clinical, corporate, and technological challenges in Nigeria and globally.\n                </p>\n            </div>\n            <!-- Two-Column Editorial Layout: Philosophy vs Skills Framework -->\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"1-6-1-2\" data-name=\"philosophy and skills two-column grid\">\n                <!-- Left Column: Department Overview & Educational Philosophy -->\n                <div class=\"lg:col-span-5 space-y-6\" data-kid=\"1-6-1-2-1\" data-name=\"left column (philosophy and course sequence)\">\n                    <div class=\"bg-[#faf7f5] rounded-xl border border-[#701500]/15 p-6 space-y-4\" data-kid=\"1-6-1-2-1-1\" data-name=\"educational philosophy card\">\n                        <h3 class=\"text-lg font-bold font-heading text-[#701500] flex items-center gap-2\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"card heading with icon\">\n                            <i class=\"fa-solid fa-scale-balanced text-sm\" data-kid=\"1-6-1-2-1-1-1-1\" data-name=\"balance scale icon\">\n                            </i>\n                            <span data-kid=\"1-6-1-2-1-1-1-2\" data-name=\"card heading text\">\n                                Educational Philosophy\n                            </span>\n                        </h3>\n                        <p class=\"text-xs sm:text-sm text-stone-700 leading-relaxed\" data-kid=\"1-6-1-2-1-1-2\" data-name=\"philosophy body paragraph 1\">\n                            Psychology at ESUT seeks to discover systematic patterns of behaviour using rigorous empirical facts, principles, and experimental methods. We bridge intra- and interpersonal understanding to foster peaceful coexistence, community resilience, and national socio-economic progress.\n                        </p>\n                        <p class=\"text-xs sm:text-sm text-stone-700 leading-relaxed\" data-kid=\"1-6-1-2-1-1-3\" data-name=\"philosophy body paragraph 2\">\n                            Graduates serve as licensed counselors, organizational psychologists, data analysts, security consultants, and behavioral researchers across hospitals, corporations, and international non-profits.\n                        </p>\n                        <div class=\"pt-2\" data-kid=\"1-6-1-2-1-1-4\" data-name=\"card footer link container\">\n                            <a class=\"text-xs font-semibold text-[#701500] hover:underline inline-flex items-center gap-1.5\" data-kid=\"1-6-1-2-1-1-4-1\" data-name=\"read full philosophy link\" href=\"about.html#philosophy\">\n                                <span data-kid=\"1-6-1-2-1-1-4-1-1\" data-name=\"link label\">\n                                    Read Full Philosophy & Accreditation\n                                </span>\n                                <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"1-6-1-2-1-1-4-1-2\" data-name=\"right arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <!-- Quick Course Sequence Highlight -->\n                    <div class=\"border border-stone-200 rounded-xl p-5 bg-white\" data-kid=\"1-6-1-2-1-2\" data-name=\"core course sequence preview card\">\n                        <h4 class=\"text-xs font-bold text-stone-900 uppercase tracking-wider mb-3\" data-kid=\"1-6-1-2-1-2-1\" data-name=\"card heading\">\n                            Core Undergraduate Sequence Preview\n                        </h4>\n                        <div class=\"space-y-2.5 text-xs\" data-kid=\"1-6-1-2-1-2-2\" data-name=\"course row container\">\n                            <div class=\"flex items-center justify-between p-2 rounded bg-stone-50 border border-stone-150\" data-kid=\"1-6-1-2-1-2-2-1\" data-name=\"PSY 101 course row\">\n                                <span class=\"font-bold text-[#701500]\" data-kid=\"1-6-1-2-1-2-2-1-1\" data-name=\"course code\">\n                                    PSY 101\n                                </span>\n                                <span class=\"text-stone-700\" data-kid=\"1-6-1-2-1-2-2-1-2\" data-name=\"course title\">\n                                    Introduction to Psychology\n                                </span>\n                                <span class=\"text-stone-500 text-[11px]\" data-kid=\"1-6-1-2-1-2-2-1-3\" data-name=\"unit count\">\n                                    3 Units\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between p-2 rounded bg-stone-50 border border-stone-150\" data-kid=\"1-6-1-2-1-2-2-2\" data-name=\"PSY 201 course row\">\n                                <span class=\"font-bold text-[#701500]\" data-kid=\"1-6-1-2-1-2-2-2-1\" data-name=\"course code\">\n                                    PSY 201\n                                </span>\n                                <span class=\"text-stone-700\" data-kid=\"1-6-1-2-1-2-2-2-2\" data-name=\"course title\">\n                                    Physiological Psychology\n                                </span>\n                                <span class=\"text-stone-500 text-[11px]\" data-kid=\"1-6-1-2-1-2-2-2-3\" data-name=\"unit count\">\n                                    3 Units\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between p-2 rounded bg-stone-50 border border-stone-150\" data-kid=\"1-6-1-2-1-2-2-3\" data-name=\"PSY 341 course row\">\n                                <span class=\"font-bold text-[#701500]\" data-kid=\"1-6-1-2-1-2-2-3-1\" data-name=\"course code\">\n                                    PSY 341\n                                </span>\n                                <span class=\"text-stone-700\" data-kid=\"1-6-1-2-1-2-2-3-2\" data-name=\"course title\">\n                                    Psychometrics & Test Construction\n                                </span>\n                                <span class=\"text-stone-500 text-[11px]\" data-kid=\"1-6-1-2-1-2-2-3-3\" data-name=\"unit count\">\n                                    3 Units\n                                </span>\n                            </div>\n                        </div>\n                        <a class=\"block text-center mt-3 text-xs font-semibold text-[#701500] hover:underline\" data-kid=\"1-6-1-2-1-2-3\" data-name=\"complete syllabi browse link\" href=\"course-descriptions.html\">\n                            Browse Complete Course Syllabi (100L – 400L) →\n                        </a>\n                    </div>\n                </div>\n                <!-- Right Column: Structured 4-Pillar Competency Matrix -->\n                <div class=\"lg:col-span-7 space-y-4\" data-kid=\"1-6-1-2-2\" data-name=\"right column (competency pillars)\">\n                    <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-6-1-2-2-1\" data-name=\"section header row\">\n                        <h3 class=\"text-lg font-bold font-heading text-stone-900\" data-kid=\"1-6-1-2-2-1-1\" data-name=\"section heading (Four Competency Pillars)\">\n                            The Four Competency Pillars\n                        </h3>\n                        <span class=\"text-xs text-stone-500\" data-kid=\"1-6-1-2-2-1-2\" data-name=\"section sublabel\">\n                            Benchmark Competencies\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\" data-kid=\"1-6-1-2-2-2\" data-name=\"competency pillars grid\">\n                        <!-- Pillar 1: Assessment -->\n                        <div class=\"p-5 rounded-xl border border-stone-200 bg-white hover:border-[#701500]/30 transition shadow-2xs\" data-kid=\"1-6-1-2-2-2-1\" data-name=\"psychometric testing pillar card\">\n                            <div class=\"w-8 h-8 rounded-lg bg-[#701500]/10 text-[#701500] flex items-center justify-center text-sm mb-3\" data-kid=\"1-6-1-2-2-2-1-1\" data-name=\"pillar icon bubble\">\n                                <i class=\"fa-solid fa-chart-simple\" data-kid=\"1-6-1-2-2-2-1-1-1\" data-name=\"chart simple icon\">\n                                </i>\n                            </div>\n                            <h4 class=\"font-bold text-sm text-stone-900 font-heading mb-1.5\" data-kid=\"1-6-1-2-2-2-1-2\" data-name=\"pillar title (Psychometric Testing)\">\n                                1. Psychometric Testing\n                            </h4>\n                            <p class=\"text-xs text-stone-600 leading-relaxed mb-3\" data-kid=\"1-6-1-2-2-2-1-3\" data-name=\"pillar description\">\n                                Test standardization, administration, statistical scoring, psychometric validation, and behavioral diagnostics.\n                            </p>\n                            <ul class=\"text-[11px] text-stone-600 space-y-1\" data-kid=\"1-6-1-2-2-2-1-4\" data-name=\"pillar example list\">\n                                <li data-kid=\"1-6-1-2-2-2-1-4-1\" data-name=\"example item 1\">\n                                    • Clinical diagnosis batteries\n                                </li>\n                                <li data-kid=\"1-6-1-2-2-2-1-4-2\" data-name=\"example item 2\">\n                                    • Occupational aptitude testing\n                                </li>\n                            </ul>\n                        </div>\n                        <!-- Pillar 2: Research & Empirical Investigation -->\n                        <div class=\"p-5 rounded-xl border border-stone-200 bg-white hover:border-[#701500]/30 transition shadow-2xs\" data-kid=\"1-6-1-2-2-2-2\" data-name=\"empirical research pillar card\">\n                            <div class=\"w-8 h-8 rounded-lg bg-[#701500]/10 text-[#701500] flex items-center justify-center text-sm mb-3\" data-kid=\"1-6-1-2-2-2-2-1\" data-name=\"pillar icon bubble\">\n                                <i class=\"fa-solid fa-microscope\" data-kid=\"1-6-1-2-2-2-2-1-1\" data-name=\"microscope icon\">\n                                </i>\n                            </div>\n                            <h4 class=\"font-bold text-sm text-stone-900 font-heading mb-1.5\" data-kid=\"1-6-1-2-2-2-2-2\" data-name=\"pillar title (Empirical Research)\">\n                                2. Empirical Research\n                            </h4>\n                            <p class=\"text-xs text-stone-600 leading-relaxed mb-3\" data-kid=\"1-6-1-2-2-2-2-3\" data-name=\"pillar description\">\n                                Experimental design, data collection, quantitative statistical analysis (SPSS/R), and publishable scientific reports.\n                            </p>\n                            <ul class=\"text-[11px] text-stone-600 space-y-1\" data-kid=\"1-6-1-2-2-2-2-4\" data-name=\"pillar example list\">\n                                <li data-kid=\"1-6-1-2-2-2-2-4-1\" data-name=\"example item 1\">\n                                    • Experimental cognition trials\n                                </li>\n                                <li data-kid=\"1-6-1-2-2-2-2-4-2\" data-name=\"example item 2\">\n                                    • Social epidemiological studies\n                                </li>\n                            </ul>\n                        </div>\n                        <!-- Pillar 3: Crisis & Mental Health Support -->\n                        <div class=\"p-5 rounded-xl border border-stone-200 bg-white hover:border-[#701500]/30 transition shadow-2xs\" data-kid=\"1-6-1-2-2-2-3\" data-name=\"counseling and intervention pillar card\">\n                            <div class=\"w-8 h-8 rounded-lg bg-[#701500]/10 text-[#701500] flex items-center justify-center text-sm mb-3\" data-kid=\"1-6-1-2-2-2-3-1\" data-name=\"pillar icon bubble\">\n                                <i class=\"fa-solid fa-heart-pulse\" data-kid=\"1-6-1-2-2-2-3-1-1\" data-name=\"heart pulse icon\">\n                                </i>\n                            </div>\n                            <h4 class=\"font-bold text-sm text-stone-900 font-heading mb-1.5\" data-kid=\"1-6-1-2-2-2-3-2\" data-name=\"pillar title (Counseling and Intervention)\">\n                                3. Counseling & Intervention\n                            </h4>\n                            <p class=\"text-xs text-stone-600 leading-relaxed mb-3\" data-kid=\"1-6-1-2-2-2-3-3\" data-name=\"pillar description\">\n                                Trauma mitigation, crisis intervention counseling, peace-building mediation, and psychological adjustment.\n                            </p>\n                            <ul class=\"text-[11px] text-stone-600 space-y-1\" data-kid=\"1-6-1-2-2-2-3-4\" data-name=\"pillar example list\">\n                                <li data-kid=\"1-6-1-2-2-2-3-4-1\" data-name=\"example item 1\">\n                                    • Post-trauma counseling\n                                </li>\n                                <li data-kid=\"1-6-1-2-2-2-3-4-2\" data-name=\"example item 2\">\n                                    • Community peace mediation\n                                </li>\n                            </ul>\n                        </div>\n                        <!-- Pillar 4: Applied & Industry Consulting -->\n                        <div class=\"p-5 rounded-xl border border-stone-200 bg-white hover:border-[#701500]/30 transition shadow-2xs\" data-kid=\"1-6-1-2-2-2-4\" data-name=\"organizational consulting pillar card\">\n                            <div class=\"w-8 h-8 rounded-lg bg-[#701500]/10 text-[#701500] flex items-center justify-center text-sm mb-3\" data-kid=\"1-6-1-2-2-2-4-1\" data-name=\"pillar icon bubble\">\n                                <i class=\"fa-solid fa-briefcase\" data-kid=\"1-6-1-2-2-2-4-1-1\" data-name=\"briefcase icon\">\n                                </i>\n                            </div>\n                            <h4 class=\"font-bold text-sm text-stone-900 font-heading mb-1.5\" data-kid=\"1-6-1-2-2-2-4-2\" data-name=\"pillar title (Organizational Consulting)\">\n                                4. Organizational Consulting\n                            </h4>\n                            <p class=\"text-xs text-stone-600 leading-relaxed mb-3\" data-kid=\"1-6-1-2-2-2-4-3\" data-name=\"pillar description\">\n                                Job recruitment design, executive leadership coaching, forensic analysis, and government policy advisory.\n                            </p>\n                            <ul class=\"text-[11px] text-stone-600 space-y-1\" data-kid=\"1-6-1-2-2-2-4-4\" data-name=\"pillar example list\">\n                                <li data-kid=\"1-6-1-2-2-2-4-4-1\" data-name=\"example item 1\">\n                                    • Corporate talent optimization\n                                </li>\n                                <li data-kid=\"1-6-1-2-2-2-4-4-2\" data-name=\"example item 2\">\n                                    • Judicial & correctional forensics\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Departmental Bulletin: Latest Research Seminars & Notices (#bulletin) -->\n    <section class=\"py-16 px-6 bg-stone-50 border-b border-stone-200\" data-kid=\"1-7\" data-name=\"departmental bulletin section\" id=\"bulletin\">\n        <div class=\"max-w-7xl mx-auto space-y-8\" data-kid=\"1-7-1\" data-name=\"bulletin container\">\n            <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\" data-kid=\"1-7-1-1\" data-name=\"section header row\">\n                <div data-kid=\"1-7-1-1-1\" data-name=\"section title block\">\n                    <span class=\"text-xs font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"1-7-1-1-1-1\" data-name=\"section eyebrow label\">\n                        Timely Academic Notices\n                    </span>\n                    <h2 class=\"text-2xl sm:text-3xl font-bold font-heading text-stone-900 tracking-tight mt-1\" data-kid=\"1-7-1-1-1-2\" data-name=\"section headline\">\n                        Departmental Seminars & News Feed\n                    </h2>\n                </div>\n                <a class=\"inline-flex items-center gap-1.5 text-xs font-semibold text-[#701500] hover:underline\" data-kid=\"1-7-1-1-2\" data-name=\"view all bulletins link\" href=\"news.html\">\n                    <span data-kid=\"1-7-1-1-2-1\" data-name=\"link label\">\n                        View All Seminars & Notices\n                    </span>\n                    <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"1-7-1-1-2-2\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n            <!-- Bulletin Items Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\" data-kid=\"1-7-1-2\" data-name=\"bulletin items grid\">\n                <!-- Item 1: Upcoming Seminar -->\n                <article class=\"bg-white rounded-xl border border-stone-200 p-5 shadow-2xs flex flex-col justify-between\" data-kid=\"1-7-1-2-1\" data-name=\"upcoming research seminar card\">\n                    <div class=\"space-y-3\" data-kid=\"1-7-1-2-1-1\" data-name=\"card content block\">\n                        <div class=\"flex items-center justify-between text-xs\" data-kid=\"1-7-1-2-1-1-1\" data-name=\"card meta row\">\n                            <span class=\"px-2.5 py-0.5 rounded font-semibold bg-rose-50 text-[#701500] border border-[#701500]/15\" data-kid=\"1-7-1-2-1-1-1-1\" data-name=\"category badge (Research Seminar)\">\n                                Research Seminar\n                            </span>\n                            <span class=\"text-stone-500 font-medium\" data-kid=\"1-7-1-2-1-1-1-2\" data-name=\"event date\">\n                                October 22, 2026\n                            </span>\n                        </div>\n                        <h3 class=\"text-base font-bold font-heading text-stone-900 leading-snug\" data-kid=\"1-7-1-2-1-1-2\" data-name=\"event title (Seminar Series)\">\n                            Departmental Seminar Series: Advances in Psychological Science\n                        </h3>\n                        <p class=\"text-xs text-stone-600 leading-relaxed\" data-kid=\"1-7-1-2-1-1-3\" data-name=\"event description\">\n                            Faculty and postgraduate presentation on recent empirical developments in cognitive neuropsychology and community intervention.\n                        </p>\n                    </div>\n                    <div class=\"pt-4 mt-4 border-t border-stone-100 flex items-center justify-between text-xs\" data-kid=\"1-7-1-2-1-2\" data-name=\"card footer\">\n                        <span class=\"text-stone-500 flex items-center gap-1\" data-kid=\"1-7-1-2-1-2-1\" data-name=\"venue with location icon\">\n                            <i class=\"fa-solid fa-location-dot text-[#701500]\" data-kid=\"1-7-1-2-1-2-1-1\" data-name=\"location dot icon\">\n                            </i>\n                            Faculty Hall\n                        </span>\n                        <a class=\"font-semibold text-[#701500] hover:underline\" data-kid=\"1-7-1-2-1-2-2\" data-name=\"details and RSVP link\" href=\"news.html\">\n                            Details & RSVP →\n                        </a>\n                    </div>\n                </article>\n                <!-- Item 2: Orientation Event -->\n                <article class=\"bg-white rounded-xl border border-stone-200 p-5 shadow-2xs flex flex-col justify-between\" data-kid=\"1-7-1-2-2\" data-name=\"orientation event card\">\n                    <div class=\"space-y-3\" data-kid=\"1-7-1-2-2-1\" data-name=\"card content block\">\n                        <div class=\"flex items-center justify-between text-xs\" data-kid=\"1-7-1-2-2-1-1\" data-name=\"card meta row\">\n                            <span class=\"px-2.5 py-0.5 rounded font-semibold bg-amber-50 text-amber-800 border border-amber-200\" data-kid=\"1-7-1-2-2-1-1-1\" data-name=\"category badge (Orientation)\">\n                                Orientation\n                            </span>\n                            <span class=\"text-stone-500 font-medium\" data-kid=\"1-7-1-2-2-1-1-2\" data-name=\"event date\">\n                                October 15, 2026\n                            </span>\n                        </div>\n                        <h3 class=\"text-base font-bold font-heading text-stone-900 leading-snug\" data-kid=\"1-7-1-2-2-1-2\" data-name=\"event title (Undergraduate Orientation)\">\n                            Undergraduate Orientation Programme for Admitted Students\n                        </h3>\n                        <p class=\"text-xs text-stone-600 leading-relaxed\" data-kid=\"1-7-1-2-2-1-3\" data-name=\"event description\">\n                            Official welcoming ceremony, faculty adviser assignment, and course registration walkthrough for all newly admitted UTME and Direct Entry scholars.\n                        </p>\n                    </div>\n                    <div class=\"pt-4 mt-4 border-t border-stone-100 flex items-center justify-between text-xs\" data-kid=\"1-7-1-2-2-2\" data-name=\"card footer\">\n                        <span class=\"text-stone-500 flex items-center gap-1\" data-kid=\"1-7-1-2-2-2-1\" data-name=\"venue with location icon\">\n                            <i class=\"fa-solid fa-location-dot text-[#701500]\" data-kid=\"1-7-1-2-2-2-1-1\" data-name=\"location dot icon\">\n                            </i>\n                            Departmental Annex\n                        </span>\n                        <a class=\"font-semibold text-[#701500] hover:underline\" data-kid=\"1-7-1-2-2-2-2\" data-name=\"orientation schedule link\" href=\"news.html\">\n                            Orientation Schedule →\n                        </a>\n                    </div>\n                </article>\n                <!-- Item 3: Faculty Workshop -->\n                <article class=\"bg-white rounded-xl border border-stone-200 p-5 shadow-2xs flex flex-col justify-between\" data-kid=\"1-7-1-2-3\" data-name=\"faculty workshop card\">\n                    <div class=\"space-y-3\" data-kid=\"1-7-1-2-3-1\" data-name=\"card content block\">\n                        <div class=\"flex items-center justify-between text-xs\" data-kid=\"1-7-1-2-3-1-1\" data-name=\"card meta row\">\n                            <span class=\"px-2.5 py-0.5 rounded font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200\" data-kid=\"1-7-1-2-3-1-1-1\" data-name=\"category badge (Staff and PG Workshop)\">\n                                Staff & PG Workshop\n                            </span>\n                            <span class=\"text-stone-500 font-medium\" data-kid=\"1-7-1-2-3-1-1-2\" data-name=\"event date\">\n                                November 10, 2026\n                            </span>\n                        </div>\n                        <h3 class=\"text-base font-bold font-heading text-stone-900 leading-snug\" data-kid=\"1-7-1-2-3-1-2\" data-name=\"event title (Grant Writing Workshop)\">\n                            Academic Grant Writing & Psychometric Protocol Workshop\n                        </h3>\n                        <p class=\"text-xs text-stone-600 leading-relaxed\" data-kid=\"1-7-1-2-3-1-3\" data-name=\"event description\">\n                            Three-day capacity enhancement workshop focusing on international grant applications, peer-reviewed publishing, and standardized test ethics.\n                        </p>\n                    </div>\n                    <div class=\"pt-4 mt-4 border-t border-stone-100 flex items-center justify-between text-xs\" data-kid=\"1-7-1-2-3-2\" data-name=\"card footer\">\n                        <span class=\"text-stone-500 flex items-center gap-1\" data-kid=\"1-7-1-2-3-2-1\" data-name=\"venue with location icon\">\n                            <i class=\"fa-solid fa-location-dot text-[#701500]\" data-kid=\"1-7-1-2-3-2-1-1\" data-name=\"location dot icon\">\n                            </i>\n                            ESUT ICT Lab\n                        </span>\n                        <a class=\"font-semibold text-[#701500] hover:underline\" data-kid=\"1-7-1-2-3-2-2\" data-name=\"read outline link\" href=\"news.html\">\n                            Read Outline →\n                        </a>\n                    </div>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- Quick Student Utility Desk (#resources) -->\n    <section class=\"py-12 px-6 bg-white border-b border-stone-200\" data-kid=\"1-8\" data-name=\"student resource desk section\" id=\"resources\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-8-1\" data-name=\"resource desk container\">\n            <div class=\"bg-[#faf7f5] rounded-2xl border border-stone-200 p-8\" data-kid=\"1-8-1-1\" data-name=\"resource desk panel\">\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6\" data-kid=\"1-8-1-1-1\" data-name=\"panel header row\">\n                    <div data-kid=\"1-8-1-1-1-1\" data-name=\"panel title block\">\n                        <h3 class=\"text-lg font-bold font-heading text-stone-900\" data-kid=\"1-8-1-1-1-1-1\" data-name=\"panel title\">\n                            Current Student Utilities & Resource Desk\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mt-1\" data-kid=\"1-8-1-1-1-1-2\" data-name=\"panel description\">\n                            Direct access to timetables, course syllabi, institutional guidelines, and academic forms.\n                        </p>\n                    </div>\n                    <a class=\"inline-flex items-center gap-2 text-xs font-bold text-[#701500] bg-white border border-[#701500]/20 px-3.5 py-2 rounded-lg hover:bg-stone-50 transition\" data-kid=\"1-8-1-1-1-2\" data-name=\"faculty directory button\" href=\"staff.html\">\n                        <i class=\"fa-solid fa-address-book\" data-kid=\"1-8-1-1-1-2-1\" data-name=\"address book icon\">\n                        </i>\n                        <span data-kid=\"1-8-1-1-1-2-2\" data-name=\"button label\">\n                            Department Faculty Directory\n                        </span>\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-medium\" data-kid=\"1-8-1-1-2\" data-name=\"resource tiles grid\">\n                    <a class=\"p-3.5 bg-white rounded-lg border border-stone-200 hover:border-[#701500] hover:text-[#701500] transition flex items-center gap-2.5\" data-kid=\"1-8-1-1-2-1\" data-name=\"exam timetable tile\" href=\"exam-timetable.pdf\">\n                        <i class=\"fa-solid fa-calendar-check text-[#701500]\" data-kid=\"1-8-1-1-2-1-1\" data-name=\"calendar check icon\">\n                        </i>\n                        <span data-kid=\"1-8-1-1-2-1-2\" data-name=\"tile label\">\n                            Exam Timetable (PDF)\n                        </span>\n                    </a>\n                    <a class=\"p-3.5 bg-white rounded-lg border border-stone-200 hover:border-[#701500] hover:text-[#701500] transition flex items-center gap-2.5\" data-kid=\"1-8-1-1-2-2\" data-name=\"course syllabi tile\" href=\"course-descriptions.html\">\n                        <i class=\"fa-solid fa-book text-[#701500]\" data-kid=\"1-8-1-1-2-2-1\" data-name=\"book icon\">\n                        </i>\n                        <span data-kid=\"1-8-1-1-2-2-2\" data-name=\"tile label\">\n                            Course Syllabi\n                        </span>\n                    </a>\n                    <a class=\"p-3.5 bg-white rounded-lg border border-stone-200 hover:border-[#701500] hover:text-[#701500] transition flex items-center gap-2.5\" data-kid=\"1-8-1-1-2-3\" data-name=\"degree requirements tile\" href=\"academics.html\">\n                        <i class=\"fa-solid fa-scroll text-[#701500]\" data-kid=\"1-8-1-1-2-3-1\" data-name=\"scroll icon\">\n                        </i>\n                        <span data-kid=\"1-8-1-1-2-3-2\" data-name=\"tile label\">\n                            Degree Requirements\n                        </span>\n                    </a>\n                    <a class=\"p-3.5 bg-white rounded-lg border border-stone-200 hover:border-[#701500] hover:text-[#701500] transition flex items-center gap-2.5\" data-kid=\"1-8-1-1-2-4\" data-name=\"academic adviser desk tile\" href=\"contact.html\">\n                        <i class=\"fa-solid fa-headset text-[#701500]\" data-kid=\"1-8-1-1-2-4-1\" data-name=\"headset icon\">\n                        </i>\n                        <span data-kid=\"1-8-1-1-2-4-2\" data-name=\"tile label\">\n                            Academic Adviser Desk\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Institutional Footer -->\n    <footer class=\"bg-[#4a0d00] text-white pt-14 pb-8 px-6 border-t-4 border-[#f67665]\" data-kid=\"1-9\" data-name=\"institutional footer\">\n        <div class=\"max-w-7xl mx-auto space-y-12\" data-kid=\"1-9-1\" data-name=\"footer container\">\n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 text-xs\" data-kid=\"1-9-1-1\" data-name=\"footer columns grid\">\n                <!-- Brand Info -->\n                <div class=\"md:col-span-5 space-y-4\" data-kid=\"1-9-1-1-1\" data-name=\"brand info column\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-9-1-1-1-1\" data-name=\"brand logo and name row\">\n                        <img alt=\"ESUT Logo\" class=\"w-10 h-10 object-contain rounded bg-white p-0.5\" data-kid=\"1-9-1-1-1-1-1\" data-name=\"ESUT logo image\" src=\"/api/local/images/Enugu-State-University-of-Science-and-Technology-logo.jpg\"/>\n                        <div data-kid=\"1-9-1-1-1-1-2\" data-name=\"brand text block\">\n                            <h4 class=\"text-sm font-bold font-heading text-white\" data-kid=\"1-9-1-1-1-1-2-1\" data-name=\"department name\">\n                                Department of Psychology\n                            </h4>\n                            <p class=\"text-white/70 text-[11px]\" data-kid=\"1-9-1-1-1-1-2-2\" data-name=\"university name subtitle\">\n                                Enugu State University of Science and Technology\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"text-white/70 leading-relaxed max-w-sm\" data-kid=\"1-9-1-1-1-2\" data-name=\"brand mission description\">\n                        Empowering students with empirical scientific methods, psychometric rigor, and clinical competencies to foster human well-being and national development.\n                    </p>\n                    <div class=\"flex items-center gap-2 text-white/80\" data-kid=\"1-9-1-1-1-3\" data-name=\"footer location with map icon\">\n                        <i class=\"fa-solid fa-map-location-dot text-[#f67665]\" data-kid=\"1-9-1-1-1-3-1\" data-name=\"map location icon\">\n                        </i>\n                        <span data-kid=\"1-9-1-1-1-3-2\" data-name=\"location text\">\n                            Faculty of Social Sciences & Humanities, Agbani Campus, Enugu State, Nigeria\n                        </span>\n                    </div>\n                </div>\n                <!-- Academic Links -->\n                <div class=\"md:col-span-2 space-y-3\" data-kid=\"1-9-1-1-2\" data-name=\"degree routes links column\">\n                    <h5 class=\"font-bold uppercase tracking-wider text-white text-[11px] text-[#f67665]\" data-kid=\"1-9-1-1-2-1\" data-name=\"column heading\">\n                        Degree Routes\n                    </h5>\n                    <ul class=\"space-y-2 text-white/80\" data-kid=\"1-9-1-1-2-2\" data-name=\"links list\">\n                        <li data-kid=\"1-9-1-1-2-2-1\" data-name=\"Regular B.Sc link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-2-2-1-1\" data-name=\"regular B.Sc link\" href=\"programs.html#undergrad\">\n                                Regular B.Sc\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-2-2-2\" data-name=\"Continuing Studies ICS link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-2-2-2-1\" data-name=\"ICS link\" href=\"programs.html#ics\">\n                                Continuing Studies (ICS)\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-2-2-3\" data-name=\"Postgraduate Diploma PGD link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-2-2-3-1\" data-name=\"PGD link\" href=\"programs.html#postgrad\">\n                                Postgraduate Diploma (PGD)\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-2-2-4\" data-name=\"Master of Science MSc link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-2-2-4-1\" data-name=\"MSc link\" href=\"programs.html#postgrad\">\n                                Master of Science (M.Sc)\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-2-2-5\" data-name=\"Doctor of Philosophy PhD link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-2-2-5-1\" data-name=\"PhD link\" href=\"programs.html#postgrad\">\n                                Doctor of Philosophy (Ph.D)\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <!-- Navigation -->\n                <div class=\"md:col-span-2 space-y-3\" data-kid=\"1-9-1-1-3\" data-name=\"quick links column\">\n                    <h5 class=\"font-bold uppercase tracking-wider text-white text-[11px] text-[#f67665]\" data-kid=\"1-9-1-1-3-1\" data-name=\"column heading\">\n                        Quick Links\n                    </h5>\n                    <ul class=\"space-y-2 text-white/80\" data-kid=\"1-9-1-1-3-2\" data-name=\"links list\">\n                        <li data-kid=\"1-9-1-1-3-2-1\" data-name=\"about link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-3-2-1-1\" data-name=\"about link\" href=\"about.html\">\n                                About the Department\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-3-2-2\" data-name=\"curriculum link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-3-2-2-1\" data-name=\"curriculum link\" href=\"academics.html\">\n                                Course Curriculum\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-3-2-3\" data-name=\"research link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-3-2-3-1\" data-name=\"research link\" href=\"news.html\">\n                                Research & Seminars\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-3-2-4\" data-name=\"staff link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-3-2-4-1\" data-name=\"staff link\" href=\"staff.html\">\n                                Academic Staff\n                            </a>\n                        </li>\n                        <li data-kid=\"1-9-1-1-3-2-5\" data-name=\"admissions link item\">\n                            <a class=\"hover:text-white transition\" data-kid=\"1-9-1-1-3-2-5-1\" data-name=\"admissions link\" href=\"contact.html\">\n                                Admissions Office\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <!-- Contact & Accreditation -->\n                <div class=\"md:col-span-3 space-y-3\" data-kid=\"1-9-1-1-4\" data-name=\"contact column\">\n                    <h5 class=\"font-bold uppercase tracking-wider text-white text-[11px] text-[#f67665]\" data-kid=\"1-9-1-1-4-1\" data-name=\"column heading\">\n                        Contact & Inquiries\n                    </h5>\n                    <div class=\"space-y-2 text-white/80\" data-kid=\"1-9-1-1-4-2\" data-name=\"contact info block\">\n                        <p class=\"flex items-center gap-2\" data-kid=\"1-9-1-1-4-2-1\" data-name=\"email row\">\n                            <i class=\"fa-solid fa-envelope text-[#f67665]\" data-kid=\"1-9-1-1-4-2-1-1\" data-name=\"envelope icon\">\n                            </i>\n                            psychology@esut.edu.ng\n                        </p>\n                        <p class=\"flex items-center gap-2\" data-kid=\"1-9-1-1-4-2-2\" data-name=\"phone row\">\n                            <i class=\"fa-solid fa-phone text-[#f67665]\" data-kid=\"1-9-1-1-4-2-2-1\" data-name=\"phone icon\">\n                            </i>\n                            +234 (0) 803 000 0000\n                        </p>\n                        <p class=\"text-white/60 text-[11px] pt-1\" data-kid=\"1-9-1-1-4-2-3\" data-name=\"office hours text\">\n                            Enquiries: Monday – Friday, 8:00 AM – 4:00 PM WAT\n                        </p>\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"1-9-1-1-4-3\" data-name=\"accreditation badge container\">\n                        <span class=\"inline-block px-2.5 py-1 rounded bg-white/10 text-[11px] text-white/80\" data-kid=\"1-9-1-1-4-3-1\" data-name=\"NUC accreditation badge\">\n                            National Universities Commission (NUC) Accredited\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Legal / Copyright -->\n            <div class=\"pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-white/60\" data-kid=\"1-9-1-2\" data-name=\"legal and copyright bar\">\n                <p data-kid=\"1-9-1-2-1\" data-name=\"copyright notice text\">\n                    © 2026 Department of Psychology, Enugu State University of Science and Technology (ESUT). All Rights Reserved.\n                </p>\n                <p data-kid=\"1-9-1-2-2\" data-name=\"campus location text\">\n                    Agbani Campus, Enugu State, Nigeria\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n",
