      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap');\n\n  :root {\n    --esut-maroon: #701500;\n    --esut-maroon-dark: #4a0d00;\n    --esut-maroon-light: #8d2008;\n    --esut-coral: #f67665;\n    --esut-gold: #b45309;\n    --esut-paper: #faf8f5;\n    --esut-ink: #1c1917;\n  }\n\n  body, html {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    color: #1c1917;\n    background-color: #faf8f5;\n    margin: 0;\n    padding: 0;\n    overflow-x: clip;\n    scroll-behavior: smooth;\n  }\n\n  .font-serif-title {\n    font-family: 'Cinzel', serif;\n  }\n\n  .font-mono-code {\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .prospectus-measure {\n    max-width: 68ch;\n  }\n</style>\n<link data-kid=\"1\" data-name=\"Font Awesome stylesheet link\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#FAF8F5] text-stone-900 antialiased selection:bg-[#701500] selection:text-white\" data-kid=\"2\" data-name=\"page layout container\">\n    <!-- 1. TOP UTILITY HEADER -->\n    <div class=\"border-b border-stone-200/80 bg-stone-900 text-stone-300 text-xs py-2 px-6\" data-kid=\"2-1\" data-name=\"top utility bar\">\n        <div class=\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4\" data-kid=\"2-1-1\" data-name=\"utility bar inner row\">\n            <div class=\"flex items-center gap-6\" data-kid=\"2-1-1-1\" data-name=\"campus and faculty display group\">\n                <span class=\"inline-flex items-center gap-2\" data-kid=\"2-1-1-1-1\" data-name=\"campus location indicator\">\n                    <span class=\"w-2 h-2 rounded-full bg-emerald-400\" data-kid=\"2-1-1-1-1-1\" data-name=\"live status dot\">\n                    </span>\n                    <span data-kid=\"2-1-1-1-1-2\" data-name=\"campus location text\">\n                        Agbani Main Campus · Enugu State, Nigeria\n                    </span>\n                </span>\n                <span class=\"hidden md:inline text-stone-500\" data-kid=\"2-1-1-1-2\" data-name=\"vertical separator text\">\n                    |\n                </span>\n                <span class=\"hidden md:inline text-stone-400 font-medium\" data-kid=\"2-1-1-1-3\" data-name=\"faculty name text\">\n                    Faculty of Social Sciences\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5 text-stone-300\" data-kid=\"2-1-1-2\" data-name=\"utility quick links group\">\n                <a class=\"hover:text-white transition-colors flex items-center gap-1.5\" data-kid=\"2-1-1-2-1\" data-name=\"exam timetable PDF link\" href=\"exam-timetable.pdf\" target=\"_blank\">\n                    <i class=\"fa-solid fa-file-pdf text-amber-400\" data-kid=\"2-1-1-2-1-1\" data-name=\"PDF document icon\">\n                    </i>\n                    Exam Timetable\n                </a>\n                <a class=\"hover:text-white transition-colors\" data-kid=\"2-1-1-2-2\" data-name=\"course materials link\" href=\"academics.html\">\n                    Course Materials\n                </a>\n                <a class=\"hover:text-white transition-colors\" data-kid=\"2-1-1-2-3\" data-name=\"staff directory link\" href=\"contact.html\">\n                    Staff Directory\n                </a>\n                <span class=\"text-stone-500\" data-kid=\"2-1-1-2-4\" data-name=\"vertical separator text\">\n                    |\n                </span>\n                <a class=\"text-amber-300 hover:text-amber-200 font-semibold flex items-center gap-1\" data-kid=\"2-1-1-2-5\" data-name=\"ESUT external portal link\" href=\"https://portal.esut.edu.ng\" target=\"_blank\">\n                    ESUT Portal\n                    <i class=\"fa-solid fa-arrow-up-right-from-square text-[10px]\" data-kid=\"2-1-1-2-5-1\" data-name=\"external link arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </div>\n    <!-- 2. INSTITUTIONAL MASTHEAD & NAVIGATION -->\n    <header class=\"bg-white border-b border-stone-200 sticky top-0 z-40 shadow-xs\" data-kid=\"2-2\" data-name=\"institutional masthead header\">\n        <div class=\"max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6\" data-kid=\"2-2-1\" data-name=\"masthead inner row\">\n            <!-- Crest + Brand Identity -->\n            <a class=\"flex items-center gap-4 group text-decoration-none\" data-kid=\"2-2-1-1\" data-name=\"brand identity link\" href=\"index.html\">\n                <div class=\"w-14 h-14 rounded-lg border border-stone-200 p-1 bg-white shadow-xs shrink-0 flex items-center justify-center\" data-kid=\"2-2-1-1-1\" data-name=\"crest icon container\">\n                    <img alt=\"ESUT Official Crest\" class=\"w-full h-full object-contain\" data-kid=\"2-2-1-1-1-1\" data-name=\"ESUT crest logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Enugu-State-University-of-Science-and-Technology-logo.jpg\"/>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"2-2-1-1-2\" data-name=\"brand text column\">\n                    <span class=\"font-serif-title tracking-wider text-xs font-bold text-stone-500 uppercase\" data-kid=\"2-2-1-1-2-1\" data-name=\"university name label\">\n                        Enugu State University of Science & Technology\n                    </span>\n                    <span class=\"text-xl md:text-2xl font-extrabold text-[#701500] tracking-tight leading-tight group-hover:text-[#8D2008] transition-colors\" data-kid=\"2-2-1-1-2-2\" data-name=\"department name heading\">\n                        Department of Psychology\n                    </span>\n                    <span class=\"text-xs text-stone-600 font-medium tracking-wide\" data-kid=\"2-2-1-1-2-3\" data-name=\"programme levels subtitle\">\n                        Undergraduate · Institute of Continuing Studies (ICS) · Postgraduate Studies\n                    </span>\n                </div>\n            </a>\n            <!-- Academic Nav Links -->\n            <nav class=\"hidden lg:flex items-center gap-1 text-sm font-semibold text-stone-700\" data-kid=\"2-2-1-2\" data-name=\"primary academic navigation\">\n                <a class=\"px-3.5 py-2 text-[#701500] font-bold border-b-2 border-[#701500]\" data-kid=\"2-2-1-2-1\" data-name=\"home nav link (active)\" href=\"index.html\">\n                    Home\n                </a>\n                <a class=\"px-3.5 py-2 hover:text-[#701500] transition-colors\" data-kid=\"2-2-1-2-2\" data-name=\"about faculty nav link\" href=\"about.html\">\n                    About Faculty\n                </a>\n                <a class=\"px-3.5 py-2 hover:text-[#701500] transition-colors\" data-kid=\"2-2-1-2-3\" data-name=\"programmes nav link\" href=\"programs.html\">\n                    Programmes\n                </a>\n                <a class=\"px-3.5 py-2 hover:text-[#701500] transition-colors\" data-kid=\"2-2-1-2-4\" data-name=\"curriculum nav link\" href=\"academics.html\">\n                    Curriculum\n                </a>\n                <a class=\"px-3.5 py-2 hover:text-[#701500] transition-colors\" data-kid=\"2-2-1-2-5\" data-name=\"seminars and news nav link\" href=\"news.html\">\n                    Seminars & News\n                </a>\n                <a class=\"px-3.5 py-2 hover:text-[#701500] transition-colors\" data-kid=\"2-2-1-2-6\" data-name=\"academic staff nav link\" href=\"staff.html\">\n                    Academic Staff\n                </a>\n                <a class=\"px-3.5 py-2 hover:text-[#701500] transition-colors\" data-kid=\"2-2-1-2-7\" data-name=\"contact nav link\" href=\"contact.html\">\n                    Contact\n                </a>\n            </nav>\n            <!-- Primary Action -->\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-3\" data-name=\"primary action group\">\n                <a class=\"hidden sm:inline-flex items-center gap-2 bg-[#701500] hover:bg-[#520f00] text-white text-xs md:text-sm font-bold px-4 py-2.5 rounded-md transition-all shadow-xs\" data-kid=\"2-2-1-3-1\" data-name=\"explore degree routes call-to-action button\" href=\"#pathways\">\n                    <span data-kid=\"2-2-1-3-1-1\" data-name=\"explore degree routes label\">\n                        Explore Degree Routes\n                    </span>\n                    <i class=\"fa-solid fa-arrow-down text-xs\" data-kid=\"2-2-1-3-1-2\" data-name=\"down arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- 3. COMMANDING HERO SECTION (Academic Institution & Leadership) -->\n    <section class=\"border-b border-stone-200 bg-linear-to-b from-stone-100/90 via-[#FAF8F5] to-white pt-12 pb-16 px-6\" data-kid=\"2-3\" data-name=\"hero prospectus section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"2-3-1\" data-name=\"hero content wrapper\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"2-3-1-1\" data-name=\"hero two-column grid\">\n                <!-- Left: Scholarly Thesis & Call to Action -->\n                <div class=\"lg:col-span-7 flex flex-col gap-6\" data-kid=\"2-3-1-1-1\" data-name=\"hero thesis and actions column\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-stone-200/80 rounded text-stone-800 text-xs font-mono font-semibold uppercase tracking-wider w-fit\" data-kid=\"2-3-1-1-1-1\" data-name=\"academic prospectus session badge\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#701500]\" data-kid=\"2-3-1-1-1-1-1\" data-name=\"session badge dot\">\n                        </span>\n                        Academic Prospectus · 2026/2027 Session\n                    </div>\n                    <h1 class=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#701500] tracking-tight leading-[1.15]\" data-kid=\"2-3-1-1-1-2\" data-name=\"hero headline statement\">\n                        The Scientific Study of Human Behaviour, Cognition, and Societal Wellbeing.\n                    </h1>\n                    <p class=\"prospectus-measure text-base sm:text-lg text-stone-700 leading-relaxed font-normal\" data-kid=\"2-3-1-1-1-3\" data-name=\"hero supporting description\">\n                        Rooted in biological mechanisms and social influence processes, the Department of Psychology at ESUT equips scholars and practitioners with rigorous psychological assessment, empirical research capability, and 21st-century intervention skills for national and international development.\n                    </p>\n                    <!-- Core Academic Credentials Strip -->\n                    <div class=\"grid grid-cols-3 gap-4 pt-2 border-t border-stone-200\" data-kid=\"2-3-1-1-1-4\" data-name=\"core credentials strip\">\n                        <div data-kid=\"2-3-1-1-1-4-1\" data-name=\"degrees awarded stat card\">\n                            <p class=\"text-xs uppercase tracking-wider font-semibold text-stone-500 font-mono\" data-kid=\"2-3-1-1-1-4-1-1\" data-name=\"degrees awarded label\">\n                                Degrees Awarded\n                            </p>\n                            <p class=\"text-sm sm:text-base font-bold text-stone-900 mt-0.5\" data-kid=\"2-3-1-1-1-4-1-2\" data-name=\"degree levels list value\">\n                                B.Sc · PGD · M.Sc · Ph.D\n                            </p>\n                            <p class=\"text-xs text-stone-500 mt-0.5\" data-kid=\"2-3-1-1-1-4-1-3\" data-name=\"degree levels footnote\">\n                                Undergraduate & Postgraduate\n                            </p>\n                        </div>\n                        <div data-kid=\"2-3-1-1-1-4-2\" data-name=\"specialisations stat card\">\n                            <p class=\"text-xs uppercase tracking-wider font-semibold text-stone-500 font-mono\" data-kid=\"2-3-1-1-1-4-2-1\" data-name=\"specialisations label\">\n                                Specialisations\n                            </p>\n                            <p class=\"text-sm sm:text-base font-bold text-stone-900 mt-0.5\" data-kid=\"2-3-1-1-1-4-2-2\" data-name=\"specialisation areas value\">\n                                Clinical · Neuro · I/O\n                            </p>\n                            <p class=\"text-xs text-stone-500 mt-0.5\" data-kid=\"2-3-1-1-1-4-2-3\" data-name=\"specialisations footnote\">\n                                Social & Health Psychology\n                            </p>\n                        </div>\n                        <div data-kid=\"2-3-1-1-1-4-3\" data-name=\"study flexibility stat card\">\n                            <p class=\"text-xs uppercase tracking-wider font-semibold text-stone-500 font-mono\" data-kid=\"2-3-1-1-1-4-3-1\" data-name=\"study flexibility label\">\n                                Study Flexibility\n                            </p>\n                            <p class=\"text-sm sm:text-base font-bold text-stone-900 mt-0.5\" data-kid=\"2-3-1-1-1-4-3-2\" data-name=\"study mode value\">\n                                Full-Time & ICS\n                            </p>\n                            <p class=\"text-xs text-stone-500 mt-0.5\" data-kid=\"2-3-1-1-1-4-3-3\" data-name=\"study mode footnote\">\n                                Regular & Continuing Studies\n                            </p>\n                        </div>\n                    </div>\n                    <!-- Hero Action Buttons -->\n                    <div class=\"flex flex-wrap items-center gap-4 pt-2\" data-kid=\"2-3-1-1-1-5\" data-name=\"hero action buttons row\">\n                        <a class=\"inline-flex items-center gap-2 bg-[#701500] hover:bg-[#520f00] text-white font-bold text-sm px-6 py-3.5 rounded-md transition-colors shadow-xs\" data-kid=\"2-3-1-1-1-5-1\" data-name=\"read academic prospectus primary button\" href=\"#prospectus-index\">\n                            <i class=\"fa-solid fa-book-open\" data-kid=\"2-3-1-1-1-5-1-1\" data-name=\"open book icon\">\n                            </i>\n                            Read Academic Prospectus\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 bg-white hover:bg-stone-50 border border-stone-300 text-stone-800 font-bold text-sm px-5 py-3.5 rounded-md transition-colors shadow-xs\" data-kid=\"2-3-1-1-1-5-2\" data-name=\"compare degree routes secondary button\" href=\"#pathways\">\n                            <i class=\"fa-solid fa-graduation-cap text-[#701500]\" data-kid=\"2-3-1-1-1-5-2-1\" data-name=\"graduation cap icon\">\n                            </i>\n                            Compare Degree Routes\n                        </a>\n                        <a class=\"inline-flex items-center gap-1.5 text-stone-700 hover:text-[#701500] text-sm font-semibold px-2 py-3.5 transition-colors\" data-kid=\"2-3-1-1-1-5-3\" data-name=\"view latest seminars text link\" href=\"news.html\">\n                            <span data-kid=\"2-3-1-1-1-5-3-1\" data-name=\"view latest seminars label\">\n                                View Latest Seminars\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-xs\" data-kid=\"2-3-1-1-1-5-3-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Right: Official Head of Department Address Card (Clean, Authentic, No Fake Avatar) -->\n                <div class=\"lg:col-span-5 bg-white border border-stone-200 rounded-lg p-6 lg:p-7 shadow-xs\" data-kid=\"2-3-1-1-2\" data-name=\"head of department welcome card\">\n                    <div class=\"flex items-center justify-between pb-4 border-b border-stone-100\" data-kid=\"2-3-1-1-2-1\" data-name=\"welcome card header row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-3-1-1-2-1-1\" data-name=\"leadership identity group\">\n                            <div class=\"w-10 h-10 rounded bg-[#701500]/10 text-[#701500] flex items-center justify-center font-bold text-lg\" data-kid=\"2-3-1-1-2-1-1-1\" data-name=\"landmark icon badge\">\n                                <i class=\"fa-solid fa-landmark\" data-kid=\"2-3-1-1-2-1-1-1-1\" data-name=\"landmark icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"2-3-1-1-2-1-1-2\" data-name=\"leadership title column\">\n                                <span class=\"text-xs uppercase font-mono tracking-wider text-stone-500 block\" data-kid=\"2-3-1-1-2-1-1-2-1\" data-name=\"departmental leadership label\">\n                                    Departmental Leadership\n                                </span>\n                                <span class=\"text-sm font-bold text-stone-900\" data-kid=\"2-3-1-1-2-1-1-2-2\" data-name=\"office of HOD title\">\n                                    Office of the Head of Department\n                                </span>\n                            </div>\n                        </div>\n                        <span class=\"px-2 py-0.5 bg-stone-100 text-stone-600 text-[11px] font-semibold rounded uppercase tracking-wider font-mono\" data-kid=\"2-3-1-1-2-1-2\" data-name=\"official welcome tag\">\n                            Official Welcome\n                        </span>\n                    </div>\n                    <div class=\"mt-4 text-stone-700 text-sm leading-relaxed space-y-3\" data-kid=\"2-3-1-1-2-2\" data-name=\"welcome message body\">\n                        <p data-kid=\"2-3-1-1-2-2-1\" data-name=\"first welcome paragraph\">\n                            <em data-kid=\"2-3-1-1-2-2-1-1\" data-name=\"welcome quote emphasis\">\n                                \"Welcome to the Department of Psychology at Enugu State University of Science and Technology. As one of the cornerstone disciplines in the social sciences, our curriculum integrates biological roots with cultural and interpersonal phenomena.\"\n                            </em>\n                        </p>\n                        <p data-kid=\"2-3-1-1-2-2-2\" data-name=\"second welcome paragraph\">\n                            <em data-kid=\"2-3-1-1-2-2-2-1\" data-name=\"second welcome quote emphasis\">\n                                \"Whether embarking on a foundational four-year degree, balancing professional obligations through the Institute of Continuing Studies, or pursuing cutting-edge postgraduate clinical research, you join a vibrant scholarly community dedicated to psychological innovation and ethical service.\"\n                            </em>\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-stone-100 flex items-center justify-between\" data-kid=\"2-3-1-1-2-3\" data-name=\"welcome card footer row\">\n                        <div data-kid=\"2-3-1-1-2-3-1\" data-name=\"HOD identity details\">\n                            <p class=\"font-bold text-stone-900 text-sm\" data-kid=\"2-3-1-1-2-3-1-1\" data-name=\"HOD name\">\n                                Dr. Ada Okafor\n                            </p>\n                            <p class=\"text-xs text-stone-600\" data-kid=\"2-3-1-1-2-3-1-2\" data-name=\"HOD role line\">\n                                Head of Department (HOD) · Ph.D, Psychology\n                            </p>\n                            <p class=\"text-[11px] text-[#701500] font-mono mt-0.5\" data-kid=\"2-3-1-1-2-3-1-3\" data-name=\"HOD email\">\n                                hod.psychology@esut.edu.ng\n                            </p>\n                        </div>\n                        <a class=\"text-xs font-bold text-[#701500] hover:underline flex items-center gap-1\" data-kid=\"2-3-1-1-2-3-2\" data-name=\"about faculty link in card\" href=\"about.html\">\n                            About Faculty\n                            <i class=\"fa-solid fa-chevron-right text-[10px]\" data-kid=\"2-3-1-1-2-3-2-1\" data-name=\"chevron right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 4. STICKY / ANCHORED PROSPECTUS NAV-RAIL -->\n    <div class=\"border-b border-stone-200 bg-stone-100/95 sticky top-[73px] z-30 backdrop-blur-xs\" data-kid=\"2-4\" data-name=\"sticky prospectus index nav-rail\" id=\"prospectus-index\">\n        <div class=\"max-w-7xl mx-auto px-6 py-2.5 flex items-center justify-between overflow-x-auto text-xs font-semibold text-stone-600\" data-kid=\"2-4-1\" data-name=\"nav-rail inner row\">\n            <div class=\"flex items-center gap-1 sm:gap-4 shrink-0\" data-kid=\"2-4-1-1\" data-name=\"prospectus chapter links group\">\n                <span class=\"font-mono text-[#701500] uppercase font-bold tracking-wider mr-2 hidden md:inline\" data-kid=\"2-4-1-1-1\" data-name=\"prospectus index label\">\n                    Prospectus Index:\n                </span>\n                <a class=\"px-3 py-1.5 rounded hover:bg-stone-200 hover:text-stone-900 transition-colors\" data-kid=\"2-4-1-1-2\" data-name=\"prospectus overview anchor link\" href=\"#overview\">\n                    01 Overview\n                </a>\n                <a class=\"px-3 py-1.5 rounded hover:bg-stone-200 hover:text-stone-900 transition-colors\" data-kid=\"2-4-1-1-3\" data-name=\"prospectus philosophy anchor link\" href=\"#philosophy\">\n                    02 Philosophy\n                </a>\n                <a class=\"px-3 py-1.5 rounded hover:bg-stone-200 hover:text-stone-900 transition-colors\" data-kid=\"2-4-1-1-4\" data-name=\"prospectus skills matrix anchor link\" href=\"#capability-matrix\">\n                    03 Skills Matrix\n                </a>\n                <a class=\"px-3 py-1.5 rounded hover:bg-stone-200 hover:text-stone-900 transition-colors\" data-kid=\"2-4-1-1-5\" data-name=\"prospectus degree routes anchor link\" href=\"#pathways\">\n                    04 Degree Routes\n                </a>\n                <a class=\"px-3 py-1.5 rounded hover:bg-stone-200 hover:text-stone-900 transition-colors\" data-kid=\"2-4-1-1-6\" data-name=\"prospectus seminars anchor link\" href=\"#notices\">\n                    05 Seminars & News\n                </a>\n                <a class=\"px-3 py-1.5 rounded hover:bg-stone-200 hover:text-stone-900 transition-colors\" data-kid=\"2-4-1-1-7\" data-name=\"prospectus student utilities anchor link\" href=\"#student-desk\">\n                    06 Student Utilities\n                </a>\n            </div>\n            <a class=\"shrink-0 text-[#701500] font-bold hover:underline flex items-center gap-1\" data-kid=\"2-4-1-2\" data-name=\"full course directory link\" href=\"course-descriptions.html\">\n                Full Course Directory\n                <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-4-1-2-1\" data-name=\"right arrow icon\">\n                </i>\n            </a>\n        </div>\n    </div>\n    <!-- 5. SECTION 01 & 02: DISCIPLINE OVERVIEW & EDUCATIONAL PHILOSOPHY -->\n    <section class=\"py-16 px-6 border-b border-stone-200 bg-white\" data-kid=\"2-5\" data-name=\"overview and philosophy section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"2-5-1\" data-name=\"section content wrapper\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-start\" data-kid=\"2-5-1-1\" data-name=\"section two-column grid\">\n                <!-- Left: Prospectus Contents Anchor Summary -->\n                <div class=\"lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-36\" data-kid=\"2-5-1-1-1\" data-name=\"sticky chapters summary column\">\n                    <div class=\"border-l-4 border-[#701500] pl-4\" data-kid=\"2-5-1-1-1-1\" data-name=\"chapter heading block\">\n                        <span class=\"text-xs font-mono font-bold uppercase text-[#701500] tracking-wider\" data-kid=\"2-5-1-1-1-1-1\" data-name=\"chapter label\">\n                            Prospectus Chapter 01 & 02\n                        </span>\n                        <h2 class=\"text-2xl font-extrabold text-stone-900 tracking-tight mt-1\" data-kid=\"2-5-1-1-1-1-2\" data-name=\"chapter heading\">\n                            Disciplinary Scope & National Philosophy\n                        </h2>\n                    </div>\n                    <p class=\"text-sm text-stone-600 leading-relaxed\" data-kid=\"2-5-1-1-1-2\" data-name=\"chapter summary text\">\n                        Psychology at ESUT is structured in full alignment with the benchmark curriculum approved for Nigerian universities, targeting both intra-personal psychological adjustment and large-scale societal transformation.\n                    </p>\n                    <div class=\"bg-stone-50 border border-stone-200 rounded p-4 text-xs text-stone-700 space-y-2.5\" data-kid=\"2-5-1-1-1-3\" data-name=\"curricular domains panel\">\n                        <p class=\"font-bold text-stone-900 uppercase font-mono tracking-wider\" data-kid=\"2-5-1-1-1-3-1\" data-name=\"curricular domains heading\">\n                            Key Curricular Domains:\n                        </p>\n                        <div class=\"flex flex-wrap gap-1.5\" data-kid=\"2-5-1-1-1-3-2\" data-name=\"domain tag list\">\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-1\" data-name=\"clinical psychology tag\">\n                                Clinical Psychology\n                            </span>\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-2\" data-name=\"neurobiological basis tag\">\n                                Neurobiological Basis\n                            </span>\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-3\" data-name=\"behavioural medicine tag\">\n                                Behavioural Medicine\n                            </span>\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-4\" data-name=\"industrial and organisational tag\">\n                                Industrial & Organisational\n                            </span>\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-5\" data-name=\"social psychology tag\">\n                                Social Psychology\n                            </span>\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-6\" data-name=\"psychometrics tag\">\n                                Psychometrics\n                            </span>\n                            <span class=\"px-2 py-1 bg-white border border-stone-200 rounded font-medium\" data-kid=\"2-5-1-1-1-3-2-7\" data-name=\"crisis and trauma tag\">\n                                Crisis & Trauma Studies\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"2-5-1-1-1-4\" data-name=\"history link block\">\n                        <a class=\"inline-flex items-center gap-2 text-sm font-bold text-[#701500] hover:underline\" data-kid=\"2-5-1-1-1-4-1\" data-name=\"department history link\" href=\"about.html\">\n                            <span data-kid=\"2-5-1-1-1-4-1-1\" data-name=\"history link label\">\n                                Read complete department history & faculty profiles\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-xs\" data-kid=\"2-5-1-1-1-4-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Right: Structured Reading Column (Disciplined Measure) -->\n                <div class=\"lg:col-span-8 flex flex-col gap-10\" data-kid=\"2-5-1-1-2\" data-name=\"structured reading column\">\n                    <!-- 01 Overview -->\n                    <article class=\"border-b border-stone-200 pb-10\" data-kid=\"2-5-1-1-2-1\" data-name=\"section 1.0 overview article\" id=\"overview\">\n                        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"2-5-1-1-2-1-1\" data-name=\"section 1.0 header row\">\n                            <span class=\"font-mono text-sm font-bold text-[#701500] bg-[#701500]/10 px-2 py-0.5 rounded\" data-kid=\"2-5-1-1-2-1-1-1\" data-name=\"section 1.0 number badge\">\n                                Section 1.0\n                            </span>\n                            <h3 class=\"text-xl font-bold text-stone-900\" data-kid=\"2-5-1-1-2-1-1-2\" data-name=\"section 1.0 heading\">\n                                Overview of the Academic Discipline\n                            </h3>\n                        </div>\n                        <div class=\"prospectus-measure text-stone-700 leading-relaxed space-y-4 text-base\" data-kid=\"2-5-1-1-2-1-2\" data-name=\"section 1.0 body\">\n                            <p data-kid=\"2-5-1-1-2-1-2-1\" data-name=\"section 1.0 first paragraph\">\n                                Psychology is an empirical science that investigates human and non-human behaviour from its neurological and physiological foundations to its complex manifestations in social influence and cultural dynamics. At ESUT, students are trained to explain, predict, and scientifically modify behavioural patterns to foster lasting order, mental health, and individual productivity in human society.\n                            </p>\n                            <p data-kid=\"2-5-1-1-2-1-2-2\" data-name=\"section 1.0 second paragraph\">\n                                As a premier profession in the social sciences, the Department provides students with rigorous training across clinical psychology, neurobiological psychology, behavioural medicine, industrial/organisational psychology, positive psychology, and health psychology. Graduates step directly into positions in health institutions, secondary and tertiary educational systems, non-governmental organisations, human resource consultancies, industries, and state security agencies.\n                            </p>\n                        </div>\n                    </article>\n                    <!-- 02 Philosophy -->\n                    <article data-kid=\"2-5-1-1-2-2\" data-name=\"section 2.0 philosophy article\" id=\"philosophy\">\n                        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"2-5-1-1-2-2-1\" data-name=\"section 2.0 header row\">\n                            <span class=\"font-mono text-sm font-bold text-[#701500] bg-[#701500]/10 px-2 py-0.5 rounded\" data-kid=\"2-5-1-1-2-2-1-1\" data-name=\"section 2.0 number badge\">\n                                Section 2.0\n                            </span>\n                            <h3 class=\"text-xl font-bold text-stone-900\" data-kid=\"2-5-1-1-2-2-1-2\" data-name=\"section 2.0 heading\">\n                                Educational Philosophy & National Mission\n                            </h3>\n                        </div>\n                        <div class=\"prospectus-measure text-stone-700 leading-relaxed space-y-4 text-base\" data-kid=\"2-5-1-1-2-2-2\" data-name=\"section 2.0 body\">\n                            <p data-kid=\"2-5-1-1-2-2-2-1\" data-name=\"philosophy first paragraph\">\n                                As a science, Psychology seeks to discover underlying behavioural patterns using verified empirical facts, universal principles, and structured generalisations. This deepens scientific comprehension of individual action across diverse institutional, cultural, and community settings.\n                            </p>\n                            <p data-kid=\"2-5-1-1-2-2-2-2\" data-name=\"philosophy second paragraph\">\n                                The philosophy behind our curriculum is specifically constructed to arm university graduates with theoretical models, practical assessment methods, and therapeutic principles capable of modifying behaviour toward harmonious interpersonal coexistence, civic responsibility, and overall economic, political, and national development across Nigeria.\n                            </p>\n                        </div>\n                        <!-- Professional Outlets Grid -->\n                        <div class=\"mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4\" data-kid=\"2-5-1-1-2-2-3\" data-name=\"professional outlets grid\">\n                            <div class=\"bg-stone-50 border border-stone-200 rounded p-4\" data-kid=\"2-5-1-1-2-2-3-1\" data-name=\"clinical healthcare card\">\n                                <h4 class=\"font-bold text-stone-900 text-sm flex items-center gap-2\" data-kid=\"2-5-1-1-2-2-3-1-1\" data-name=\"clinical card title\">\n                                    <i class=\"fa-solid fa-hospital-user text-[#701500]\" data-kid=\"2-5-1-1-2-2-3-1-1-1\" data-name=\"hospital user icon\">\n                                    </i>\n                                    Clinical & Healthcare Horizons\n                                </h4>\n                                <p class=\"text-xs text-stone-600 mt-1.5 leading-relaxed\" data-kid=\"2-5-1-1-2-2-3-1-2\" data-name=\"clinical card description\">\n                                    Hospital psychiatric units, community health centres, rehabilitation facilities, mental health NGOs, and private adjustment clinics.\n                                </p>\n                            </div>\n                            <div class=\"bg-stone-50 border border-stone-200 rounded p-4\" data-kid=\"2-5-1-1-2-2-3-2\" data-name=\"corporate advisory card\">\n                                <h4 class=\"font-bold text-stone-900 text-sm flex items-center gap-2\" data-kid=\"2-5-1-1-2-2-3-2-1\" data-name=\"corporate card title\">\n                                    <i class=\"fa-solid fa-briefcase text-[#701500]\" data-kid=\"2-5-1-1-2-2-3-2-1-1\" data-name=\"briefcase icon\">\n                                    </i>\n                                    Corporate & Institutional Advisory\n                                </h4>\n                                <p class=\"text-xs text-stone-600 mt-1.5 leading-relaxed\" data-kid=\"2-5-1-1-2-2-3-2-2\" data-name=\"corporate card description\">\n                                    Talent recruitment, executive leadership assessment, employee wellbeing, sports club psychological conditioning, and government policy formulation.\n                                </p>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 6. SECTION 03: 4-QUADRANT 21ST-CENTURY CAPABILITY & SKILLS MATRIX -->\n    <!-- Replaces the 16 repetitive unlabelled bullets with an authored, structured academic matrix -->\n    <section class=\"py-16 px-6 border-b border-stone-200 bg-[#FAF8F5]\" data-kid=\"2-6\" data-name=\"capability matrix section\" id=\"capability-matrix\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"2-6-1\" data-name=\"section content wrapper\">\n            <div class=\"max-w-3xl mb-12\" data-kid=\"2-6-1-1\" data-name=\"section intro block\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-stone-200 rounded text-stone-800 text-xs font-mono font-semibold uppercase tracking-wider mb-3\" data-kid=\"2-6-1-1-1\" data-name=\"chapter 03 badge\">\n                    Prospectus Chapter 03 · Applied Competencies\n                </div>\n                <h2 class=\"text-3xl font-extrabold text-stone-900 tracking-tight\" data-kid=\"2-6-1-1-2\" data-name=\"skills matrix headline\">\n                    Graduate Capability & 21st-Century Skills Matrix\n                </h2>\n                <p class=\"text-base text-stone-600 mt-3 leading-relaxed\" data-kid=\"2-6-1-1-3\" data-name=\"skills matrix intro text\">\n                    Rather than abstract lecture promises, our academic syllabus builds verifiable competencies across four load-bearing psychological domains, ensuring graduates can assess, investigate, support, and advise immediately upon degree completion.\n                </p>\n            </div>\n            <!-- The 4 Structured Quadrants -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch\" data-kid=\"2-6-1-2\" data-name=\"four quadrant grid\">\n                <!-- Quadrant 1: ASSESS (Psychometrics & Diagnostics) -->\n                <div class=\"bg-white border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between shadow-xs\" data-kid=\"2-6-1-2-1\" data-name=\"psychometrics quadrant card\">\n                    <div data-kid=\"2-6-1-2-1-1\" data-name=\"psychometrics card content\">\n                        <div class=\"flex items-center justify-between pb-4 border-b border-stone-100\" data-kid=\"2-6-1-2-1-1-1\" data-name=\"psychometrics card header row\">\n                            <span class=\"font-mono text-xs font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-6-1-2-1-1-1-1\" data-name=\"domain 01 label\">\n                                Domain 01 · Diagnostic Measure\n                            </span>\n                            <span class=\"text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded font-mono font-semibold\" data-kid=\"2-6-1-2-1-1-1-2\" data-name=\"psychometrics tag\">\n                                Psychometrics\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold text-stone-900 mt-4\" data-kid=\"2-6-1-2-1-1-2\" data-name=\"psychometrics heading\">\n                            Psychometric Testing & Behavioural Assessment\n                        </h3>\n                        <p class=\"text-sm text-stone-600 mt-2 leading-relaxed\" data-kid=\"2-6-1-2-1-1-3\" data-name=\"psychometrics intro\">\n                            Standardised measurement tools are the bedrock of clinical diagnosis and personnel evaluation. Students master:\n                        </p>\n                        <ul class=\"mt-4 space-y-2.5 text-xs text-stone-700\" data-kid=\"2-6-1-2-1-1-4\" data-name=\"psychometrics skill list\">\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-1-1-4-1\" data-name=\"test construction list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-1-1-4-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-1-1-4-1-2\" data-name=\"test construction description\">\n                                    <strong data-kid=\"2-6-1-2-1-1-4-1-2-1\" data-name=\"test construction title\">\n                                        Psychometric Test Construction:\n                                    </strong>\n                                    Developing and empirically validating objective psychological assessment scales.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-1-1-4-2\" data-name=\"clinical administration list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-1-1-4-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-1-1-4-2-2\" data-name=\"administration description\">\n                                    <strong data-kid=\"2-6-1-2-1-1-4-2-2-1\" data-name=\"administration title\">\n                                        Clinical Test Administration:\n                                    </strong>\n                                    Ethical protocols for administering intelligence, personality, and neuro-cognitive batteries.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-1-1-4-3\" data-name=\"interpretation list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-1-1-4-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-1-1-4-3-2\" data-name=\"interpretation description\">\n                                    <strong data-kid=\"2-6-1-2-1-1-4-3-2-1\" data-name=\"interpretation title\">\n                                        Diagnostic Interpretation:\n                                    </strong>\n                                    Accurate scoring, multi-trait profile interpretation, and formal psychometric reporting.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium\" data-kid=\"2-6-1-2-1-2\" data-name=\"psychometrics course reference\">\n                        Core Course Reference: PSY 201, PSY 305 (Psychometrics & Psychological Testing)\n                    </div>\n                </div>\n                <!-- Quadrant 2: INVESTIGATE (Research & Empirical Analysis) -->\n                <div class=\"bg-white border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between shadow-xs\" data-kid=\"2-6-1-2-2\" data-name=\"research quadrant card\">\n                    <div data-kid=\"2-6-1-2-2-1\" data-name=\"research card content\">\n                        <div class=\"flex items-center justify-between pb-4 border-b border-stone-100\" data-kid=\"2-6-1-2-2-1-1\" data-name=\"research card header row\">\n                            <span class=\"font-mono text-xs font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-6-1-2-2-1-1-1\" data-name=\"domain 02 label\">\n                                Domain 02 · Scientific Inquiry\n                            </span>\n                            <span class=\"text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded font-mono font-semibold\" data-kid=\"2-6-1-2-2-1-1-2\" data-name=\"empirical research tag\">\n                                Empirical Research\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold text-stone-900 mt-4\" data-kid=\"2-6-1-2-2-1-2\" data-name=\"research heading\">\n                            Research Design & Statistical Analysis\n                        </h3>\n                        <p class=\"text-sm text-stone-600 mt-2 leading-relaxed\" data-kid=\"2-6-1-2-2-1-3\" data-name=\"research intro\">\n                            Transforming observational hypotheses into repeatable quantitative and qualitative evidence:\n                        </p>\n                        <ul class=\"mt-4 space-y-2.5 text-xs text-stone-700\" data-kid=\"2-6-1-2-2-1-4\" data-name=\"research skill list\">\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-2-1-4-1\" data-name=\"experimental design list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-2-1-4-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-2-1-4-1-2\" data-name=\"design description\">\n                                    <strong data-kid=\"2-6-1-2-2-1-4-1-2-1\" data-name=\"design title\">\n                                        Experimental Design:\n                                    </strong>\n                                    Controlled laboratory trials, naturalistic observational setups, and survey sampling frameworks.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-2-1-4-2\" data-name=\"statistical computation list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-2-1-4-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-2-1-4-2-2\" data-name=\"statistical description\">\n                                    <strong data-kid=\"2-6-1-2-2-1-4-2-2-1\" data-name=\"statistical title\">\n                                        Statistical Computation:\n                                    </strong>\n                                    Univariate and multivariate data analysis using modern software packages (SPSS, R).\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-2-1-4-3\" data-name=\"academic report list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-2-1-4-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-2-1-4-3-2\" data-name=\"report description\">\n                                    <strong data-kid=\"2-6-1-2-2-1-4-3-2-1\" data-name=\"report title\">\n                                        Academic Report Writing:\n                                    </strong>\n                                    Structured documentation of empirical findings compliant with APA publishing standards.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium\" data-kid=\"2-6-1-2-2-2\" data-name=\"research course reference\">\n                        Core Course Reference: PSY 203, PSY 401 (Research Methods & Senior Thesis)\n                    </div>\n                </div>\n                <!-- Quadrant 3: SUPPORT (Counselling & Trauma Management) -->\n                <div class=\"bg-white border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between shadow-xs\" data-kid=\"2-6-1-2-3\" data-name=\"counselling quadrant card\">\n                    <div data-kid=\"2-6-1-2-3-1\" data-name=\"counselling card content\">\n                        <div class=\"flex items-center justify-between pb-4 border-b border-stone-100\" data-kid=\"2-6-1-2-3-1-1\" data-name=\"counselling card header row\">\n                            <span class=\"font-mono text-xs font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-6-1-2-3-1-1-1\" data-name=\"domain 03 label\">\n                                Domain 03 · Direct Intervention\n                            </span>\n                            <span class=\"text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded font-mono font-semibold\" data-kid=\"2-6-1-2-3-1-1-2\" data-name=\"clinical support tag\">\n                                Clinical Support\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold text-stone-900 mt-4\" data-kid=\"2-6-1-2-3-1-2\" data-name=\"counselling heading\">\n                            Psychological Counselling & Crisis Management\n                        </h3>\n                        <p class=\"text-sm text-stone-600 mt-2 leading-relaxed\" data-kid=\"2-6-1-2-3-1-3\" data-name=\"counselling intro\">\n                            Intervention models for individual wellbeing, rehabilitation, and post-crisis stability:\n                        </p>\n                        <ul class=\"mt-4 space-y-2.5 text-xs text-stone-700\" data-kid=\"2-6-1-2-3-1-4\" data-name=\"counselling skill list\">\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-3-1-4-1\" data-name=\"adjustment counselling list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-3-1-4-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-3-1-4-1-2\" data-name=\"adjustment description\">\n                                    <strong data-kid=\"2-6-1-2-3-1-4-1-2-1\" data-name=\"adjustment title\">\n                                        Adjustment Counselling:\n                                    </strong>\n                                    Facilitating behavioral adaptation during academic, marital, bereavement, or career transitions.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-3-1-4-2\" data-name=\"trauma intervention list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-3-1-4-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-3-1-4-2-2\" data-name=\"trauma description\">\n                                    <strong data-kid=\"2-6-1-2-3-1-4-2-2-1\" data-name=\"trauma title\">\n                                        Trauma & Crisis Intervention:\n                                    </strong>\n                                    Psychological first aid, post-traumatic stress management, and peace building protocols.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-3-1-4-3\" data-name=\"emotional intelligence list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-3-1-4-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-3-1-4-3-2\" data-name=\"emotional intelligence description\">\n                                    <strong data-kid=\"2-6-1-2-3-1-4-3-2-1\" data-name=\"emotional intelligence title\">\n                                        Emotional Intelligence & Integrity:\n                                    </strong>\n                                    Self-regulation, pro-ecological behaviour, and personal wellness preservation.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium\" data-kid=\"2-6-1-2-3-2\" data-name=\"counselling course reference\">\n                        Core Course Reference: PSY 307, PSY 411 (Counselling & Crisis Intervention)\n                    </div>\n                </div>\n                <!-- Quadrant 4: APPLY (Forensic, Organisational & Policy Consultation) -->\n                <div class=\"bg-white border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between shadow-xs\" data-kid=\"2-6-1-2-4\" data-name=\"organisational quadrant card\">\n                    <div data-kid=\"2-6-1-2-4-1\" data-name=\"organisational card content\">\n                        <div class=\"flex items-center justify-between pb-4 border-b border-stone-100\" data-kid=\"2-6-1-2-4-1-1\" data-name=\"organisational card header row\">\n                            <span class=\"font-mono text-xs font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-6-1-2-4-1-1-1\" data-name=\"domain 04 label\">\n                                Domain 04 · Societal & Policy Systems\n                            </span>\n                            <span class=\"text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded font-mono font-semibold\" data-kid=\"2-6-1-2-4-1-1-2\" data-name=\"institutional advisory tag\">\n                                Institutional Advisory\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl font-bold text-stone-900 mt-4\" data-kid=\"2-6-1-2-4-1-2\" data-name=\"organisational heading\">\n                            Forensic, Sports & Organisational Consultation\n                        </h3>\n                        <p class=\"text-sm text-stone-600 mt-2 leading-relaxed\" data-kid=\"2-6-1-2-4-1-3\" data-name=\"organisational intro\">\n                            Applying behavioural science in corporate boardrooms, justice courts, and government parastatals:\n                        </p>\n                        <ul class=\"mt-4 space-y-2.5 text-xs text-stone-700\" data-kid=\"2-6-1-2-4-1-4\" data-name=\"organisational skill list\">\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-4-1-4-1\" data-name=\"talent advisory list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-4-1-4-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-4-1-4-1-2\" data-name=\"advisory description\">\n                                    <strong data-kid=\"2-6-1-2-4-1-4-1-2-1\" data-name=\"advisory title\">\n                                        Industrial Talent Advisory:\n                                    </strong>\n                                    Objective competency-based employee recruitment, leadership development, and workplace ergonomics.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-4-1-4-2\" data-name=\"forensic services list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-4-1-4-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-4-1-4-2-2\" data-name=\"forensic description\">\n                                    <strong data-kid=\"2-6-1-2-4-1-4-2-2-1\" data-name=\"forensic title\">\n                                        Forensic Services:\n                                    </strong>\n                                    Psychological evaluation for criminal justice proceedings, offender reform, and investigative support.\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\" data-kid=\"2-6-1-2-4-1-4-3\" data-name=\"public policy list item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 text-xs mt-0.5\" data-kid=\"2-6-1-2-4-1-4-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-6-1-2-4-1-4-3-2\" data-name=\"policy description\">\n                                    <strong data-kid=\"2-6-1-2-4-1-4-3-2-1\" data-name=\"policy title\">\n                                        Public Policy Advisory:\n                                    </strong>\n                                    Data-driven consultation for local, state, and federal bodies in social welfare legislation.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-stone-100 text-xs text-stone-500 font-medium\" data-kid=\"2-6-1-2-4-2\" data-name=\"organisational course reference\">\n                        Core Course Reference: PSY 312, PSY 415 (Forensic & Organisational Psychology)\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 7. SECTION 04: DEGREE PATHWAYS & ACADEMIC QUALIFICATIONS -->\n    <section class=\"py-16 px-6 border-b border-stone-200 bg-white\" data-kid=\"2-7\" data-name=\"degree pathways section\" id=\"pathways\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"2-7-1\" data-name=\"section content wrapper\">\n            <div class=\"max-w-3xl mb-12\" data-kid=\"2-7-1-1\" data-name=\"section intro block\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-stone-200 rounded text-stone-800 text-xs font-mono font-semibold uppercase tracking-wider mb-3\" data-kid=\"2-7-1-1-1\" data-name=\"chapter 04 badge\">\n                    Prospectus Chapter 04 · Degree Explorer\n                </div>\n                <h2 class=\"text-3xl font-extrabold text-stone-900 tracking-tight\" data-kid=\"2-7-1-1-2\" data-name=\"pathways headline\">\n                    Academic Programmes & Admission Pathways\n                </h2>\n                <p class=\"text-base text-stone-600 mt-3 leading-relaxed\" data-kid=\"2-7-1-1-3\" data-name=\"pathways intro text\">\n                    The Department operates three distinct qualification routes tailored to secondary school leavers, working practitioners, and advanced postgraduates. Select a pathway below for verified durations, entry prerequisites, and syllabus documents.\n                </p>\n            </div>\n            <!-- The 3 Aligned Degree Pathways Cards -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch\" data-kid=\"2-7-1-2\" data-name=\"degree pathway cards grid\">\n                <!-- Pathway 1: Undergraduate (B.Sc) -->\n                <div class=\"bg-stone-50 border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between hover:border-[#701500]/50 transition-colors\" data-kid=\"2-7-1-2-1\" data-name=\"undergraduate pathway card\">\n                    <div data-kid=\"2-7-1-2-1-1\" data-name=\"undergraduate card content\">\n                        <div class=\"flex items-center justify-between pb-3 border-b border-stone-200\" data-kid=\"2-7-1-2-1-1-1\" data-name=\"undergraduate card header row\">\n                            <span class=\"text-xs font-mono font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-7-1-2-1-1-1-1\" data-name=\"regular degree label\">\n                                Regular Degree\n                            </span>\n                            <span class=\"px-2 py-0.5 bg-amber-100 text-amber-800 font-mono text-[11px] font-bold rounded\" data-kid=\"2-7-1-2-1-1-1-2\" data-name=\"B.Sc tag\">\n                                B.Sc Psychology\n                            </span>\n                        </div>\n                        <h3 class=\"text-2xl font-bold text-stone-900 mt-4\" data-kid=\"2-7-1-2-1-1-2\" data-name=\"undergraduate heading\">\n                            Undergraduate Programme\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mt-1\" data-kid=\"2-7-1-2-1-1-3\" data-name=\"undergraduate subtitle\">\n                            Full-time regular programme on Agbani Campus\n                        </p>\n                        <!-- Duration & Route Breakdown -->\n                        <div class=\"mt-5 space-y-3 bg-white p-3.5 rounded border border-stone-200/80 text-xs\" data-kid=\"2-7-1-2-1-1-4\" data-name=\"duration breakdown panel\">\n                            <div class=\"flex justify-between items-center pb-2 border-b border-stone-100\" data-kid=\"2-7-1-2-1-1-4-1\" data-name=\"UTME track row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-1-1-4-1-1\" data-name=\"UTME track label\">\n                                    Standard UTME Track\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-1-1-4-1-2\" data-name=\"UTME duration value\">\n                                    4 Academic Years\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between items-center pb-2 border-b border-stone-100\" data-kid=\"2-7-1-2-1-1-4-2\" data-name=\"direct entry track row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-1-1-4-2-1\" data-name=\"DE track label\">\n                                    Direct Entry (DE) Track\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-1-1-4-2-2\" data-name=\"DE duration value\">\n                                    3 Academic Years\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between items-center\" data-kid=\"2-7-1-2-1-1-4-3\" data-name=\"credit units row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-1-1-4-3-1\" data-name=\"credit units label\">\n                                    Credit Units Required\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-1-1-4-3-2\" data-name=\"credit units value\">\n                                    144–160 Units\n                                </span>\n                            </div>\n                        </div>\n                        <!-- Key Modules Preview -->\n                        <div class=\"mt-5 text-xs text-stone-700\" data-kid=\"2-7-1-2-1-1-5\" data-name=\"curriculum highlights block\">\n                            <p class=\"font-bold text-stone-900 mb-2\" data-kid=\"2-7-1-2-1-1-5-1\" data-name=\"highlights label\">\n                                Curriculum Highlights:\n                            </p>\n                            <ul class=\"space-y-1.5 text-stone-600\" data-kid=\"2-7-1-2-1-1-5-2\" data-name=\"highlights list\">\n                                <li data-kid=\"2-7-1-2-1-1-5-2-1\" data-name=\"general psychology module item\">\n                                    • General Psychology & History of Thought (PSY 101/102)\n                                </li>\n                                <li data-kid=\"2-7-1-2-1-1-5-2-2\" data-name=\"physiological psychology module item\">\n                                    • Physiological Roots of Behaviour (PSY 201/202)\n                                </li>\n                                <li data-kid=\"2-7-1-2-1-1-5-2-3\" data-name=\"developmental module item\">\n                                    • Developmental & Social Interaction (PSY 301/302)\n                                </li>\n                                <li data-kid=\"2-7-1-2-1-1-5-2-4\" data-name=\"practicum and thesis item\">\n                                    • Supervised SIWES Clinical Practicum & Senior Thesis\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"mt-8 pt-4 border-t border-stone-200 flex items-center justify-between\" data-kid=\"2-7-1-2-1-2\" data-name=\"undergraduate footer row\">\n                        <a class=\"text-xs font-bold text-[#701500] hover:underline flex items-center gap-1.5\" data-kid=\"2-7-1-2-1-2-1\" data-name=\"view admission requirements link\" href=\"programs.html#undergrad\">\n                            <span data-kid=\"2-7-1-2-1-2-1-1\" data-name=\"requirements link label\">\n                                View Admission Requirements\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-7-1-2-1-2-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"text-xs text-stone-500 hover:text-stone-900\" data-kid=\"2-7-1-2-1-2-2\" data-name=\"syllabus link\" href=\"course-descriptions.html\">\n                            Syllabus\n                        </a>\n                    </div>\n                </div>\n                <!-- Pathway 2: Institute of Continuing Studies (ICS) -->\n                <div class=\"bg-stone-50 border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between hover:border-[#701500]/50 transition-colors\" data-kid=\"2-7-1-2-2\" data-name=\"ICS pathway card\">\n                    <div data-kid=\"2-7-1-2-2-1\" data-name=\"ICS card content\">\n                        <div class=\"flex items-center justify-between pb-3 border-b border-stone-200\" data-kid=\"2-7-1-2-2-1-1\" data-name=\"ICS card header row\">\n                            <span class=\"text-xs font-mono font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-7-1-2-2-1-1-1\" data-name=\"flexible access label\">\n                                Flexible Access\n                            </span>\n                            <span class=\"px-2 py-0.5 bg-sky-100 text-sky-800 font-mono text-[11px] font-bold rounded\" data-kid=\"2-7-1-2-2-1-1-2\" data-name=\"ICS tag\">\n                                ICS Programme\n                            </span>\n                        </div>\n                        <h3 class=\"text-2xl font-bold text-stone-900 mt-4\" data-kid=\"2-7-1-2-2-1-2\" data-name=\"ICS heading\">\n                            Continuing Studies (ICS)\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mt-1\" data-kid=\"2-7-1-2-2-1-3\" data-name=\"ICS subtitle\">\n                            Flexible part-time evening/weekend modular format\n                        </p>\n                        <!-- Duration & Route Breakdown -->\n                        <div class=\"mt-5 space-y-3 bg-white p-3.5 rounded border border-stone-200/80 text-xs\" data-kid=\"2-7-1-2-2-1-4\" data-name=\"ICS duration breakdown panel\">\n                            <div class=\"flex justify-between items-center pb-2 border-b border-stone-100\" data-kid=\"2-7-1-2-2-1-4-1\" data-name=\"WASSCE entry row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-2-1-4-1-1\" data-name=\"WASSCE entry label\">\n                                    Standard Entry (WASSCE/NECO)\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-2-1-4-1-2\" data-name=\"WASSCE duration value\">\n                                    5 Academic Years\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between items-center pb-2 border-b border-stone-100\" data-kid=\"2-7-1-2-2-1-4-2\" data-name=\"advanced diploma entry row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-2-1-4-2-1\" data-name=\"adv diploma label\">\n                                    Advanced Diploma Entry\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-2-1-4-2-2\" data-name=\"adv diploma duration\">\n                                    4 Academic Years\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between items-center\" data-kid=\"2-7-1-2-2-1-4-3\" data-name=\"graduate direct entry row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-2-1-4-3-1\" data-name=\"grad DE label\">\n                                    Graduate Direct Entry\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-2-1-4-3-2\" data-name=\"grad DE duration\">\n                                    3 Academic Years\n                                </span>\n                            </div>\n                        </div>\n                        <!-- Key Modules Preview -->\n                        <div class=\"mt-5 text-xs text-stone-700\" data-kid=\"2-7-1-2-2-1-5\" data-name=\"ICS features block\">\n                            <p class=\"font-bold text-stone-900 mb-2\" data-kid=\"2-7-1-2-2-1-5-1\" data-name=\"ICS features label\">\n                                Designed for Working Professionals:\n                            </p>\n                            <ul class=\"space-y-1.5 text-stone-600\" data-kid=\"2-7-1-2-2-1-5-2\" data-name=\"ICS features list\">\n                                <li data-kid=\"2-7-1-2-2-1-5-2-1\" data-name=\"weekend lectures item\">\n                                    • Synchronised weekend lectures & digital study modules\n                                </li>\n                                <li data-kid=\"2-7-1-2-2-1-5-2-2\" data-name=\"identical qualification item\">\n                                    • Identical degree qualification and academic standards\n                                </li>\n                                <li data-kid=\"2-7-1-2-2-1-5-2-3\" data-name=\"specialisations item\">\n                                    • Industrial, organisational, and counselling specialisations\n                                </li>\n                                <li data-kid=\"2-7-1-2-2-1-5-2-4\" data-name=\"flexible pace item\">\n                                    • Flexible pace for healthcare, civil service, and security staff\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"mt-8 pt-4 border-t border-stone-200 flex items-center justify-between\" data-kid=\"2-7-1-2-2-2\" data-name=\"ICS footer row\">\n                        <a class=\"text-xs font-bold text-[#701500] hover:underline flex items-center gap-1.5\" data-kid=\"2-7-1-2-2-2-1\" data-name=\"view ICS schedule link\" href=\"programs.html#ics\">\n                            <span data-kid=\"2-7-1-2-2-2-1-1\" data-name=\"ICS schedule link label\">\n                                View ICS Schedule & Entry\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-7-1-2-2-2-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                        <span class=\"text-[11px] text-stone-500 font-mono\" data-kid=\"2-7-1-2-2-2-2\" data-name=\"evening weekend note\">\n                            Evening / Weekend\n                        </span>\n                    </div>\n                </div>\n                <!-- Pathway 3: Postgraduate Studies (PGD, M.Sc, Ph.D) -->\n                <div class=\"bg-stone-50 border border-stone-200 rounded-lg p-6 lg:p-7 flex flex-col justify-between hover:border-[#701500]/50 transition-colors\" data-kid=\"2-7-1-2-3\" data-name=\"postgraduate pathway card\">\n                    <div data-kid=\"2-7-1-2-3-1\" data-name=\"postgrad card content\">\n                        <div class=\"flex items-center justify-between pb-3 border-b border-stone-200\" data-kid=\"2-7-1-2-3-1-1\" data-name=\"postgrad card header row\">\n                            <span class=\"text-xs font-mono font-bold text-[#701500] uppercase tracking-wider\" data-kid=\"2-7-1-2-3-1-1-1\" data-name=\"advanced research label\">\n                                Advanced Research\n                            </span>\n                            <span class=\"px-2 py-0.5 bg-emerald-100 text-emerald-800 font-mono text-[11px] font-bold rounded\" data-kid=\"2-7-1-2-3-1-1-2\" data-name=\"postgrad school tag\">\n                                Postgraduate School\n                            </span>\n                        </div>\n                        <h3 class=\"text-2xl font-bold text-stone-900 mt-4\" data-kid=\"2-7-1-2-3-1-2\" data-name=\"postgrad heading\">\n                            Postgraduate Programmes\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mt-1\" data-kid=\"2-7-1-2-3-1-3\" data-name=\"postgrad subtitle\">\n                            Specialised academic and clinical research degrees\n                        </p>\n                        <!-- Duration & Route Breakdown -->\n                        <div class=\"mt-5 space-y-3 bg-white p-3.5 rounded border border-stone-200/80 text-xs\" data-kid=\"2-7-1-2-3-1-4\" data-name=\"postgrad duration breakdown panel\">\n                            <div class=\"flex justify-between items-center pb-2 border-b border-stone-100\" data-kid=\"2-7-1-2-3-1-4-1\" data-name=\"PGD row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-3-1-4-1-1\" data-name=\"PGD label\">\n                                    Postgraduate Diploma (PGD)\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-3-1-4-1-2\" data-name=\"PGD duration\">\n                                    12–18 Months\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between items-center pb-2 border-b border-stone-100\" data-kid=\"2-7-1-2-3-1-4-2\" data-name=\"M.Sc row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-3-1-4-2-1\" data-name=\"M.Sc label\">\n                                    Master of Science (M.Sc)\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-3-1-4-2-2\" data-name=\"M.Sc duration\">\n                                    18–24 Months\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between items-center\" data-kid=\"2-7-1-2-3-1-4-3\" data-name=\"Ph.D row\">\n                                <span class=\"text-stone-500 font-medium\" data-kid=\"2-7-1-2-3-1-4-3-1\" data-name=\"Ph.D label\">\n                                    Doctor of Philosophy (Ph.D)\n                                </span>\n                                <span class=\"font-bold text-stone-900\" data-kid=\"2-7-1-2-3-1-4-3-2\" data-name=\"Ph.D duration\">\n                                    36–48 Months\n                                </span>\n                            </div>\n                        </div>\n                        <!-- Key Modules Preview -->\n                        <div class=\"mt-5 text-xs text-stone-700\" data-kid=\"2-7-1-2-3-1-5\" data-name=\"research concentrations block\">\n                            <p class=\"font-bold text-stone-900 mb-2\" data-kid=\"2-7-1-2-3-1-5-1\" data-name=\"concentrations label\">\n                                Research Concentrations:\n                            </p>\n                            <ul class=\"space-y-1.5 text-stone-600\" data-kid=\"2-7-1-2-3-1-5-2\" data-name=\"concentration list\">\n                                <li data-kid=\"2-7-1-2-3-1-5-2-1\" data-name=\"clinical concentration item\">\n                                    • Clinical & Abnormal Psychology (Adult / Child)\n                                </li>\n                                <li data-kid=\"2-7-1-2-3-1-5-2-2\" data-name=\"IO concentration item\">\n                                    • Industrial & Organisational Psychology\n                                </li>\n                                <li data-kid=\"2-7-1-2-3-1-5-2-3\" data-name=\"social concentration item\">\n                                    • Social & Personality Dynamics\n                                </li>\n                                <li data-kid=\"2-7-1-2-3-1-5-2-4\" data-name=\"neuro concentration item\">\n                                    • Neuropsychology & Behavioural Medicine\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"mt-8 pt-4 border-t border-stone-200 flex items-center justify-between\" data-kid=\"2-7-1-2-3-2\" data-name=\"postgrad footer row\">\n                        <a class=\"text-xs font-bold text-[#701500] hover:underline flex items-center gap-1.5\" data-kid=\"2-7-1-2-3-2-1\" data-name=\"view postgraduate guidelines link\" href=\"programs.html#postgrad\">\n                            <span data-kid=\"2-7-1-2-3-2-1-1\" data-name=\"guidelines link label\">\n                                View Postgraduate Guidelines\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-7-1-2-3-2-1-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                        <span class=\"text-[11px] text-stone-500 font-mono\" data-kid=\"2-7-1-2-3-2-2\" data-name=\"thesis required note\">\n                            Thesis Required\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Action note on curriculum verification -->\n            <div class=\"mt-8 p-4 bg-stone-50 border border-stone-200 rounded flex flex-wrap items-center justify-between gap-4 text-xs text-stone-600\" data-kid=\"2-7-1-3\" data-name=\"accreditation and downloads notice\">\n                <div class=\"flex items-center gap-2\" data-kid=\"2-7-1-3-1\" data-name=\"NUC accreditation note\">\n                    <i class=\"fa-solid fa-circle-info text-[#701500]\" data-kid=\"2-7-1-3-1-1\" data-name=\"info circle icon\">\n                    </i>\n                    <span data-kid=\"2-7-1-3-1-2\" data-name=\"accreditation text\">\n                        All departmental degrees are fully accredited by the National Universities Commission (NUC).\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"2-7-1-3-2\" data-name=\"download and contact links\">\n                    <a class=\"font-bold text-[#701500] hover:underline\" data-kid=\"2-7-1-3-2-1\" data-name=\"programme handbook download link\" href=\"academics.html\">\n                        Download Programme Handbook (PDF)\n                    </a>\n                    <span data-kid=\"2-7-1-3-2-2\" data-name=\"separator dot\">\n                        ·\n                    </span>\n                    <a class=\"font-bold text-stone-800 hover:underline\" data-kid=\"2-7-1-3-2-3\" data-name=\"contact admissions link\" href=\"contact.html\">\n                        Contact Admissions Officer\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- 8. SECTION 05: TIMELY DEPARTMENTAL BULLETIN & RESEARCH SEMINARS -->\n    <section class=\"py-16 px-6 border-b border-stone-200 bg-[#FAF8F5]\" data-kid=\"2-8\" data-name=\"departmental bulletin section\" id=\"notices\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"2-8-1\" data-name=\"section content wrapper\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4 mb-10 pb-4 border-b border-stone-200\" data-kid=\"2-8-1-1\" data-name=\"bulletin header row\">\n                <div data-kid=\"2-8-1-1-1\" data-name=\"bulletin heading block\">\n                    <span class=\"font-mono text-xs font-bold uppercase text-[#701500] tracking-wider\" data-kid=\"2-8-1-1-1-1\"