nded\" data-kid=\"2-8-1-2-1-1-1-1\" data-name=\"seminar series tag\">\n                                Seminar Series\n                            </span>\n                            <span class=\"font-mono text-xs text-stone-500\" data-kid=\"2-8-1-2-1-1-1-2\" data-name=\"seminar date\">\n                                Oct 22, 2026\n                            </span>\n                        </div>\n                        <h3 class=\"text-lg font-bold text-stone-900 mt-3.5 leading-snug\" data-kid=\"2-8-1-2-1-1-2\" data-name=\"seminar title\">\n                            Departmental Seminar: Recent Advances in Psychological Science & Behavioural Research\n                        </h3>\n                        <p class=\"text-xs text-stone-600 mt-2.5 leading-relaxed\" data-kid=\"2-8-1-2-1-1-3\" data-name=\"seminar description\">\n                            Faculty presentation on empirical neurobiological frameworks and social cognitive intervention methods. Open to all students and staff.\n                        </p>\n                    </div>\n                    <div class=\"mt-6 pt-3 border-t border-stone-100 flex items-center justify-between text-xs\" data-kid=\"2-8-1-2-1-2\" data-name=\"seminar footer row\">\n                        <span class=\"text-stone-500\" data-kid=\"2-8-1-2-1-2-1\" data-name=\"seminar location\">\n                            <i class=\"fa-solid fa-location-dot text-[#701500] mr-1\" data-kid=\"2-8-1-2-1-2-1-1\" data-name=\"location pin icon\">\n                            </i>\n                            Faculty Lecture Hall 2\n                        </span>\n                        <a class=\"font-bold text-[#701500] hover:underline\" data-kid=\"2-8-1-2-1-2-2\" data-name=\"seminar details link\" href=\"news.html\">\n                            Details →\n                        </a>\n                    </div>\n                </article>\n                <!-- Bulletin 2: Orientation Programme -->\n                <article clas