      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,500;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@400;500&display=swap');\n\n  :root {\n    --esut-maroon: #701500;\n    --esut-maroon-dark: #4d0e00;\n    --esut-maroon-light: #8e1f06;\n    --esut-coral: #f67665;\n    --esut-sand: #fbf9f5;\n    --esut-stone: #f2eee8;\n    --esut-border: #e6dfd5;\n    --text-ink: #191614;\n    --text-muted: #615a52;\n  }\n\n  body {\n    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n    color: var(--text-ink);\n    background-color: #faf8f5;\n    margin: 0;\n    padding: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-serif {\n    font-family: 'Lora', Georgia, serif;\n  }\n\n  .font-mono {\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .academic-tab-btn.active {\n    color: var(--esut-maroon);\n    border-color: var(--esut-maroon);\n    background-color: white;\n    font-weight: 700;\n  }\n\n  .academic-tab-btn {\n    border-bottom: 2px solid transparent;\n    transition: all 0.2s ease;\n  }\n\n  .academic-tab-btn:hover:not(.active) {\n    color: var(--esut-maroon-light);\n    border-color: #d1c7bc;\n  }\n</style>\n<link data-kid=\"1\" data-name=\"Font Awesome stylesheet link\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#FAF8F5] text-[#191614] flex flex-col\" data-kid=\"2\" data-name=\"page layout container\">\n    <!-- Institutional Top Utility Bar -->\n    <aside aria-label=\"University Affiliation\" class=\"bg-[#4D0E00] text-[#E5DCD3] text-xs font-medium border-b border-[#3B0A00] py-2 px-6\" data-kid=\"2-1\" data-name=\"university affiliation top bar\">\n        <div class=\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"top bar content row\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"university and faculty identifier\">\n                <span class=\"tracking-wide uppercase font-semibold text-white/90\" data-kid=\"2-1-1-1-1\" data-name=\"university name label\">\n                    Enugu State University of Science and Technology\n                </span>\n                <span class=\"text-white/30 hidden sm:inline\" data-kid=\"2-1-1-1-2\" data-name=\"separator dot\">\n                    •\n                </span>\n                <span class=\"text-white/70 hidden sm:inline\" data-kid=\"2-1-1-1-3\" data-name=\"faculty name label\">\n                    Faculty of Social Sciences & Humanities\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5 text-white/80\" data-kid=\"2-1-1-2\" data-name=\"utility quick links\">\n                <a class=\"hover:text-white transition flex items-center gap-1.5\" data-kid=\"2-1-1-2-1\" data-name=\"exam timetable PDF download link\" download=\"\" href=\"exam-timetable.pdf\">\n                    <i class=\"fa-solid fa-file-pdf text-red-300\" data-kid=\"2-1-1-2-1-1\" data-name=\"PDF file icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-2-1-2\" data-name=\"exam timetable link label\">\n                        Exam Timetable (PDF)\n                    </span>\n                </a>\n                <a class=\"hover:text-white transition flex items-center gap-1.5\" data-kid=\"2-1-1-2-2\" data-name=\"course catalog link\" href=\"course-descriptions.html\">\n                    <i class=\"fa-solid fa-book-open text-amber-200\" data-kid=\"2-1-1-2-2-1\" data-name=\"open book icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-2-2-2\" data-name=\"course catalog link label\">\n                        Course Catalog\n                    </span>\n                </a>\n                <span class=\"text-white/30\" data-kid=\"2-1-1-2-3\" data-name=\"pipe separator\">\n                    |\n                </span>\n                <a class=\"hover:text-white transition\" data-kid=\"2-1-1-2-4\" data-name=\"staff directory link\" href=\"contact.html\">\n                    Staff Directory\n                </a>\n            </div>\n        </div>\n    </aside>\n    <!-- Primary Academic Masthead -->\n    <header class=\"bg-white border-b border-[#E6DFD5] sticky top-0 z-40 shadow-xs\" data-kid=\"2-2\" data-name=\"sticky site header\">\n        <div class=\"max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6\" data-kid=\"2-2-1\" data-name=\"header inner row\">\n            <!-- Brand & Identity -->\n            <a class=\"flex items-center gap-4 group text-decoration-none\" data-kid=\"2-2-1-1\" data-name=\"department brand and identity block\" href=\"index.html\">\n                <img alt=\"ESUT Crest\" class=\"w-14 h-14 object-contain rounded-md border border-[#E6DFD5] bg-white p-1 shadow-xs group-hover:border-[#701500] transition\" data-kid=\"2-2-1-1-1\" data-name=\"ESUT crest image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Enugu-State-University-of-Science-and-Technology-logo.jpg\"/>\n                <div data-kid=\"2-2-1-1-2\" data-name=\"brand text group\">\n                    <div class=\"text-[11px] font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-2-1-1-2-1\" data-name=\"department eyebrow label\">\n                        Department of Psychology\n                    </div>\n                    <h1 class=\"text-xl font-extrabold text-[#191614] tracking-tight group-hover:text-[#701500] transition\" data-kid=\"2-2-1-1-2-2\" data-name=\"portal main title\">\n                        ESUT Psychology Academic Portal\n                    </h1>\n                    <p class=\"text-xs text-[#615A52] font-normal\" data-kid=\"2-2-1-1-2-3\" data-name=\"campus location subtitle\">\n                        Agbani Campus, Enugu State, Nigeria\n                    </p>\n                </div>\n            </a>\n            <!-- Academic Navigation -->\n            <nav aria-label=\"Main Navigation\" class=\"hidden lg:flex items-center gap-1\" data-kid=\"2-2-1-2\" data-name=\"main academic navigation\">\n                <a class=\"px-3.5 py-2 rounded-md text-sm font-bold text-[#701500] bg-[#FAF5EE]\" data-kid=\"2-2-1-2-1\" data-name=\"home nav link (active)\" href=\"index.html\">\n                    Home\n                </a>\n                <a class=\"px-3.5 py-2 rounded-md text-sm font-medium text-[#443E38] hover:text-[#701500] hover:bg-[#FAF5EE] transition\" data-kid=\"2-2-1-2-2\" data-name=\"notice desk nav link\" href=\"#bulletin\">\n                    Notice Desk\n                </a>\n                <a class=\"px-3.5 py-2 rounded-md text-sm font-medium text-[#443E38] hover:text-[#701500] hover:bg-[#FAF5EE] transition\" data-kid=\"2-2-1-2-3\" data-name=\"degree routes nav link\" href=\"#pathways\">\n                    Degree Routes\n                </a>\n                <a class=\"px-3.5 py-2 rounded-md text-sm font-medium text-[#443E38] hover:text-[#701500] hover:bg-[#FAF5EE] transition\" data-kid=\"2-2-1-2-4\" data-name=\"prospectus and skills nav link\" href=\"#prospectus\">\n                    Prospectus & Skills\n                </a>\n                <a class=\"px-3.5 py-2 rounded-md text-sm font-medium text-[#443E38] hover:text-[#701500] hover:bg-[#FAF5EE] transition\" data-kid=\"2-2-1-2-5\" data-name=\"about faculty nav link\" href=\"about.html\">\n                    About Faculty\n                </a>\n                <a class=\"px-3.5 py-2 rounded-md text-sm font-medium text-[#443E38] hover:text-[#701500] hover:bg-[#FAF5EE] transition\" data-kid=\"2-2-1-2-6\" data-name=\"contact nav link\" href=\"contact.html\">\n                    Contact\n                </a>\n            </nav>\n            <!-- Action Button -->\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-3\" data-name=\"header action area\">\n                <a class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#701500] hover:bg-[#550F00] text-white text-xs font-bold tracking-wide transition shadow-xs\" data-kid=\"2-2-1-3-1\" data-name=\"apply enroll call-to-action button\" href=\"#pathways\">\n                    <span data-kid=\"2-2-1-3-1-1\" data-name=\"apply enroll button label\">\n                        Apply / Enroll\n                    </span>\n                    <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-2-1-3-1-2\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- Hero Section -->\n    <section class=\"border-b border-[#E6DFD5] bg-gradient-to-b from-[#FAF5EE] to-white relative overflow-hidden py-12 md:py-16\" data-kid=\"2-3\" data-name=\"hero section\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"2-3-1\" data-name=\"hero inner container\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"2-3-1-1\" data-name=\"hero two-column grid\">\n                <!-- Left: Academic Mission & Core Directives (7 cols) -->\n                <div class=\"lg:col-span-7 space-y-6\" data-kid=\"2-3-1-1-1\" data-name=\"hero left content column\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#E6DFD5] text-[#701500] text-xs font-semibold\" data-kid=\"2-3-1-1-1-1\" data-name=\"accreditation badge pill\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#701500]\" data-kid=\"2-3-1-1-1-1-1\" data-name=\"accent dot indicator\">\n                        </span>\n                        <span data-kid=\"2-3-1-1-1-1-2\" data-name=\"accreditation badge text\">\n                            Accredited Academic Programmes • 2026/2027 Academic Year\n                        </span>\n                    </div>\n                    <h2 class=\"text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-[#191614] leading-[1.18] tracking-tight\" data-kid=\"2-3-1-1-1-2\" data-name=\"hero headline\">\n                        Scientific Study of Behaviour, Cognition, and Societal Wellbeing.\n                    </h2>\n                    <p class=\"text-base sm:text-lg text-[#554E46] leading-relaxed max-w-2xl font-serif\" data-kid=\"2-3-1-1-1-3\" data-name=\"hero mission description\">\n                        The Department of Psychology at ESUT equips students to explain, predict, and systematically modify human and non-human behaviour. Through empirical laboratory research, clinical assessment, and community intervention, we prepare competent, ethical behavioural scientists.\n                    </p>\n                    <!-- Core Action Routes -->\n                    <div class=\"flex flex-wrap items-center gap-3 pt-2\" data-kid=\"2-3-1-1-1-4\" data-name=\"core action button row\">\n                        <a class=\"inline-flex items-center gap-2.5 px-6 py-3.5 rounded-lg bg-[#701500] hover:bg-[#4D0E00] text-white font-semibold text-sm transition shadow-sm\" data-kid=\"2-3-1-1-1-4-1\" data-name=\"find a degree route button\" href=\"#pathways\">\n                            <i class=\"fa-solid fa-graduation-cap\" data-kid=\"2-3-1-1-1-4-1-1\" data-name=\"graduation cap icon\">\n                            </i>\n                            <span data-kid=\"2-3-1-1-1-4-1-2\" data-name=\"find degree route button label\">\n                                Find a Degree Route\n                            </span>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2.5 px-5 py-3.5 rounded-lg bg-white hover:bg-[#FAF8F5] text-[#332E28] border border-[#D5CDC2] font-semibold text-sm transition\" data-kid=\"2-3-1-1-1-4-2\" data-name=\"open notice desk button\" href=\"#bulletin\">\n                            <i class=\"fa-solid fa-bullhorn text-[#701500]\" data-kid=\"2-3-1-1-1-4-2-1\" data-name=\"bullhorn icon\">\n                            </i>\n                            <span data-kid=\"2-3-1-1-1-4-2-2\" data-name=\"open notice desk label\">\n                                Open Notice Desk\n                            </span>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 px-4 py-3.5 text-xs font-bold text-[#701500] hover:underline\" data-kid=\"2-3-1-1-1-4-3\" data-name=\"view syllabus text link\" href=\"course-descriptions.html\">\n                            <span data-kid=\"2-3-1-1-1-4-3-1\" data-name=\"view syllabus link text\">\n                                View 100L – 400L Syllabus\n                            </span>\n                            <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-3-1-1-1-4-3-2\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <!-- Documented Key Department Facts -->\n                    <div class=\"pt-6 border-t border-[#E6DFD5]/80 grid grid-cols-3 gap-4 text-left\" data-kid=\"2-3-1-1-1-5\" data-name=\"department key facts grid\">\n                        <div data-kid=\"2-3-1-1-1-5-1\" data-name=\"degree levels fact block\">\n                            <div class=\"text-xl sm:text-2xl font-extrabold text-[#701500]\" data-kid=\"2-3-1-1-1-5-1-1\" data-name=\"degree levels fact value\">\n                                B.Sc, M.Sc, Ph.D\n                            </div>\n                            <div class=\"text-xs text-[#615A52] font-medium mt-0.5\" data-kid=\"2-3-1-1-1-5-1-2\" data-name=\"degree levels fact caption\">\n                                Undergraduate & Postgrad\n                            </div>\n                        </div>\n                        <div data-kid=\"2-3-1-1-1-5-2\" data-name=\"ICS option fact block\">\n                            <div class=\"text-xl sm:text-2xl font-extrabold text-[#701500]\" data-kid=\"2-3-1-1-1-5-2-1\" data-name=\"ICS option fact value\">\n                                ICS Option\n                            </div>\n                            <div class=\"text-xs text-[#615A52] font-medium mt-0.5\" data-kid=\"2-3-1-1-1-5-2-2\" data-name=\"ICS option fact caption\">\n                                Flexible Continuing Studies\n                            </div>\n                        </div>\n                        <div data-kid=\"2-3-1-1-1-5-3\" data-name=\"NUC verified fact block\">\n                            <div class=\"text-xl sm:text-2xl font-extrabold text-[#701500]\" data-kid=\"2-3-1-1-1-5-3-1\" data-name=\"NUC verified fact value\">\n                                NUC Verified\n                            </div>\n                            <div class=\"text-xs text-[#615A52] font-medium mt-0.5\" data-kid=\"2-3-1-1-1-5-3-2\" data-name=\"NUC verified fact caption\">\n                                Curriculum Benchmark\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Right: Authentic Leadership Welcome Excerpt (5 cols) -->\n                <div class=\"lg:col-span-5 bg-white border border-[#DCD5C9] rounded-xl p-6 sm:p-7 shadow-xs relative\" data-kid=\"2-3-1-1-2\" data-name=\"head of department leadership card\">\n                    <div class=\"flex items-center justify-between border-b border-[#EFE9DF] pb-4 mb-4\" data-kid=\"2-3-1-1-2-1\" data-name=\"leadership card header bar\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-3-1-1-2-1-1\" data-name=\"leader identity group\">\n                            <div class=\"w-10 h-10 rounded-full bg-[#FAF0E6] text-[#701500] flex items-center justify-center font-bold text-sm border border-[#EAD5C5]\" data-kid=\"2-3-1-1-2-1-1-1\" data-name=\"leader avatar placeholder circle\">\n                                <i class=\"fa-solid fa-user-tie\" data-kid=\"2-3-1-1-2-1-1-1-1\" data-name=\"user tie icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"2-3-1-1-2-1-1-2\" data-name=\"leader name and role block\">\n                                <h3 class=\"text-sm font-bold text-[#191614]\" data-kid=\"2-3-1-1-2-1-1-2-1\" data-name=\"leader name heading\">\n                                    Dr. Ada Okafor\n                                </h3>\n                                <p class=\"text-xs text-[#615A52]\" data-kid=\"2-3-1-1-2-1-1-2-2\" data-name=\"leader role subtitle\">\n                                    Head of Department • Department of Psychology\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"px-2.5 py-1 text-[11px] font-semibold bg-[#F5EDE2] text-[#701500] rounded-md\" data-kid=\"2-3-1-1-2-1-2\" data-name=\"leadership tag badge\">\n                            Leadership\n                        </span>\n                    </div>\n                    <blockquote class=\"font-serif italic text-sm text-[#443E38] leading-relaxed space-y-3\" data-kid=\"2-3-1-1-2-2\" data-name=\"leadership welcome quote block\">\n                        <p data-kid=\"2-3-1-1-2-2-1\" data-name=\"leadership welcome quote text\">\n                            “Welcome to our academic community. Our mission is to combine rigorous laboratory methodology with deep psychological inquiry into societal challenges. We train minds not only to evaluate behavioural patterns, but to build peace, strengthen institutional productivity, and deliver clinical care.”\n                        </p>\n                    </blockquote>\n                    <div class=\"mt-5 pt-4 border-t border-[#EFE9DF] flex items-center justify-between text-xs\" data-kid=\"2-3-1-1-2-3\" data-name=\"leadership card footer bar\">\n                        <div class=\"text-[#615A52]\" data-kid=\"2-3-1-1-2-3-1\" data-name=\"HOD email contact group\">\n                            <i class=\"fa-solid fa-envelope text-[#701500] mr-1.5\" data-kid=\"2-3-1-1-2-3-1-1\" data-name=\"envelope icon\">\n                            </i>\n                            <a class=\"font-mono text-[11px] text-[#701500] hover:underline\" data-kid=\"2-3-1-1-2-3-1-2\" data-name=\"HOD email mailto link\" href=\"mailto:hod.psychology@esut.edu.ng\">\n                                hod.psychology@esut.edu.ng\n                            </a>\n                        </div>\n                        <a class=\"font-semibold text-[#701500] hover:underline inline-flex items-center gap-1\" data-kid=\"2-3-1-1-2-3-2\" data-name=\"read full profile link\" href=\"about.html\">\n                            <span data-kid=\"2-3-1-1-2-3-2-1\" data-name=\"read full profile text\">\n                                Read full profile\n                            </span>\n                            <i class=\"fa-solid fa-chevron-right text-[9px]\" data-kid=\"2-3-1-1-2-3-2-2\" data-name=\"chevron right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Notice Desk & Timely Departmental Bulletin -->\n    <section class=\"py-12 bg-[#F6F2EB] border-b border-[#E6DFD5]\" data-kid=\"2-4\" data-name=\"academic notices section\" id=\"bulletin\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"2-4-1\" data-name=\"notices section inner container\">\n            <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8\" data-kid=\"2-4-1-1\" data-name=\"notices section header row\">\n                <div data-kid=\"2-4-1-1-1\" data-name=\"notices heading group\">\n                    <div class=\"text-xs font-bold uppercase tracking-wider text-[#701500] flex items-center gap-2\" data-kid=\"2-4-1-1-1-1\" data-name=\"bulletin status badge\">\n                        <span class=\"w-2 h-2 rounded-full bg-emerald-600 animate-pulse\" data-kid=\"2-4-1-1-1-1-1\" data-name=\"pulsing status dot\">\n                        </span>\n                        <span data-kid=\"2-4-1-1-1-1-2\" data-name=\"bulletin status text\">\n                            Current Academic Bulletin • Term Updates\n                        </span>\n                    </div>\n                    <h2 class=\"text-2xl sm:text-3xl font-bold text-[#191614] mt-1 tracking-tight\" data-kid=\"2-4-1-1-1-2\" data-name=\"notices section headline\">\n                        Academic Notices & Departmental Events\n                    </h2>\n                    <p class=\"text-sm text-[#615A52] mt-1\" data-kid=\"2-4-1-1-1-3\" data-name=\"notices section description\">\n                        Confirmed seminar series, examination schedules, and verified faculty notices.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"2-4-1-1-2\" data-name=\"notices section actions\">\n                    <a class=\"inline-flex items-center gap-2 text-xs font-bold text-[#701500] bg-white border border-[#D5CDC2] px-3.5 py-2 rounded-md hover:bg-[#FAF5EE] transition\" data-kid=\"2-4-1-1-2-1\" data-name=\"all notices archive link\" href=\"news.html\">\n                        <span data-kid=\"2-4-1-1-2-1-1\" data-name=\"all notices label\">\n                            Archive & All Notices\n                        </span>\n                        <i class=\"fa-solid fa-arrow-up-right-from-square text-[10px]\" data-kid=\"2-4-1-1-2-1-2\" data-name=\"external link icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\" data-kid=\"2-4-1-2\" data-name=\"notices two-column grid\">\n                <!-- Left: Verified Notices and Seminar Feed (7 cols) -->\n                <div class=\"lg:col-span-7 space-y-4\" data-kid=\"2-4-1-2-1\" data-name=\"notices feed column\">\n                    <!-- Lead Confirmed Event Card -->\n                    <article class=\"bg-white border-2 border-[#701500] rounded-xl p-5 sm:p-6 shadow-xs relative\" data-kid=\"2-4-1-2-1-1\" data-name=\"lead research event card\">\n                        <div class=\"flex items-center justify-between gap-2 mb-3\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"lead event meta row\">\n                            <span class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#701500] text-white\" data-kid=\"2-4-1-2-1-1-1-1\" data-name=\"lead research event badge\">\n                                <i class=\"fa-solid fa-star text-[9px]\" data-kid=\"2-4-1-2-1-1-1-1-1\" data-name=\"star icon\">\n                                </i>\n                                <span data-kid=\"2-4-1-2-1-1-1-1-2\" data-name=\"lead event badge text\">\n                                    Lead Research Event\n                                </span>\n                            </span>\n                            <time class=\"text-xs font-semibold text-[#701500] font-mono\" data-kid=\"2-4-1-2-1-1-1-2\" data-name=\"event date time\" datetime=\"2026-11-10\">\n                                November 10, 2026\n                            </time>\n                        </div>\n                        <h3 class=\"text-lg sm:text-xl font-bold text-[#191614] hover:text-[#701500] transition\" data-kid=\"2-4-1-2-1-1-2\" data-name=\"lead event headline\">\n                            <a data-kid=\"2-4-1-2-1-1-2-1\" data-name=\"lead event title link\" href=\"news.html\">\n                                Faculty Research Workshop: Academic Writing & Behavioural Research Methodology\n                            </a>\n                        </h3>\n                        <p class=\"text-sm text-[#554E46] mt-2 leading-relaxed font-serif\" data-kid=\"2-4-1-2-1-1-3\" data-name=\"lead event description\">\n                            An intensive departmental workshop designed for undergraduate finalists, postgraduate candidates, and academic staff, focusing on empirical data collection, statistical tools in psychological testing, and peer-reviewed publishing standards.\n                        </p>\n                        <div class=\"mt-4 pt-4 border-t border-[#F0EAE1] flex flex-wrap items-center justify-between gap-3 text-xs text-[#615A52]\" data-kid=\"2-4-1-2-1-1-4\" data-name=\"lead event details footer\">\n                            <div class=\"flex items-center gap-4\" data-kid=\"2-4-1-2-1-1-4-1\" data-name=\"event location and time group\">\n                                <span data-kid=\"2-4-1-2-1-1-4-1-1\" data-name=\"event location span\">\n                                    <i class=\"fa-solid fa-location-dot text-[#701500] mr-1\" data-kid=\"2-4-1-2-1-1-4-1-1-1\" data-name=\"location pin icon\">\n                                    </i>\n                                    Faculty Auditorium, Agbani\n                                </span>\n                                <span data-kid=\"2-4-1-2-1-1-4-1-2\" data-name=\"event time span\">\n                                    <i class=\"fa-solid fa-clock text-[#701500] mr-1\" data-kid=\"2-4-1-2-1-1-4-1-2-1\" data-name=\"clock icon\">\n                                    </i>\n                                    10:00 AM WAT\n                                </span>\n                            </div>\n                            <a class=\"font-bold text-[#701500] hover:underline inline-flex items-center gap-1\" data-kid=\"2-4-1-2-1-1-4-2\" data-name=\"registration details link\" href=\"news.html\">\n                                <span data-kid=\"2-4-1-2-1-1-4-2-1\" data-name=\"registration details text\">\n                                    Registration details\n                                </span>\n                                <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-4-1-2-1-1-4-2-2\" data-name=\"right arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </article>\n                    <!-- List of Chronological Notices -->\n                    <div class=\"bg-white border border-[#E6DFD5] rounded-xl divide-y divide-[#EFE9DF] overflow-hidden\" data-kid=\"2-4-1-2-1-2\" data-name=\"chronological notices list\">\n                        <article class=\"p-4 sm:p-5 hover:bg-[#FAF8F5] transition flex items-start gap-4\" data-kid=\"2-4-1-2-1-2-1\" data-name=\"orientation notice item\">\n                            <div class=\"w-12 sm:w-14 text-center shrink-0 bg-[#FAF0E6] border border-[#EAD5C5] rounded-lg p-1.5 text-[#701500]\" data-kid=\"2-4-1-2-1-2-1-1\" data-name=\"notice item date badge\">\n                                <span class=\"block text-base sm:text-lg font-extrabold leading-none\" data-kid=\"2-4-1-2-1-2-1-1-1\" data-name=\"notice item day number\">\n                                    15\n                                </span>\n                                <span class=\"block text-[10px] uppercase font-bold tracking-wider mt-0.5\" data-kid=\"2-4-1-2-1-2-1-1-2\" data-name=\"notice item month\">\n                                    Oct\n                                </span>\n                            </div>\n                            <div class=\"flex-1 min-w-0\" data-kid=\"2-4-1-2-1-2-1-2\" data-name=\"orientation notice content\">\n                                <div class=\"flex items-center gap-2 mb-1\" data-kid=\"2-4-1-2-1-2-1-2-1\" data-name=\"orientation category row\">\n                                    <span class=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-[#F0E8DC] text-[#4D0E00]\" data-kid=\"2-4-1-2-1-2-1-2-1-1\" data-name=\"orientation category tag\">\n                                        Orientation\n                                    </span>\n                                    <span class=\"text-xs text-[#8A8177]\" data-kid=\"2-4-1-2-1-2-1-2-1-2\" data-name=\"orientation term text\">\n                                        • Academic 2026/2027\n                                    </span>\n                                </div>\n                                <h4 class=\"text-sm sm:text-base font-bold text-[#191614] truncate hover:text-[#701500] transition\" data-kid=\"2-4-1-2-1-2-1-2-2\" data-name=\"orientation notice title\">\n                                    <a data-kid=\"2-4-1-2-1-2-1-2-2-1\" data-name=\"orientation title link\" href=\"news.html\">\n                                        Orientation Programme for Newly Admitted Students (UTME & Direct Entry)\n                                    </a>\n                                </h4>\n                                <p class=\"text-xs sm:text-sm text-[#615A52] mt-1 line-clamp-2\" data-kid=\"2-4-1-2-1-2-1-2-3\" data-name=\"orientation notice excerpt\">\n                                    Official induction ceremony, course advisor assignments, and departmental orientation scheduled for all newly enrolled psychology freshmen.\n                                </p>\n                            </div>\n                        </article>\n                        <article class=\"p-4 sm:p-5 hover:bg-[#FAF8F5] transition flex items-start gap-4\" data-kid=\"2-4-1-2-1-2-2\" data-name=\"seminar notice item\">\n                            <div class=\"w-12 sm:w-14 text-center shrink-0 bg-[#FAF0E6] border border-[#EAD5C5] rounded-lg p-1.5 text-[#701500]\" data-kid=\"2-4-1-2-1-2-2-1\" data-name=\"seminar notice date badge\">\n                                <span class=\"block text-base sm:text-lg font-extrabold leading-none\" data-kid=\"2-4-1-2-1-2-2-1-1\" data-name=\"seminar day number\">\n                                    22\n                                </span>\n                                <span class=\"block text-[10px] uppercase font-bold tracking-wider mt-0.5\" data-kid=\"2-4-1-2-1-2-2-1-2\" data-name=\"seminar month\">\n                                    Oct\n                                </span>\n                            </div>\n                            <div class=\"flex-1 min-w-0\" data-kid=\"2-4-1-2-1-2-2-2\" data-name=\"seminar notice content\">\n                                <div class=\"flex items-center gap-2 mb-1\" data-kid=\"2-4-1-2-1-2-2-2-1\" data-name=\"seminar category row\">\n                                    <span class=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-[#F0E8DC] text-[#4D0E00]\" data-kid=\"2-4-1-2-1-2-2-2-1-1\" data-name=\"seminar category tag\">\n                                        Seminar\n                                    </span>\n                                    <span class=\"text-xs text-[#8A8177]\" data-kid=\"2-4-1-2-1-2-2-2-1-2\" data-name=\"seminar series text\">\n                                        • Departmental Series\n                                    </span>\n                                </div>\n                                <h4 class=\"text-sm sm:text-base font-bold text-[#191614] truncate hover:text-[#701500] transition\" data-kid=\"2-4-1-2-1-2-2-2-2\" data-name=\"seminar notice title\">\n                                    <a data-kid=\"2-4-1-2-1-2-2-2-2-1\" data-name=\"seminar title link\" href=\"news.html\">\n                                        Departmental Seminar: Advances in Cognitive Assessment & Psychometrics\n                                    </a>\n                                </h4>\n                                <p class=\"text-xs sm:text-sm text-[#615A52] mt-1 line-clamp-2\" data-kid=\"2-4-1-2-1-2-2-2-3\" data-name=\"seminar notice excerpt\">\n                                    Paper presentations exploring contemporary psychometric test standardization in Nigerian sociocultural contexts.\n                                </p>\n                            </div>\n                        </article>\n                        <article class=\"p-4 sm:p-5 hover:bg-[#FAF8F5] transition flex items-start gap-4\" data-kid=\"2-4-1-2-1-2-3\" data-name=\"examination notice item\">\n                            <div class=\"w-12 sm:w-14 text-center shrink-0 bg-[#FAF0E6] border border-[#EAD5C5] rounded-lg p-1.5 text-[#701500]\" data-kid=\"2-4-1-2-1-2-3-1\" data-name=\"examination notice date badge\">\n                                <span class=\"block text-base sm:text-lg font-extrabold leading-none\" data-kid=\"2-4-1-2-1-2-3-1-1\" data-name=\"examination day number\">\n                                    04\n                                </span>\n                                <span class=\"block text-[10px] uppercase font-bold tracking-wider mt-0.5\" data-kid=\"2-4-1-2-1-2-3-1-2\" data-name=\"examination month\">\n                                    Nov\n                                </span>\n                            </div>\n                            <div class=\"flex-1 min-w-0\" data-kid=\"2-4-1-2-1-2-3-2\" data-name=\"examination notice content\">\n                                <div class=\"flex items-center gap-2 mb-1\" data-kid=\"2-4-1-2-1-2-3-2-1\" data-name=\"examination category row\">\n                                    <span class=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-[#F0E8DC] text-[#4D0E00]\" data-kid=\"2-4-1-2-1-2-3-2-1-1\" data-name=\"examination category tag\">\n                                        Examination\n                                    </span>\n                                    <span class=\"text-xs text-[#8A8177]\" data-kid=\"2-4-1-2-1-2-3-2-1-2\" data-name=\"faculty timetable text\">\n                                        • Faculty Timetable\n                                    </span>\n                                </div>\n                                <h4 class=\"text-sm sm:text-base font-bold text-[#191614] truncate hover:text-[#701500] transition\" data-kid=\"2-4-1-2-1-2-3-2-2\" data-name=\"examination notice title\">\n                                    <a data-kid=\"2-4-1-2-1-2-3-2-2-1\" data-name=\"examination title link\" href=\"exam-timetable.pdf\">\n                                        Finalized Semester Examination Timetable & Venue Allocations\n                                    </a>\n                                </h4>\n                                <p class=\"text-xs sm:text-sm text-[#615A52] mt-1 line-clamp-2\" data-kid=\"2-4-1-2-1-2-3-2-3\" data-name=\"examination notice excerpt\">\n                                    Official venue scheduling, invigilation duty rosters, and student accreditation requirements now available for download.\n                                </p>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n                <!-- Right: Persistent Student Utilities (5 cols) -->\n                <div class=\"lg:col-span-5 space-y-4\" data-kid=\"2-4-1-2-2\" data-name=\"student utilities column\">\n                    <div class=\"bg-white border border-[#E6DFD5] rounded-xl p-5 sm:p-6 shadow-xs\" data-kid=\"2-4-1-2-2-1\" data-name=\"student academic utilities card\">\n                        <div class=\"flex items-center gap-2 mb-4\" data-kid=\"2-4-1-2-2-1-1\" data-name=\"utilities card header\">\n                            <i class=\"fa-solid fa-folder-open text-[#701500]\" data-kid=\"2-4-1-2-2-1-1-1\" data-name=\"open folder icon\">\n                            </i>\n                            <h3 class=\"text-base font-bold text-[#191614]\" data-kid=\"2-4-1-2-2-1-1-2\" data-name=\"utilities card title\">\n                                Student Academic Utilities\n                            </h3>\n                        </div>\n                        <p class=\"text-xs text-[#615A52] mb-4\" data-kid=\"2-4-1-2-2-1-2\" data-name=\"utilities card description\">\n                            Direct access to verified course materials, syllabi, academic forms, and departmental resources:\n                        </p>\n                        <ul class=\"divide-y divide-[#EFE9DF] text-sm\" data-kid=\"2-4-1-2-2-1-3\" data-name=\"utility links list\">\n                            <li class=\"py-3 flex items-center justify-between hover:text-[#701500]\" data-kid=\"2-4-1-2-2-1-3-1\" data-name=\"exam timetable utility item\">\n                                <a class=\"flex items-center gap-3 text-inherit group font-medium\" data-kid=\"2-4-1-2-2-1-3-1-1\" data-name=\"exam timetable utility link\" download=\"\" href=\"exam-timetable.pdf\">\n                                    <span class=\"w-8 h-8 rounded bg-[#F8EFE4] text-[#701500] flex items-center justify-center text-xs group-hover:bg-[#701500] group-hover:text-white transition\" data-kid=\"2-4-1-2-2-1-3-1-1-1\" data-name=\"PDF file icon container\">\n                                        <i class=\"fa-solid fa-file-pdf\" data-kid=\"2-4-1-2-2-1-3-1-1-1-1\" data-name=\"PDF file icon\">\n                                        </i>\n                                    </span>\n                                    <span data-kid=\"2-4-1-2-2-1-3-1-1-2\" data-name=\"exam timetable utility label\">\n                                        Semester Exam Timetable\n                                    </span>\n                                </a>\n                                <span class=\"text-xs text-[#701500] font-semibold bg-[#FAF5EE] px-2 py-0.5 rounded\" data-kid=\"2-4-1-2-2-1-3-1-2\" data-name=\"PDF format tag\">\n                                    PDF\n                                </span>\n                            </li>\n                            <li class=\"py-3 flex items-center justify-between hover:text-[#701500]\" data-kid=\"2-4-1-2-2-1-3-2\" data-name=\"course descriptions utility item\">\n                                <a class=\"flex items-center gap-3 text-inherit group font-medium\" data-kid=\"2-4-1-2-2-1-3-2-1\" data-name=\"course descriptions utility link\" href=\"course-descriptions.html\">\n                                    <span class=\"w-8 h-8 rounded bg-[#F8EFE4] text-[#701500] flex items-center justify-center text-xs group-hover:bg-[#701500] group-hover:text-white transition\" data-kid=\"2-4-1-2-2-1-3-2-1-1\" data-name=\"checklist icon container\">\n                                        <i class=\"fa-solid fa-list-check\" data-kid=\"2-4-1-2-2-1-3-2-1-1-1\" data-name=\"checklist icon\">\n                                        </i>\n                                    </span>\n                                    <span data-kid=\"2-4-1-2-2-1-3-2-1-2\" data-name=\"course descriptions utility label\">\n                                        Course Descriptions (100L – 400L)\n                                    </span>\n                                </a>\n                                <i class=\"fa-solid fa-chevron-right text-xs text-[#B5ABA0]\" data-kid=\"2-4-1-2-2-1-3-2-2\" data-name=\"chevron right icon\">\n                                </i>\n                            </li>\n                            <li class=\"py-3 flex items-center justify-between hover:text-[#701500]\" data-kid=\"2-4-1-2-2-1-3-3\" data-name=\"curriculum utility item\">\n                                <a class=\"flex items-center gap-3 text-inherit group font-medium\" data-kid=\"2-4-1-2-2-1-3-3-1\" data-name=\"curriculum utility link\" href=\"academics.html\">\n                                    <span class=\"w-8 h-8 rounded bg-[#F8EFE4] text-[#701500] flex items-center justify-center text-xs group-hover:bg-[#701500] group-hover:text-white transition\" data-kid=\"2-4-1-2-2-1-3-3-1-1\" data-name=\"calendar check icon container\">\n                                        <i class=\"fa-solid fa-calendar-check\" data-kid=\"2-4-1-2-2-1-3-3-1-1-1\" data-name=\"calendar check icon\">\n                                        </i>\n                                    </span>\n                                    <span data-kid=\"2-4-1-2-2-1-3-3-1-2\" data-name=\"curriculum utility label\">\n                                        Curriculum & Credit Requirements\n                                    </span>\n                                </a>\n                                <i class=\"fa-solid fa-chevron-right text-xs text-[#B5ABA0]\" data-kid=\"2-4-1-2-2-1-3-3-2\" data-name=\"chevron right icon\">\n                                </i>\n                            </li>\n                            <li class=\"py-3 flex items-center justify-between hover:text-[#701500]\" data-kid=\"2-4-1-2-2-1-3-4\" data-name=\"ICS guide utility item\">\n                                <a class=\"flex items-center gap-3 text-inherit group font-medium\" data-kid=\"2-4-1-2-2-1-3-4-1\" data-name=\"ICS guide utility link\" href=\"programs.html\">\n                                    <span class=\"w-8 h-8 rounded bg-[#F8EFE4] text-[#701500] flex items-center justify-center text-xs group-hover:bg-[#701500] group-hover:text-white transition\" data-kid=\"2-4-1-2-2-1-3-4-1-1\" data-name=\"clock history icon container\">\n                                        <i class=\"fa-solid fa-clock-rotate-left\" data-kid=\"2-4-1-2-2-1-3-4-1-1-1\" data-name=\"clock history icon\">\n                                        </i>\n                                    </span>\n                                    <span data-kid=\"2-4-1-2-2-1-3-4-1-2\" data-name=\"ICS guide utility label\">\n                                        ICS Continuing Studies Guide\n                                    </span>\n                                </a>\n                                <i class=\"fa-solid fa-chevron-right text-xs text-[#B5ABA0]\" data-kid=\"2-4-1-2-2-1-3-4-2\" data-name=\"chevron right icon\">\n                                </i>\n                            </li>\n                            <li class=\"py-3 flex items-center justify-between hover:text-[#701500]\" data-kid=\"2-4-1-2-2-1-3-5\" data-name=\"staff profiles utility item\">\n                                <a class=\"flex items-center gap-3 text-inherit group font-medium\" data-kid=\"2-4-1-2-2-1-3-5-1\" data-name=\"staff profiles utility link\" href=\"staff.html\">\n                                    <span class=\"w-8 h-8 rounded bg-[#F8EFE4] text-[#701500] flex items-center justify-center text-xs group-hover:bg-[#701500] group-hover:text-white transition\" data-kid=\"2-4-1-2-2-1-3-5-1-1\" data-name=\"users icon container\">\n                                        <i class=\"fa-solid fa-users-line\" data-kid=\"2-4-1-2-2-1-3-5-1-1-1\" data-name=\"users line icon\">\n                                        </i>\n                                    </span>\n                                    <span data-kid=\"2-4-1-2-2-1-3-5-1-2\" data-name=\"staff profiles utility label\">\n                                        Academic Staff & Research Profiles\n                                    </span>\n                                </a>\n                                <i class=\"fa-solid fa-chevron-right text-xs text-[#B5ABA0]\" data-kid=\"2-4-1-2-2-1-3-5-2\" data-name=\"chevron right icon\">\n                                </i>\n                            </li>\n                        </ul>\n                    </div>\n                    <!-- Academic Advisory Callout -->\n                    <div class=\"bg-[#FAF5EE] border border-[#E4D7C8] rounded-xl p-4 sm:p-5 flex items-start gap-3.5\" data-kid=\"2-4-1-2-2-2\" data-name=\"academic advisory callout\">\n                        <div class=\"w-8 h-8 rounded-full bg-[#701500] text-white flex items-center justify-center text-xs shrink-0 mt-0.5\" data-kid=\"2-4-1-2-2-2-1\" data-name=\"question mark icon circle\">\n                            <i class=\"fa-solid fa-circle-question\" data-kid=\"2-4-1-2-2-2-1-1\" data-name=\"question circle icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"2-4-1-2-2-2-2\" data-name=\"advisory callout content\">\n                            <h4 class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-4-1-2-2-2-2-1\" data-name=\"advisory callout heading\">\n                                Academic Advisory & Support\n                            </h4>\n                            <p class=\"text-xs text-[#554E46] mt-1 leading-relaxed\" data-kid=\"2-4-1-2-2-2-2-2\" data-name=\"advisory callout description\">\n                                Need guidance on course registration, waiver requests, or clinical practicum placements? Contact the Departmental Officer or your designated level advisor.\n                            </p>\n                            <a class=\"inline-block mt-2 text-xs font-bold text-[#701500] hover:underline\" data-kid=\"2-4-1-2-2-2-2-3\" data-name=\"contact advisory desk link\" href=\"contact.html\">\n                                Contact Advisory Desk →\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Academic Pathways Matrix (Interactive Degree Route Explorer) -->\n    <section class=\"py-16 bg-white border-b border-[#E6DFD5]\" data-kid=\"2-5\" data-name=\"academic pathways section\" id=\"pathways\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"2-5-1\" data-name=\"pathways inner container\">\n            <div class=\"max-w-3xl mb-10\" data-kid=\"2-5-1-1\" data-name=\"pathways intro header\">\n                <div class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-5-1-1-1\" data-name=\"pathways eyebrow label\">\n                    Academic Pathways\n                </div>\n                <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#191614] mt-1 tracking-tight\" data-kid=\"2-5-1-1-2\" data-name=\"pathways section headline\">\n                    Choose Your Degree Qualification Route\n                </h2>\n                <p class=\"text-sm sm:text-base text-[#615A52] mt-2 font-serif\" data-kid=\"2-5-1-1-3\" data-name=\"pathways section description\">\n                    The Department provides three tailored degree paths designed for secondary school leavers, working professionals, and advanced scholars. Select a pathway to inspect duration, structure, and entry parameters.\n                </p>\n            </div>\n            <!-- Tab Switcher -->\n            <div class=\"border-b border-[#E6DFD5] flex gap-2 sm:gap-6 overflow-x-auto no-scrollbar mb-8\" data-dynamic=\"true\" data-kid=\"2-5-1-2\" data-name=\"degree pathway tab switcher\" data-reason=\"tab active/hidden states are toggled by switchPathway script on click; tab button and badge class text/color changes are driven by the script state\">\n                <button class=\"academic-tab-btn active px-4 py-3 text-sm font-semibold whitespace-nowrap cursor-pointer flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-5-1-2-1\" data-name=\"undergraduate pathway tab button\" data-reason=\"'active' class toggled by switchPathway script on click, changing its border/bold CSS per .academic-tab-btn.active rule\" id=\"tab-btn-ug\" onclick=\"switchPathway('ug')\">\n                    <span class=\"w-5 h-5 rounded-full bg-[#FAF0E6] text-[#701500] text-xs font-bold flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"2-5-1-2-1-1\" data-name=\"undergraduate tab number badge\" data-reason=\"bg/text color classes removed and added by switchPathway script on click\">\n                        1\n                    </span>\n                    <span data-kid=\"2-5-1-2-1-2\" data-name=\"undergraduate tab label\">\n                        Undergraduate (B.Sc)\n                    </span>\n                </button>\n                <button class=\"academic-tab-btn px-4 py-3 text-sm font-medium text-[#615A52] whitespace-nowrap cursor-pointer flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-5-1-2-2\" data-name=\"ICS pathway tab button\" data-reason=\"'active' class toggled by switchPathway script on click\" id=\"tab-btn-ics\" onclick=\"switchPathway('ics')\">\n                    <span class=\"w-5 h-5 rounded-full bg-[#EFEBE4] text-[#615A52] text-xs font-bold flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"2-5-1-2-2-1\" data-name=\"ICS tab number badge\" data-reason=\"bg/text color classes removed and added by switchPathway script on click\">\n                        2\n                    </span>\n                    <span data-kid=\"2-5-1-2-2-2\" data-name=\"ICS tab label\">\n                        Continuing Studies (ICS)\n                    </span>\n                </button>\n                <button class=\"academic-tab-btn px-4 py-3 text-sm font-medium text-[#615A52] whitespace-nowrap cursor-pointer flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-5-1-2-3\" data-name=\"postgraduate pathway tab button\" data-reason=\"'active' class toggled by switchPathway script on click\" id=\"tab-btn-pg\" onclick=\"switchPathway('pg')\">\n                    <span class=\"w-5 h-5 rounded-full bg-[#EFEBE4] text-[#615A52] text-xs font-bold flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"2-5-1-2-3-1\" data-name=\"PG tab number badge\" data-reason=\"bg/text color classes removed and added by switchPathway script on click\">\n                        3\n                    </span>\n                    <span data-kid=\"2-5-1-2-3-2\" data-name=\"PG tab label\">\n                        Postgraduate (PGD, M.Sc, Ph.D)\n                    </span>\n                </button>\n            </div>\n            <!-- Tab Content 1: Undergraduate (B.Sc) -->\n            <div class=\"space-y-6\" data-dynamic=\"true\" data-kid=\"2-5-1-3\" data-name=\"undergraduate pathway panel\" data-reason=\"'hidden' class toggled by switchPathway script on tab click\" id=\"pathway-panel-ug\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start bg-[#FAF8F5] border border-[#E6DFD5] rounded-xl p-6 sm:p-8\" data-kid=\"2-5-1-3-1\" data-name=\"undergraduate pathway card\">\n                    <div class=\"lg:col-span-8 space-y-4\" data-kid=\"2-5-1-3-1-1\" data-name=\"undergraduate pathway detail column\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"2-5-1-3-1-1-1\" data-name=\"undergraduate award and mode tags\">\n                            <span class=\"px-2.5 py-1 text-xs font-bold bg-[#701500] text-white rounded\" data-kid=\"2-5-1-3-1-1-1-1\" data-name=\"undergraduate award tag\">\n                                Award: Bachelor of Science (B.Sc Hons)\n                            </span>\n                            <span class=\"text-xs text-[#701500] font-semibold bg-white border border-[#E6DFD5] px-2.5 py-1 rounded\" data-kid=\"2-5-1-3-1-1-1-2\" data-name=\"undergraduate mode tag\">\n                                Full-Time On-Campus\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl sm:text-2xl font-bold text-[#191614]\" data-kid=\"2-5-1-3-1-1-2\" data-name=\"undergraduate pathway headline\">\n                            Comprehensive Foundation in Human & Behavioural Sciences\n                        </h3>\n                        <p class=\"text-sm text-[#554E46] leading-relaxed font-serif\" data-kid=\"2-5-1-3-1-1-3\" data-name=\"undergraduate description\">\n                            Our B.Sc programme delivers foundational and advanced mastery in psychological theory, statistical methods, physiological psychology, psychometric testing, experimental psychology, and clinical counseling. Students complete mandatory independent empirical research projects and institutional practicums.\n                        </p>\n                        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3\" data-kid=\"2-5-1-3-1-1-4\" data-name=\"undergraduate entry route cards grid\">\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-4\" data-kid=\"2-5-1-3-1-1-4-1\" data-name=\"UTME route card\">\n                                <div class=\"text-xs font-bold uppercase tracking-wider text-[#701500] mb-1\" data-kid=\"2-5-1-3-1-1-4-1-1\" data-name=\"UTME route label\">\n                                    Standard UTME Route\n                                </div>\n                                <div class=\"text-base font-bold text-[#191614]\" data-kid=\"2-5-1-3-1-1-4-1-2\" data-name=\"UTME route duration\">\n                                    4 Academic Years (100L – 400L)\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-3-1-1-4-1-3\" data-name=\"UTME route requirements\">\n                                    Five O'Level credits including English Language, Biology, and Mathematics in not more than two sittings.\n                                </p>\n                            </div>\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-4\" data-kid=\"2-5-1-3-1-1-4-2\" data-name=\"direct entry route card\">\n                                <div class=\"text-xs font-bold uppercase tracking-wider text-[#701500] mb-1\" data-kid=\"2-5-1-3-1-1-4-2-1\" data-name=\"direct entry route label\">\n                                    Direct Entry (DE) Route\n                                </div>\n                                <div class=\"text-base font-bold text-[#191614]\" data-kid=\"2-5-1-3-1-1-4-2-2\" data-name=\"direct entry route duration\">\n                                    3 Academic Years (200L – 400L)\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-3-1-1-4-2-3\" data-name=\"direct entry route requirements\">\n                                    Relevant Diploma, IJMB, or Advanced Level passes in Social Sciences or Biological subjects.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex flex-wrap items-center gap-3 pt-3\" data-kid=\"2-5-1-3-1-1-5\" data-name=\"undergraduate call-to-action row\">\n                            <a class=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#701500] hover:bg-[#550F00] text-white text-xs font-bold rounded-lg transition\" data-kid=\"2-5-1-3-1-1-5-1\" data-name=\"view curriculum button\" href=\"programs.html\">\n                                <span data-kid=\"2-5-1-3-1-1-5-1-1\" data-name=\"view curriculum label\">\n                                    View Full Curriculum & Admission Guide\n                                </span>\n                                <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-5-1-3-1-1-5-1-2\" data-name=\"right arrow icon\">\n                                </i>\n                            </a>\n                            <a class=\"inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-[#D5CDC2] text-[#443E38] hover:text-[#701500] text-xs font-semibold rounded-lg transition\" data-kid=\"2-5-1-3-1-1-5-2\" data-name=\"inspect course codes button\" href=\"course-descriptions.html\">\n                                <span data-kid=\"2-5-1-3-1-1-5-2-1\" data-name=\"inspect course codes label\">\n                                    Inspect PSY Course Codes\n                                </span>\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-4 bg-white border border-[#E6DFD5] rounded-lg p-5 space-y-4\" data-kid=\"2-5-1-3-1-2\" data-name=\"undergraduate curriculum highlights card\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-5-1-3-1-2-1\" data-name=\"curriculum highlights heading\">\n                            Curriculum Highlights\n                        </h4>\n                        <ul class=\"text-xs space-y-2.5 text-[#554E46]\" data-kid=\"2-5-1-3-1-2-2\" data-name=\"curriculum highlights course list\">\n                            <li class=\"flex items-start gap-2\" data-kid=\"2-5-1-3-1-2-2-1\" data-name=\"PSY101 course item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 mt-0.5\" data-kid=\"2-5-1-3-1-2-2-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-3-1-2-2-1-2\" data-name=\"PSY101 course text\">\n                                    PSY 101: Introduction to General Psychology\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"2-5-1-3-1-2-2-2\" data-name=\"PSY201 course item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 mt-0.5\" data-kid=\"2-5-1-3-1-2-2-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-3-1-2-2-2-2\" data-name=\"PSY201 course text\">\n                                    PSY 201: Physiological Basis of Human Behaviour\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"2-5-1-3-1-2-2-3\" data-name=\"PSY305 course item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 mt-0.5\" data-kid=\"2-5-1-3-1-2-2-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-3-1-2-2-3-2\" data-name=\"PSY305 course text\">\n                                    PSY 305: Psychometric Testing & Test Construction\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"2-5-1-3-1-2-2-4\" data-name=\"PSY401 course item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 mt-0.5\" data-kid=\"2-5-1-3-1-2-2-4-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-3-1-2-2-4-2\" data-name=\"PSY401 course text\">\n                                    PSY 401: Clinical Assessment & Psychotherapy\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-2\" data-kid=\"2-5-1-3-1-2-2-5\" data-name=\"PSY499 course item\">\n                                <i class=\"fa-solid fa-check text-emerald-600 mt-0.5\" data-kid=\"2-5-1-3-1-2-2-5-1\" data-name=\"checkmark icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-3-1-2-2-5-2\" data-name=\"PSY499 course text\">\n                                    PSY 499: Final Year Empirical Research Project\n                                </span>\n                            </li>\n                        </ul>\n                        <div class=\"pt-3 border-t border-[#EFE9DF] text-[11px] text-[#8A8177]\" data-kid=\"2-5-1-3-1-2-3\" data-name=\"NUC compliance note\">\n                            Verified compliant with National Universities Commission (NUC) Core Curriculum & Minimum Academic Standards.\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Tab Content 2: ICS Continuing Studies -->\n            <div class=\"hidden space-y-6\" data-dynamic=\"true\" data-kid=\"2-5-1-4\" data-name=\"ICS pathway panel\" data-reason=\"'hidden' class toggled by switchPathway script on tab click\" id=\"pathway-panel-ics\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start bg-[#FAF8F5] border border-[#E6DFD5] rounded-xl p-6 sm:p-8\" data-kid=\"2-5-1-4-1\" data-name=\"ICS pathway card\">\n                    <div class=\"lg:col-span-8 space-y-4\" data-kid=\"2-5-1-4-1-1\" data-name=\"ICS pathway detail column\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"2-5-1-4-1-1-1\" data-name=\"ICS award and mode tags\">\n                            <span class=\"px-2.5 py-1 text-xs font-bold bg-[#701500] text-white rounded\" data-kid=\"2-5-1-4-1-1-1-1\" data-name=\"ICS award tag\">\n                                Institute of Continuing Studies (ICS)\n                            </span>\n                            <span class=\"text-xs text-[#701500] font-semibold bg-white border border-[#E6DFD5] px-2.5 py-1 rounded\" data-kid=\"2-5-1-4-1-1-1-2\" data-name=\"ICS mode tag\">\n                                Evening & Weekend Access\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl sm:text-2xl font-bold text-[#191614]\" data-kid=\"2-5-1-4-1-1-2\" data-name=\"ICS pathway headline\">\n                            Flexible Professional Degree Study for Working Adults\n                        </h3>\n                        <p class=\"text-sm text-[#554E46] leading-relaxed font-serif\" data-kid=\"2-5-1-4-1-1-3\" data-name=\"ICS description\">\n                            Designed for candidates in public administration, health agencies, corporate enterprise, and community leadership seeking formal university qualifications without interrupting ongoing professional careers.\n                        </p>\n                        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3\" data-kid=\"2-5-1-4-1-1-4\" data-name=\"ICS track cards grid\">\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-3.5\" data-kid=\"2-5-1-4-1-1-4-1\" data-name=\"3-year ICS track card\">\n                                <div class=\"text-[11px] font-bold text-[#701500]\" data-kid=\"2-5-1-4-1-1-4-1-1\" data-name=\"3-year track name\">\n                                    3-Year Track\n                                </div>\n                                <div class=\"text-sm font-bold text-[#191614] mt-0.5\" data-kid=\"2-5-1-4-1-1-4-1-2\" data-name=\"3-year track level\">\n                                    Advanced Placement\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-4-1-1-4-1-3\" data-name=\"3-year track eligibility\">\n                                    For holders of recognized relevant HND or Bachelor degrees.\n                                </p>\n                            </div>\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-3.5\" data-kid=\"2-5-1-4-1-1-4-2\" data-name=\"4-year ICS track card\">\n                                <div class=\"text-[11px] font-bold text-[#701500]\" data-kid=\"2-5-1-4-1-1-4-2-1\" data-name=\"4-year track name\">\n                                    4-Year Track\n                                </div>\n                                <div class=\"text-sm font-bold text-[#191614] mt-0.5\" data-kid=\"2-5-1-4-1-1-4-2-2\" data-name=\"4-year track level\">\n                                    Intermediate Entry\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-4-1-1-4-2-3\" data-name=\"4-year track eligibility\">\n                                    For ND, NCE, or professional diploma graduates.\n                                </p>\n                            </div>\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-3.5\" data-kid=\"2-5-1-4-1-1-4-3\" data-name=\"5-year ICS track card\">\n                                <div class=\"text-[11px] font-bold text-[#701500]\" data-kid=\"2-5-1-4-1-1-4-3-1\" data-name=\"5-year track name\">\n                                    5-Year Track\n                                </div>\n                                <div class=\"text-sm font-bold text-[#191614] mt-0.5\" data-kid=\"2-5-1-4-1-1-4-3-2\" data-name=\"5-year track level\">\n                                    Standard ICS\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-4-1-1-4-3-3\" data-name=\"5-year track eligibility\">\n                                    For O'Level certificate holders seeking evening study.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3 pt-3\" data-kid=\"2-5-1-4-1-1-5\" data-name=\"ICS call-to-action row\">\n                            <a class=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#701500] hover:bg-[#550F00] text-white text-xs font-bold rounded-lg transition\" data-kid=\"2-5-1-4-1-1-5-1\" data-name=\"view ICS admission button\" href=\"programs.html\">\n                                <span data-kid=\"2-5-1-4-1-1-5-1-1\" data-name=\"view ICS admission label\">\n                                    View ICS Admission Procedures\n                                </span>\n                                <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-5-1-4-1-1-5-1-2\" data-name=\"right arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-4 bg-white border border-[#E6DFD5] rounded-lg p-5 space-y-3\" data-kid=\"2-5-1-4-1-2\" data-name=\"ICS features sidebar card\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-5-1-4-1-2-1\" data-name=\"ICS features heading\">\n                            Key Program Features\n                        </h4>\n                        <p class=\"text-xs text-[#554E46] leading-relaxed\" data-kid=\"2-5-1-4-1-2-2\" data-name=\"ICS features description\">\n                            Lectures scheduled on designated weekday evenings and Saturdays. Same high-standard curriculum, examinations, and final B.Sc degree award as full-time regular students.\n                        </p>\n                        <div class=\"p-3 bg-[#FAF5EE] rounded text-xs text-[#701500] font-medium border border-[#E6DFD5]\" data-kid=\"2-5-1-4-1-2-3\" data-name=\"ICS coordinator contact note\">\n                            Contact ICS Coordinator via the Department Office for current application session deadlines.\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Tab Content 3: Postgraduate -->\n            <div class=\"hidden space-y-6\" data-dynamic=\"true\" data-kid=\"2-5-1-5\" data-name=\"postgraduate pathway panel\" data-reason=\"'hidden' class toggled by switchPathway script on tab click\" id=\"pathway-panel-pg\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start bg-[#FAF8F5] border border-[#E6DFD5] rounded-xl p-6 sm:p-8\" data-kid=\"2-5-1-5-1\" data-name=\"postgraduate pathway card\">\n                    <div class=\"lg:col-span-8 space-y-4\" data-kid=\"2-5-1-5-1-1\" data-name=\"postgraduate detail column\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"2-5-1-5-1-1-1\" data-name=\"PG award and level tags\">\n                            <span class=\"px-2.5 py-1 text-xs font-bold bg-[#701500] text-white rounded\" data-kid=\"2-5-1-5-1-1-1-1\" data-name=\"PG award tag\">\n                                Postgraduate School\n                            </span>\n                            <span class=\"text-xs text-[#701500] font-semibold bg-white border border-[#E6DFD5] px-2.5 py-1 rounded\" data-kid=\"2-5-1-5-1-1-1-2\" data-name=\"PG level tag\">\n                                PGD • M.Sc • Ph.D\n                            </span>\n                        </div>\n                        <h3 class=\"text-xl sm:text-2xl font-bold text-[#191614]\" data-kid=\"2-5-1-5-1-1-2\" data-name=\"postgraduate headline\">\n                            Advanced Academic & Professional Specialisations\n                        </h3>\n                        <p class=\"text-sm text-[#554E46] leading-relaxed font-serif\" data-kid=\"2-5-1-5-1-1-3\" data-name=\"postgraduate description\">\n                            Postgraduate programmes at ESUT prepare scholars and senior practitioners through advanced coursework, supervised fieldwork, and original doctoral dissertation research.\n                        </p>\n                        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3\" data-kid=\"2-5-1-5-1-1-4\" data-name=\"PG qualification cards grid\">\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-3.5\" data-kid=\"2-5-1-5-1-1-4-1\" data-name=\"PGD card\">\n                                <div class=\"text-[11px] font-bold text-[#701500]\" data-kid=\"2-5-1-5-1-1-4-1-1\" data-name=\"PGD code label\">\n                                    PGD\n                                </div>\n                                <div class=\"text-sm font-bold text-[#191614] mt-0.5\" data-kid=\"2-5-1-5-1-1-4-1-2\" data-name=\"PGD full name\">\n                                    Postgraduate Diploma\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-5-1-1-4-1-3\" data-name=\"PGD description\">\n                                    Bridging programme for graduates in adjacent disciplines.\n                                </p>\n                            </div>\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-3.5\" data-kid=\"2-5-1-5-1-1-4-2\" data-name=\"M.Sc card\">\n                                <div class=\"text-[11px] font-bold text-[#701500]\" data-kid=\"2-5-1-5-1-1-4-2-1\" data-name=\"MSc code label\">\n                                    M.Sc\n                                </div>\n                                <div class=\"text-sm font-bold text-[#191614] mt-0.5\" data-kid=\"2-5-1-5-1-1-4-2-2\" data-name=\"MSc full name\">\n                                    Master of Science\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-5-1-1-4-2-3\" data-name=\"MSc description\">\n                                    Specialized research degree with thesis submission.\n                                </p>\n                            </div>\n                            <div class=\"bg-white border border-[#E6DFD5] rounded-lg p-3.5\" data-kid=\"2-5-1-5-1-1-4-3\" data-name=\"Ph.D card\">\n                                <div class=\"text-[11px] font-bold text-[#701500]\" data-kid=\"2-5-1-5-1-1-4-3-1\" data-name=\"PhD code label\">\n                                    Ph.D\n                                </div>\n                                <div class=\"text-sm font-bold text-[#191614] mt-0.5\" data-kid=\"2-5-1-5-1-1-4-3-2\" data-name=\"PhD full name\">\n                                    Doctor of Philosophy\n                                </div>\n                                <p class=\"text-xs text-[#615A52] mt-1\" data-kid=\"2-5-1-5-1-1-4-3-3\" data-name=\"PhD description\">\n                                    Original doctoral scholarship contributing to psychological theory.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3 pt-3\" data-kid=\"2-5-1-5-1-1-5\" data-name=\"Postgraduate call-to-action row\">\n                            <a class=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#701500] hover:bg-[#550F00] text-white text-xs font-bold rounded-lg transition\" data-kid=\"2-5-1-5-1-1-5-1\" data-name=\"inspect PG regulations button\" href=\"programs.html\">\n                                <span data-kid=\"2-5-1-5-1-1-5-1-1\" data-name=\"inspect PG regulations label\">\n                                    Inspect Postgraduate Regulations\n                                </span>\n                                <i class=\"fa-solid fa-arrow-right text-[10px]\" data-kid=\"2-5-1-5-1-1-5-1-2\" data-name=\"right arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-4 bg-white border border-[#E6DFD5] rounded-lg p-5 space-y-3\" data-kid=\"2-5-1-5-1-2\" data-name=\"specialisation fields card\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-5-1-5-1-2-1\" data-name=\"specialisation fields heading\">\n                            Specialisation Fields\n                        </h4>\n                        <ul class=\"text-xs space-y-2 text-[#554E46]\" data-kid=\"2-5-1-5-1-2-2\" data-name=\"specialisation list\">\n                            <li class=\"flex items-center gap-2\" data-kid=\"2-5-1-5-1-2-2-1\" data-name=\"clinical psychology field item\">\n                                <i class=\"fa-solid fa-chevron-right text-[10px] text-[#701500]\" data-kid=\"2-5-1-5-1-2-2-1-1\" data-name=\"chevron right icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-5-1-2-2-1-2\" data-name=\"clinical psychology text\">\n                                    Clinical & Health Psychology\n                                </span>\n                            </li>\n                            <li class=\"flex items-center gap-2\" data-kid=\"2-5-1-5-1-2-2-2\" data-name=\"organizational psychology field item\">\n                                <i class=\"fa-solid fa-chevron-right text-[10px] text-[#701500]\" data-kid=\"2-5-1-5-1-2-2-2-1\" data-name=\"chevron right icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-5-1-2-2-2-2\" data-name=\"organizational psychology text\">\n                                    Industrial & Organisational Psychology\n                                </span>\n                            </li>\n                            <li class=\"flex items-center gap-2\" data-kid=\"2-5-1-5-1-2-2-3\" data-name=\"social psychology field item\">\n                                <i class=\"fa-solid fa-chevron-right text-[10px] text-[#701500]\" data-kid=\"2-5-1-5-1-2-2-3-1\" data-name=\"chevron right icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-5-1-2-2-3-2\" data-name=\"social psychology text\">\n                                    Social Psychology & Cultural Dynamics\n                                </span>\n                            </li>\n                            <li class=\"flex items-center gap-2\" data-kid=\"2-5-1-5-1-2-2-4\" data-name=\"neurobiological field item\">\n                                <i class=\"fa-solid fa-chevron-right text-[10px] text-[#701500]\" data-kid=\"2-5-1-5-1-2-2-4-1\" data-name=\"chevron right icon\">\n                                </i>\n                                <span data-kid=\"2-5-1-5-1-2-2-4-2\" data-name=\"neurobiological text\">\n                                    Neurobiological & Behavioural Medicine\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Curated Academic Prospectus -->\n    <section class=\"py-16 bg-[#FAF8F5] border-b border-[#E6DFD5]\" data-kid=\"2-6\" data-name=\"prospectus section\" id=\"prospectus\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"2-6-1\" data-name=\"prospectus inner container\">\n            <div class=\"max-w-3xl mb-12\" data-kid=\"2-6-1-1\" data-name=\"prospectus intro header\">\n                <div class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-6-1-1-1\" data-name=\"prospectus eyebrow label\">\n                    Academic Prospectus\n                </div>\n                <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#191614] mt-1 tracking-tight\" data-kid=\"2-6-1-1-2\" data-name=\"prospectus section headline\">\n                    What Psychology Studies & What You Will Practise\n                </h2>\n                <p class=\"text-sm sm:text-base text-[#615A52] mt-2 font-serif\" data-kid=\"2-6-1-1-3\" data-name=\"prospectus section description\">\n                    Organized reference of our educational philosophy, core scientific foundations, and the 21st-century competencies developed across the curriculum.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"2-6-1-2\" data-name=\"prospectus two-column grid\">\n                <!-- Left Column: Discipline Context & Philosophy (5 cols) -->\n                <div class=\"lg:col-span-5 space-y-6\" data-kid=\"2-6-1-2-1\" data-name=\"prospectus left column\">\n                    <div class=\"bg-white border border-[#E6DFD5] rounded-xl p-6 shadow-xs\" data-kid=\"2-6-1-2-1-1\" data-name=\"scientific scope card\">\n                        <h3 class=\"text-base font-bold text-[#191614] flex items-center gap-2 mb-3\" data-kid=\"2-6-1-2-1-1-1\" data-name=\"scientific scope heading\">\n                            <i class=\"fa-solid fa-brain text-[#701500]\" data-kid=\"2-6-1-2-1-1-1-1\" data-name=\"brain icon\">\n                            </i>\n                            <span data-kid=\"2-6-1-2-1-1-1-2\" data-name=\"scientific scope heading text\">\n                                Discipline & Scientific Scope\n                            </span>\n                        </h3>\n                        <p class=\"text-xs sm:text-sm text-[#554E46] leading-relaxed font-serif\" data-kid=\"2-6-1-2-1-1-2\" data-name=\"scientific scope description\">\n                            Psychology at ESUT studies human and non-human behaviour from its physiological foundations to complex social influence processes. By equipping students with scientific skills to explain, predict, and systematically modify behaviours, the discipline fosters lasting peace, clinical stability, and institutional productivity.\n                        </p>\n                    </div>\n                    <div class=\"bg-white border border-[#E6DFD5] rounded-xl p-6 shadow-xs\" data-kid=\"2-6-1-2-1-2\" data-name=\"curriculum philosophy card\">\n                        <h3 class=\"text-base font-bold text-[#191614] flex items-center gap-2 mb-3\" data-kid=\"2-6-1-2-1-2-1\" data-name=\"curriculum philosophy heading\">\n                            <i class=\"fa-solid fa-compass text-[#701500]\" data-kid=\"2-6-1-2-1-2-1-1\" data-name=\"compass icon\">\n                            </i>\n                            <span data-kid=\"2-6-1-2-1-2-1-2\" data-name=\"curriculum philosophy heading text\">\n                                Curriculum Philosophy\n                            </span>\n                        </h3>\n                        <p class=\"text-xs sm:text-sm text-[#554E46] leading-relaxed font-serif\" data-kid=\"2-6-1-2-1-2-2\" data-name=\"curriculum philosophy description\">\n                            Our curriculum is grounded in discovering empirical patterns of behaviour in varied cultural and organisational settings. We equip students with principles that drive constructive change, interpersonal harmony, and national socioeconomic development in Nigeria and beyond.\n                        </p>\n                    </div>\n                    <div class=\"p-5 rounded-xl bg-[#FAF5EE] border border-[#E4D7C8]\" data-kid=\"2-6-1-2-1-3\" data-name=\"employment sectors callout\">\n                        <h4 class=\"text-xs font-bold uppercase tracking-wider text-[#701500]\" data-kid=\"2-6-1-2-1-3-1\" data-name=\"employment sectors heading\">\n                            Graduate Employment Sectors\n                        </h4>\n                        <p class=\"text-xs text-[#554E46] mt-2 leading-relaxed\" data-kid=\"2-6-1-2-1-3-2\" data-name=\"employment sectors description\">\n                            Graduates of this programme actively practice in healthcare and psychiatric institutions, secondary and tertiary education, non-governmental organisations (NGOs), civil security agencies, corporate human resources, and self-directed clinical consultancy.\n                        </p>\n                    </div>\n                </div>\n                <!-- Right Column: Structured Capability Matrix (7 cols) -->\n                <div class=\"lg:col-span-7 bg-white border border-[#E6DFD5] rounded-xl p-6 sm:p-7 shadow-xs\" data-kid=\"2-6-1-2-2\" data-name=\"competency framework matrix card\">\n                    <div class=\"flex items-center justify-between border-b border-[#EFE9DF] pb-4 mb-5\" data-kid=\"2-6-1-2-2-1\" data-name=\"competency matrix header\">\n                        <div data-kid=\"2-6-1-2-2-1-1\" data-name=\"competency matrix title group\">\n                            <h3 class=\"text-base font-bold text-[#191614]\" data-kid=\"2-6-1-2-2-1-1-1\" data-name=\"competency framework title\">\n                                Psychological Competency Framework\n                            </h3>\n                            <p class=\"text-xs text-[#615A52]\" data-kid=\"2-6-1-2-2-1-1-2\" data-name=\"competency framework subtitle\">\n                                Concrete analytical, empirical, and intervention skills taught across course levels\n                            </p>\n                        </div>\n                        <span class=\"text-xs font-mono font-bold text-[#701500] bg-[#FAF0E6] px-2.5 py-1 rounded\" data-kid=\"2-6-1-2-2-1-2\" data-name=\"21st century skills tag\">\n                            21st-Century Skills\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5\" data-kid=\"2-6-1-2-2-2\" data-name=\"competency matrix grid\">\n                        <div class=\"p-4 rounded-lg bg-[#FAF8F5] border border-[#E6DFD5]\" data-kid=\"2-6-1-2-2-2-1\" data-name=\"psychometrics competency card\">\n                            <div class=\"flex items-center gap-2 mb-2 text-[#701500]\" data-kid=\"2-6-1-2-2-2-1-1\" data-name=\"psychometrics card header\">\n                                <i class=\"fa-solid fa-chart-line text-sm\" data-kid=\"2-6-1-2-2-2-1-1-1\" data-name=\"line chart icon\">\n                                </i>\n                                <h4 class=\"text-xs font-bold uppercase tracking-wider\" data-kid=\"2-6-1-2-2-2-1-1-2\" data-name=\"psychometrics card title\">\n                                    Psychometrics & Testing\n                                </h4>\n                            </div>\n                            <ul class=\"text-xs text-[#554E46] space-y-1.5\" data-kid=\"2-6-1-2-2-2-1-2\" data-name=\"psychometrics skill list\">\n                                <li data-kid=\"2-6-1-2-2-2-1-2-1\" data-name=\"psychometrics skill item\">\n                                    • Psychological test construction & item validation\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-1-2-2\" data-name=\"psychometrics skill item\">\n                                    • Standardized diagnostic administration & scoring\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-1-2-3\" data-name=\"psychometrics skill item\">\n                                    • Clinical and organizational test interpretation\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-1-2-4\" data-name=\"psychometrics skill item\">\n                                    • Psychometric software and hardware mastery\n                                </li>\n                            </ul>\n                        </div>\n                        <div class=\"p-4 rounded-lg bg-[#FAF8F5] border border-[#E6DFD5]\" data-kid=\"2-6-1-2-2-2-2\" data-name=\"research data science card\">\n                            <div class=\"flex items-center gap-2 mb-2 text-[#701500]\" data-kid=\"2-6-1-2-2-2-2-1\" data-name=\"research card header\">\n                                <i class=\"fa-solid fa-flask text-sm\" data-kid=\"2-6-1-2-2-2-2-1-1\" data-name=\"flask icon\">\n                                </i>\n                                <h4 class=\"text-xs font-bold uppercase tracking-wider\" data-kid=\"2-6-1-2-2-2-2-1-2\" data-name=\"research card title\">\n                                    Research & Data Science\n                                </h4>\n                            </div>\n                            <ul class=\"text-xs text-[#554E46] space-y-1.5\" data-kid=\"2-6-1-2-2-2-2-2\" data-name=\"research skill list\">\n                                <li data-kid=\"2-6-1-2-2-2-2-2-1\" data-name=\"research skill item\">\n                                    • Experimental and observational study design\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-2-2-2\" data-name=\"research skill item\">\n                                    • Quantitative data collection and sampling\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-2-2-3\" data-name=\"research skill item\">\n                                    • Statistical inference and hypothesis testing\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-2-2-4\" data-name=\"research skill item\">\n                                    • Peer-reviewed scientific report writing\n                                </li>\n                            </ul>\n                        </div>\n                        <div class=\"p-4 rounded-lg bg-[#FAF8F5] border border-[#E6DFD5]\" data-kid=\"2-6-1-2-2-2-3\" data-name=\"intervention wellbeing card\">\n                            <div class=\"flex items-center gap-2 mb-2 text-[#701500]\" data-kid=\"2-6-1-2-2-2-3-1\" data-name=\"intervention card header\">\n                                <i class=\"fa-solid fa-hand-holding-heart text-sm\" data-kid=\"2-6-1-2-2-2-3-1-1\" data-name=\"hand holding heart icon\">\n                                </i>\n                                <h4 class=\"text-xs font-bold uppercase tracking-wider\" data-kid=\"2-6-1-2-2-2-3-1-2\" data-name=\"intervention card title\">\n                                    Intervention & Wellbeing\n                                </h4>\n                            </div>\n                            <ul class=\"text-xs text-[#554E46] space-y-1.5\" data-kid=\"2-6-1-2-2-2-3-2\" data-name=\"intervention skill list\">\n                                <li data-kid=\"2-6-1-2-2-2-3-2-1\" data-name=\"intervention skill item\">\n                                    • Psychological adjustment & life counseling\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-3-2-2\" data-name=\"intervention skill item\">\n                                    • Trauma management & crisis mitigation\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-3-2-3\" data-name=\"intervention skill item\">\n                                    • Peace building & conflict mediation\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-3-2-4\" data-name=\"intervention skill item\">\n                                    • Pro-ecological & environmental conservation habits\n                                </li>\n                            </ul>\n                        </div>\n                        <div class=\"p-4 rounded-lg bg-[#FAF8F5] border border-[#E6DFD5]\" data-kid=\"2-6-1-2-2-2-4\" data-name=\"organizational forensic card\">\n                            <div class=\"flex items-center gap-2 mb-2 text-[#701500]\" data-kid=\"2-6-1-2-2-2-4-1\" data-name=\"organizational card header\">\n                                <i class=\"fa-solid fa-briefcase text-sm\" data-kid=\"2-6-1-2-2-2-4-1-1\" data-name=\"briefcase icon\">\n                                </i>\n                                <h4 class=\"text-xs font-bold uppercase tracking-wider\" data-kid=\"2-6-1-2-2-2-4-1-2\" data-name=\"organizational card title\">\n                                    Organisational & Forensic\n                                </h4>\n                            </div>\n                            <ul class=\"text-xs text-[#554E46] space-y-1.5\" data-kid=\"2-6-1-2-2-2-4-2\" data-name=\"organizational skill list\">\n                                <li data-kid=\"2-6-1-2-2-2-4-2-1\" data-name=\"organizational skill item\">\n                                    • Talent recruitment & leadership training\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-4-2-2\" data-name=\"organizational skill item\">\n                                    • Forensic psychological advisory in justice systems\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-4-2-3\" data-name=\"organizational skill item\">\n                                    • Sports psychological counseling & performance\n                                </li>\n                                <li data-kid=\"2-6-1-2-2-2-4-2-4\" data-name=\"organizational skill item\">\n                                    • Public policy development & government advisory\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 pt-4 border-t border-[#EFE9DF] flex items-center justify-between text-xs text-[#615A52]\" data-kid=\"2-6-1-2-2-3\" data-name=\"competency matrix footer\">\n                        <span data-kid=\"2-6-1-2-2-3-1\" data-name=\"competency matrix footer note\">\n                            Complete syllabus references available in course catalogs\n                        </span>\n                        <a class=\"font-bold text-[#701500] hover:underline flex items-center gap-1\" data-kid=\"2-6-1-2-2-3-2\" data-name=\"view curriculum tables link\" href=\"academics.html\">\n                            <span data-kid=\"2-6-1-2-2-3-2-1\" data-name=\"view curriculum tables text\">\n                                View Course Curriculum Tables\n                            </span>\n                            <i class=\"fa-solid fa-chevron-right text-[10px]\" data-kid=\"2-6-1-2-2-3-2-2\" data-name=\"chevron right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Institutional Footer -->\n    <footer class=\"bg-[#2D0900] text-[#D1C5B8] border-t-4 border-[#701500] py-12 px-6\" data-kid=\"2-7\" data-name=\"institutional footer\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 mb-10 text-xs\" data-kid=\"2-7-1\" data-name=\"footer main grid\">\n            <div class=\"md:col-span-5 space-y-3\" data-kid=\"2-7-1-1\" data-name=\"footer identity column\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-7-1-1-1\" data-name=\"footer brand block\">\n                    <img alt=\"ESUT Logo\" class=\"w-10 h-10 object-contain rounded bg-white p-1\" data-kid=\"2-7-1-1-1-1\" data-name=\"ESUT footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Enugu-State-University-of-Science-and-Technology-logo.jpg\"/>\n                    <div data-kid=\"2-7-1-1-1-2\" data-name=\"footer brand text\">\n                        <div class=\"font-bold text-white text-sm\" data-kid=\"2-7-1-1-1-2-1\" data-name=\"footer department name\">\n                            Department of Psychology\n                        </div>\n                        <div class=\"text-[#A89C8F]\" data-kid=\"2-7-1-1-1-2-2\" data-name=\"footer university name\">\n                            Enugu State University of Science and Technology\n                        </div>\n                    </div>\n                </div>\n                <p class=\"text-[#A89C8F] leading-relaxed\" data-kid=\"2-7-1-1-2\" data-name=\"footer campus address\">\n                    Permanent Campus, Agbani, Enugu State, Nigeria.\n                    <br data-kid=\"2-7-1-1-2-1\" data-name=\"line break separator\"/>\n                    Faculty of Social Sciences & Humanities.\n                </p>\n                <p class=\"text-[#A89C8F]\" data-kid=\"2-7-1-1-3\" data-name=\"footer contact email block\">\n                    Email:\n                    <a class=\"text-white hover:underline\" data-kid=\"2-7-1-1-3-1\" data-name=\"department email mailto link\" href=\"mailto:psychology@esut.edu.ng\">\n                        psychology@esut.edu.ng\n                    </a>\n                    | HOD:\n                    <a class=\"text-white hover:underline\" data-kid=\"2-7-1-1-3-2\" data-name=\"HOD email mailto link\" href=\"mailto:hod.psychology@esut.edu.ng\">\n                        hod.psychology@esut.edu.ng\n                    </a>\n                </p>\n            </div>\n            <div class=\"md:col-span-3 space-y-2\" data-kid=\"2-7-1-2\" data-name=\"footer programmes column\">\n                <div class=\"font-bold uppercase tracking-wider text-white text-[11px] mb-2\" data-kid=\"2-7-1-2-1\" data-name=\"programmes column heading\">\n                    Programmes & Syllabi\n                </div>\n                <ul class=\"space-y-1.5 text-[#B8ACA0]\" data-kid=\"2-7-1-2-2\" data-name=\"programmes link list\">\n                    <li data-kid=\"2-7-1-2-2-1\" data-name=\"undergraduate programme link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-2-2-1-1\" data-name=\"undergraduate programme link\" href=\"programs.html\">\n                            Undergraduate (B.Sc)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-2-2-2\" data-name=\"ICS programme link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-2-2-2-1\" data-name=\"ICS programme link\" href=\"programs.html\">\n                            Continuing Studies (ICS)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-2-2-3\" data-name=\"postgraduate programme link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-2-2-3-1\" data-name=\"postgraduate programme link\" href=\"programs.html\">\n                            Postgraduate (PGD, M.Sc, Ph.D)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-2-2-4\" data-name=\"course descriptions link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-2-2-4-1\" data-name=\"course descriptions link\" href=\"course-descriptions.html\">\n                            Course Descriptions (100L–400L)\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-2-2-5\" data-name=\"examination timetable link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-2-2-5-1\" data-name=\"examination timetable link\" href=\"exam-timetable.pdf\">\n                            Examination Timetable\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"md:col-span-4 space-y-2\" data-kid=\"2-7-1-3\" data-name=\"footer academic links column\">\n                <div class=\"font-bold uppercase tracking-wider text-white text-[11px] mb-2\" data-kid=\"2-7-1-3-1\" data-name=\"academic links column heading\">\n                    Academic & Student Links\n                </div>\n                <ul class=\"space-y-1.5 text-[#B8ACA0]\" data-kid=\"2-7-1-3-2\" data-name=\"academic links list\">\n                    <li data-kid=\"2-7-1-3-2-1\" data-name=\"notices link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-3-2-1-1\" data-name=\"notices link\" href=\"news.html\">\n                            Departmental Notices & Seminars\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-3-2-2\" data-name=\"staff directory link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-3-2-2-1\" data-name=\"staff directory link\" href=\"staff.html\">\n                            Staff Directory & Office Hours\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-3-2-3\" data-name=\"history link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-3-2-3-1\" data-name=\"history link\" href=\"about.html\">\n                            Department History & Accreditation\n                        </a>\n                    </li>\n                    <li data-kid=\"2-7-1-3-2-4\" data-name=\"location map link item\">\n                        <a class=\"hover:text-white transition\" data-kid=\"2-7-1-3-2-4-1\" data-name=\"location map link\" href=\"contact.html\">\n                            Location Map & General Enquiries\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto pt-6 border-t border-[#441104] flex flex-wrap items-center justify-between gap-3 text-[11px] text-[#8F8174]\" data-kid=\"2-7-2\" data-name=\"footer bottom bar\">\n            <div data-kid=\"2-7-2-1\" data-name=\"footer copyright text\">\n                © 2026 Department of Psychology, Enugu State University of Science and Technology (ESUT). All Rights Reserved.\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"2-7-2-2\" data-name=\"footer bottom identifiers\">\n                <span data-kid=\"2-7-2-2-1\" data-name=\"campus location identifier\">\n                    Agbani Main Campus\n                </span>\n                <span data-kid=\"2-7-2-2-2\" data-name=\"separator dot\">\n                    •\n                </span>\n                <span data-kid=\"2-7-2-2-3\" data-name=\"faculty identifier\">\n                    Faculty of Social Sciences\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    function switchPathway(pathwayId) {\n    const tabs = ['ug', 'ics', 'pg'];\n    tabs.forEach(id => {\n      const panel = document.getElementById('pathway-panel-' + id);\n      const btn = document.getElementById('tab-btn-' + id);\n      if (id === pathwayId) {\n        if (panel) panel.classList.remove('hidden');\n        if (btn) {\n          btn.classList.add('active');\n          btn.classList.remove('text-[#615A52]');\n          btn.classList.add('text-[#701500]');\n          const badge = btn.querySelector('span:first-child');\n          if (badge) {\n            badge.classList.remove('bg-[#EFEBE4]', 'text-[#615A52]');\n            badge.classList.add('bg-[#FAF0E6]', 'text-[#701500]');\n          }\n        }\n      } else {\n        if (panel) panel.classList.add('hidden');\n        if (btn) {\n          btn.classList.remove('active');\n          btn.classList.add('text-[#615A52]');\n          btn.classList.remove('text-[#701500]');\n          const badge = btn.querySelector('span:first-child');\n          if (badge) {\n            badge.classList.add('bg-[#EFEBE4]', 'text-[#615A52]');\n            badge.classList.remove('bg-[#FAF0E6]', 'text-[#701500]');\n          }\n        }\n      }\n    });\n  }\n</script>\n",
