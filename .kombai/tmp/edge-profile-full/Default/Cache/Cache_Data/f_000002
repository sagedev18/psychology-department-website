html { scroll-behavior: smooth; }
:root {
    --primary: #701500;
    --primary-dark: #4a0d00;
    --secondary: #f67665;
    --secondary-soft: #ffd4ca;
    --gold: #d9b15a;
    --gold-soft: #f5df9d;
    --pink: #ff70a6;
    --bg-primary: #fffdfd;
    --bg-secondary: #f5f5f5;
    --text-primary: #1a1a1a;
    --text-secondary: #5f636d;
    --shadow: 0 12px 30px rgba(112, 21, 0, 0.10);
    --shadow-hover: 0 18px 40px rgba(112, 21, 0, 0.18);
    --gradient-primary: linear-gradient(135deg, #701500 0%, #8d2008 100%);
    --gradient-secondary: linear-gradient(135deg, #f67665 0%, #ff8f79 100%);
    --gradient-gold: linear-gradient(135deg, #d9b15a 0%, #f4d98a 100%);
    --gradient-cool: linear-gradient(135deg, #701500 0%, #f67665 55%, #ff70a6 100%);
}

* { scroll-behavior: smooth; 
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

html, body {
    min-height: 100%;
}

body {
    padding-top: 0;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
    font-family: 'Poppins', sans-serif;
    letter-spacing: 0.01em;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

a {
    color: var(--primary);
    text-decoration: none;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

header {
    position: sticky;
    top: 0;
    z-index: 9999;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 22px rgba(112, 21, 0, 0.08);
    transform: translateY(0);
    transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
}

.header.is-scrolled {
    box-shadow: 0 12px 28px rgba(112, 21, 0, 0.12);
}

.header.header-hidden {
    transform: translateY(-120%);
}

.top-bar {
    background: var(--gradient-primary);
    color: var(--bg-primary);
    padding: 16px 0;
    border-bottom: 3px solid rgba(255, 112, 166, 0.85);
}

.top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-section {
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo-img {
    width: 65px;
    height: 65px;
    object-fit: contain;
    background: white;
    padding: 5px;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.logo-text h1 {
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    font-weight: 700;
    margin-bottom: 2px;
}

.logo-subtext {
    font-size: clamp(0.7rem, 1.5vw, 0.9rem);
    opacity: 0.95;
}

.mobile-menu-btn {
    display: none;
    background: transparent;
    border: 2px solid white;
    color: white;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.mobile-menu-btn:hover {
    background: rgba(255,255,255,0.1);
    transform: scale(1.05);
}

header .nav-bar {
    background: linear-gradient(90deg, var(--primary) 0%, #8b1d06 100%);
    padding: 10px 0;
}

.nav-menu {
    display: flex;
    list-style: none;
    justify-content: center;
    gap: 5px;
    flex-wrap: wrap;
}

.nav-item {
    position: relative;
}

.nav-link {
    color: var(--bg-primary);
    text-decoration: none;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 25px;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    font-weight: 500;
    font-size: 0.95rem;
}

.nav-link:hover {
    background: rgba(246, 118, 101, 0.3);
    transform: translateY(-2px);
}

.nav-item.active .nav-link {
    background: linear-gradient(135deg, var(--secondary) 0%, #ffd1cc 100%);
    color: var(--primary);
    box-shadow: 0 6px 18px rgba(246, 118, 101, 0.35);
}

.dropdown {
    position: relative;
}

.dropdown-toggle .fa-chevron-down {
    transition: transform 0.3s ease;
}

.dropdown:hover .dropdown-toggle .fa-chevron-down {
    transform: rotate(180deg);
}

.hero {
    position: relative;
    background: linear-gradient(135deg, rgba(112, 21, 0, 0.88) 0%, rgba(246, 118, 101, 0.68) 35%, rgba(255, 112, 166, 0.45) 100%),
                url('https://images.unsplash.com/photo-1532094349884-543bc11b234d?w=1600&h=600&fit=crop');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    padding: 90px 0 80px;
    color: white;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 18% 18%, rgba(255,255,255,0.18), transparent 26%);
}
@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
}

.hero-overlay {
    position: relative;
    z-index: 1;
    background: rgba(8, 27, 45, 0.18);
}

.hero-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    align-items: center;
}

.hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 15px;
    line-height: 1.2;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.3);
}

.hero-subtitle {
    font-size: clamp(1.2rem, 3vw, 2rem);
    margin-bottom: 15px;
    font-weight: 600;
    color: #fff;
}

.hero-description {
    font-size: 1.1rem;
    margin-bottom: 30px;
    opacity: 0.98;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

.btn::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.3);
    transition: width 0.6s, height 0.6s;
    transform: translate(-50%, -50%);
}

.btn:active::before {
    width: 300px;
    height: 300px;
}

.btn-primary {
    background: var(--gradient-secondary);
    color: var(--primary);
    box-shadow: 0 10px 25px rgba(246, 118, 101, 0.35);
}

.btn-primary:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 14px 30px rgba(246, 118, 101, 0.45);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: none;
}

.btn-secondary:hover {
    transform: translateY(-3px) scale(1.02);
    background: rgba(255, 255, 255, 0.2);
}

.hod-card {
    position: relative;
    background: rgba(255,255,255,0.95);
    color: var(--text-primary);
    border-radius: 24px;
    overflow: visible;
    box-shadow: 0 15px 50px rgba(0,0,0,0.3);
    transform: rotateY(-5deg) rotateX(2deg);
    transition: all 0.5s ease;
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: rotateY(-5deg) rotateX(2deg) translateY(0); }
    50% { transform: rotateY(-3deg) rotateX(1deg) translateY(-20px); }
}

.hod-card:hover {
    transform: rotateY(0deg) rotateX(0deg) translateY(-10px) scale(1.02);
    box-shadow: 0 20px 60px rgba(246, 118, 101, 0.4);
}

.hod-image-placeholder {
    position: relative;
    width: 100%;
    height: 320px;
    background: linear-gradient(135deg, rgba(112,21,0,0.16), rgba(246,118,101,0.18), rgba(255,112,166,0.12)), linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    color: var(--primary);
    text-align: center;
    border-radius: 24px 24px 0 0;
    border: 3px solid rgba(255,255,255,0.9);
    box-shadow: inset 0 0 0 1px rgba(112,21,0,0.08);
}

.hod-card::after {
    content: "";
    position: absolute;
    inset: auto 18px -18px 18px;
    height: 32px;
    background: rgba(112,21,0,0.12);
    filter: blur(18px);
    border-radius: 50%;
    z-index: -1;
}

.hod-placeholder-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 10px;
    line-height: 1.5;
}

.hod-info {
    position: relative;
    padding: 20px 18px 18px;
    text-align: center;
    background: linear-gradient(135deg, #701500 0%, #8f210a 100%);
    color: white;
    border-radius: 0 0 24px 24px;
    border-top: 4px solid #ff70a6;
}

.hod-title {
    font-weight: 600;
    font-size: 1.1rem;
}

.hod-card-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: rgba(255,255,255,0.9);
    color: var(--primary);
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    box-shadow: 0 8px 18px rgba(112,21,0,0.12);
}

.quick-links, .announcements, .search-section, .gallery-preview, .achievements, .admin-access, .home-showcase, .programme-showcase {
    padding: 60px 0;
}

.quick-links {
    background: radial-gradient(circle at top, #fff7f5 0%, var(--bg-secondary) 70%);
}

.home-showcase,
.programme-showcase {
    padding: 70px 0;
    background: linear-gradient(180deg, #fff 0%, #fff7f7 100%);
}

.skill-showcase .section-title {
    margin-bottom: 28px;
}

.skill-showcase .section-title i {
    color: var(--primary);
}

.feature-grid,
.programme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
}

.content-card {
    background: white;
    border-radius: 18px;
    box-shadow: var(--shadow);
    padding: 32px 28px;
    margin-bottom: 30px;
    border: 1px solid rgba(112,21,0,0.08);
    position: relative;
    overflow: hidden;
}

.content-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 55%, var(--pink) 100%);
}

.level-jump-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 24px;
}

.level-jump-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(112, 21, 0, 0.06);
    color: var(--primary);
    border: 1px solid rgba(112, 21, 0, 0.12);
    font-weight: 600;
    transition: all 0.25s ease;
}

.level-jump-nav a:hover {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(112, 21, 0, 0.12);
}

.view-description-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    padding: 10px 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(112, 21, 0, 0.12);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.view-description-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(112, 21, 0, 0.18);
}

.curriculum-wrapper {
    display: grid;
    gap: 28px;
}

.curriculum-level {
    background: linear-gradient(180deg, #fff 0%, #fff8f6 100%);
    border: 1px solid rgba(112, 21, 0, 0.08);
    border-radius: 20px;
    box-shadow: var(--shadow);
    padding: 24px;
}

.level-header {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    padding: 14px 20px;
    border-radius: 12px;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 20px;
    box-shadow: 0 10px 25px rgba(112, 21, 0, 0.18);
}

.semester-block {
    margin-bottom: 22px;
}

.semester-block:last-child {
    margin-bottom: 0;
}

.semester-block h3 {
    color: var(--primary);
    font-size: 1.65rem;
    margin-bottom: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
}

.course-sequence {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(112, 21, 0, 0.08);
    color: var(--primary);
    font-weight: 800;
    font-size: 0.8rem;
    flex-shrink: 0;
}

.table-wrap {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid rgba(112, 21, 0, 0.08);
    background: white;
}

.curriculum-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 820px;
}

.curriculum-table th,
.curriculum-table td {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(112,21,0,0.08);
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
}

.curriculum-table thead th {
    background: rgba(112, 21, 0, 0.06);
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.curriculum-table tbody tr:hover {
    background: rgba(246, 118, 101, 0.04);
}

.curriculum-table tbody td:first-child {
    font-weight: 600;
    color: var(--primary);
}

.total-row td {
    background: rgba(246, 118, 101, 0.09);
    font-weight: 700;
    color: var(--primary);
    text-align: right;
    padding-right: 18px;
}

.curriculum-summary {
    padding: 20px 24px;
}

.curriculum-summary .level-header {
    margin-bottom: 0;
}

.description-placeholder {
    background: rgba(112, 21, 0, 0.03);
    border: 1px dashed rgba(112, 21, 0, 0.2);
    border-radius: 12px;
    padding: 18px 20px;
    color: var(--text-secondary);
    line-height: 1.8;
}

.course-description-item {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(112, 21, 0, 0.08);
    border-radius: 16px;
    margin-bottom: 18px;
    overflow: hidden;
    box-shadow: 0 8px 22px rgba(112, 21, 0, 0.05);
}

.description-header {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 16px 20px 12px;
    background: linear-gradient(135deg, rgba(112, 21, 0, 0.06), rgba(246, 118, 101, 0.08));
    border-bottom: 1px solid rgba(112, 21, 0, 0.08);
}

.course-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 8px 12px;
    border-radius: 999px;
}

.course-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
}

.course-meta {
    color: var(--text-secondary);
    font-weight: 600;
}

.description-body {
    padding: 18px 20px 20px;
    color: var(--text-secondary);
    line-height: 1.7;
}

.description-body h4 {
    margin: 0 0 10px;
    color: var(--primary);
    font-size: 0.98rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.description-body ul {
    margin: 0 0 18px 18px;
    padding: 0;
}

.description-body li {
    margin-bottom: 6px;
}

.description-body p {
    margin: 0 0 12px;
}

.feature-card,
.programme-card {
    background: white;
    border-radius: 18px;
    padding: 28px 24px;
    box-shadow: var(--shadow);
    border: 1px solid rgba(112, 21, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.feature-card:hover,
.programme-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
}

.feature-icon {
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--secondary) 0%, #ffb1a8 100%);
    color: var(--primary);
    margin-bottom: 18px;
    font-size: 1.8rem;
    box-shadow: 0 10px 22px rgba(246, 118, 101, 0.22);
}

.feature-card h3,
.programme-card h3 {
    color: var(--primary);
    margin-bottom: 10px;
    font-size: 1.3rem;
}

.feature-card p,
.programme-card p {
    color: var(--text-secondary);
    line-height: 1.7;
}

.programme-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #fff 0%, #fffaf9 100%);
}

.programme-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 55%, var(--pink) 100%);
}

.programme-badge {
    display: inline-block;
    background: rgba(246, 118, 101, 0.12);
    color: var(--primary);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

.highlight-programme {
    background: linear-gradient(135deg, #701500 0%, #8d2008 100%);
    color: white;
}

.highlight-programme h3,
.highlight-programme p {
    color: white;
}

.highlight-programme .programme-badge {
    background: rgba(255,255,255,0.12);
    color: #fff;
}

.section-title {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 40px;
    text-align: center;
    font-weight: 700;
    position: relative;
    padding-bottom: 15px;
    letter-spacing: 0.02em;
}

.section-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 4px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 50%, var(--pink) 100%);
    border-radius: 999px;
}

.page-content .content-card .section-title {
    text-align: left;
    margin-bottom: 18px;
    padding-bottom: 12px;
    font-size: clamp(1.6rem, 2vw, 2.1rem);
    display: inline-block;
    width: auto;
}

.page-content .content-card .section-title::after {
    left: 0;
    transform: none;
    width: 100%;
}

.announcements .content-card .section-title i {
    margin-right: 10px;
    color: var(--primary);
    font-size: 1.1em;
    transform: translateY(-1px);
    filter: drop-shadow(0 4px 8px rgba(246, 118, 101, 0.22));
}

.quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

.quick-link-card {
    background: white;
    padding: 30px 25px;
    border-radius: 15px;
    text-decoration: none;
    color: var(--text-primary);
    text-align: center;
    box-shadow: var(--shadow);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

.quick-link-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--gradient-cool);
}

.quick-link-card:hover {
    transform: translateY(-10px) scale(1.03);
    box-shadow: var(--shadow-hover);
    background: linear-gradient(135deg, white 0%, #fff5f5 100%);
}

.quick-link-icon {
    width: 70px;
    height: 70px;
    background: var(--gradient-secondary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 20px;
    box-shadow: 0 4px 15px rgba(246, 118, 101, 0.3);
    transition: all 0.3s ease;
}

.quick-link-card:hover .quick-link-icon {
    transform: rotateY(360deg) scale(1.1);
    background: var(--gradient-cool);
}

.quick-link-card h3 {
    color: var(--primary);
    margin-bottom: 10px;
    font-size: 1.25rem;
}

.quick-link-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
}

.section-header .section-title {
    margin-bottom: 0;
}

.view-all {
    color: var(--secondary);
    text-decoration: none;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 25px;
    transition: all 0.3s ease;
}

.view-all:hover {
    background: rgba(246, 118, 101, 0.1);
    transform: translateX(5px);
}

.announcements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
}

.announcement-card {
    background: white;
    border-radius: 15px;
    box-shadow: var(--shadow);
    padding: 25px;
    display: flex;
    gap: 20px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
}

.announcement-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--gradient-secondary);
}

.announcement-card:hover {
    transform: translateX(8px) translateY(-5px);
    box-shadow: 0 12px 30px rgba(112, 21, 0, 0.15);
}

.announcement-date {
    background: var(--gradient-primary);
    color: white;
    padding: 10px 15px;
    border-radius: 10px;
    text-align: center;
    min-width: 65px;
    flex-shrink: 0;
}

.date-day {
    display: block;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
}

.date-month {
    display: block;
    font-size: 0.75rem;
    margin-top: 5px;
}

.announcement-content h3 {
    color: var(--primary);
    margin-bottom: 10px;
    font-size: 1.15rem;
}

.announcement-content p {
    color: var(--text-secondary);
    margin-bottom: 10px;
    font-size: 0.9rem;
}

.announcement-tag {
    display: inline-block;
    padding: 5px 12px;
    background: rgba(246, 118, 101, 0.15);
    color: var(--secondary);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
}
.search-section {
    background: var(--gradient-primary);
    color: white;
}

.search-section .section-title {
    color: white;
}

.search-section .section-title::after {
    background: white;
}

.search-box {
    display: flex;
    max-width: 700px;
    margin: 0 auto;
    background: white;
    border-radius: 50px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
}

.search-input {
    flex: 1;
    padding: 16px 25px;
    border: none;
    font-size: 1rem;
    font-family: 'Poppins', sans-serif;
    outline: none;
}

.search-btn {
    padding: 16px 40px;
    background: var(--gradient-secondary);
    color: white;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Poppins', sans-serif;
}

.search-btn:hover {
    background: #FF8C7A;
    transform: scale(1.05);
}

.search-results {
    margin-top: 30px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

.search-result-item {
    background: white;
    color: var(--text-primary);
    padding: 15px 25px;
    margin-bottom: 10px;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.gallery-item {
    border-radius: 15px;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all 0.4s ease;
    cursor: pointer;
}

.gallery-item:hover {
    transform: scale(1.05) rotate(-2deg);
    box-shadow: 0 15px 40px rgba(246, 118, 101, 0.3);
}

.gallery-placeholder {
    height: 250px;
    background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: 3rem;
}

.gallery-placeholder p {
    font-size: 0.9rem;
    margin-top: 10px;
}

.achievements {
    background: var(--bg-secondary);
}

.achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

.achievement-card {
    background: white;
    padding: 30px 25px;
    border-radius: 15px;
    text-align: center;
    box-shadow: var(--shadow);
    transition: all 0.4s ease;
    position: relative;
}

.achievement-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
}

.achievement-icon {
    width: 70px;
    height: 70px;
    background: var(--gradient-cool);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 20px;
    box-shadow: 0 4px 15px rgba(157, 78, 221, 0.3);
}
.achievement-card h3 {
    color: var(--primary);
    margin-bottom: 10px;
}

.achievement-card p {
    color: var(--text-secondary);
}

.admin-access {
    background: linear-gradient(135deg, #f5f5f5 0%, white 100%);
}

.admin-card {
    max-width: 600px;
    margin: 0 auto;
    background: white;
    border-radius: 20px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: 0 15px 50px rgba(112, 21, 0, 0.15);
    border: 3px dashed var(--secondary);
    position: relative;
    background-image: radial-gradient(circle at 0% 0%, rgba(246,118,101,0.05) 0%, white 70%);
}

.admin-icon {
    font-size: 4rem;
    background: var(--gradient-secondary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 20px;
}

.admin-card h2 {
    color: var(--primary);
    margin-bottom: 10px;
}

.admin-card p {
    color: var(--text-secondary);
    margin-bottom: 25px;
}

.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
    z-index: 2000;
    padding: 20px;
    backdrop-filter: blur(5px);
}

.modal-content {
    background: white;
    border-radius: 20px;
    max-width: 600px;
    max-height: 90vh;
    margin: 5vh auto;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    animation: modalSlide 0.3s ease;
}

@keyframes modalSlide {
    from { transform: translateY(-50px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.modal-header {
    background: var(--gradient-primary);
    color: white;
    padding: 20px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 20px 20px 0 0;
}

.modal-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    transition: all 0.3s ease;
}

.modal-close:hover {
    transform: rotate(90deg) scale(1.1);
}

.modal-body { padding-top: 0; 
    padding: 30px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--primary);
}

.form-input, .form-textarea, .form-select {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    font-size: 1rem;
    font-family: 'Poppins', sans-serif;
    transition: all 0.3s ease;
    outline: none;
}

.form-input:focus, .form-textarea:focus, .form-select:focus {
    border-color: var(--secondary);
    box-shadow: 0 0 0 3px rgba(246, 118, 101, 0.15);
}

.btn-full {
    width: 100%;
}
.footer {
    background: linear-gradient(180deg, var(--primary) 0%, #871f0d 100%);
    color: white;
    padding: 50px 0 20px;
    border-top: 4px solid var(--pink);
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-bottom: 30px;
}

.footer-section h3, .footer-section h4 {
    margin-bottom: 20px;
    color: var(--secondary);
}

.footer-section p {
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0.95;
}

.footer-links {
    list-style: none;
}

.footer-links li {
    margin-bottom: 10px;
}

.footer-links a {
    color: white;
    text-decoration: none;
    opacity: 0.9;
    transition: all 0.3s ease;
}

.footer-links a:hover {
    opacity: 1;
    color: var(--secondary);
    padding-left: 5px;
}

.footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.2);
    opacity: 0.9;
    margin-top: auto;
}

@media (max-width: 768px) {
    .mobile-menu-btn {
        display: block;
    }

    .nav-menu {
        flex-direction: column;
        padding: 20px 0;
        display: none;
    }

    .nav-menu.active {
        display: flex;
    }

    .dropdown-menu {
        position: static;
        opacity: 1;
        visibility: visible;
        transform: none;
        margin-top: 0;
        box-shadow: none;
        background: rgba(255,255,255,0.1);
        display: none;
    }

    .dropdown.active .dropdown-menu {
        display: block;
    }

    .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-hod {
        display: none;
    }

    .section-header {
        flex-direction: column;
        text-align: center;
    }
}

.page-hero {
    background: var(--gradient-primary);
    color: white;
    padding: 60px 0 40px;
    text-align: center;
}

.page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 10px;
}

.breadcrumb {
    display: flex;
    justify-content: center;
    gap: 10px;
    list-style: none;
    flex-wrap: wrap;
}

.breadcrumb li {
    display: flex;
    align-items: center;
    gap: 10px;
}

.breadcrumb a {
    color: white;
    opacity: 0.9;
    text-decoration: none;
}

.breadcrumb a:hover {
    opacity: 1;
}

.page-content {
    padding: 60px 0;
}

.content-card {
    background: white;
    border-radius: 18px;
    padding: 36px 32px;
    box-shadow: var(--shadow);
    margin-bottom: 30px;
    border: 1px solid rgba(13, 35, 64, 0.06);
}

.feature-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: grid;
    gap: 12px;
}

.feature-list li {
    position: relative;
    padding-left: 26px;
    color: var(--text-primary);
    line-height: 1.75;
}

.feature-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--secondary) 0%, var(--pink) 100%);
    box-shadow: 0 0 0 4px rgba(246, 118, 101, 0.12);
}

.announcement-tag {
    display: inline-block;
    background: rgba(247, 118, 101, 0.12);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
}

.event-status-upcoming {
    background: rgba(236, 72, 153, 0.12);
    color: #be185d;
}

.event-status-ongoing {
    background: rgba(247, 118, 101, 0.15);
    color: #b45309;
}

.event-status-past {
    background: rgba(107, 114, 128, 0.12);
    color: #4b5563;
}

.event-card {
    background: linear-gradient(180deg, #fff 0%, #fffaf9 100%);
    border: 1px solid rgba(112, 21, 0, 0.08);
    border-left: 5px solid var(--secondary);
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: 0 12px 28px rgba(112, 21, 0, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    margin-top: 14px;
}

.event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 30px rgba(112, 21, 0, 0.12);
}

.event-card-past {
    border-left-color: #8d99ae;
    background: linear-gradient(180deg, #fff 0%, #f6f7f9 100%);
}

.event-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
}

.event-card h3 {
    margin: 0;
    color: var(--primary);
    font-size: 1.2rem;
}

.event-card-body {
    display: grid;
    gap: 8px;
}

.event-meta {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.96rem;
}

.event-description {
    margin: 6px 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
}

.exam-download-card {
    border-left: 5px solid var(--secondary);
    background: linear-gradient(180deg, #fff 0%, #faf5ea 100%);
}

.exam-download-action {
    margin-top: 20px;
}
/* accordion */
.accordion-btn {
    width: 100%;
    background: var(--gradient-primary);
    color: white;
    border: none;
    padding: 15px 20px;
    border-radius: 10px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: 'Poppins', sans-serif;
    transition: all 0.3s ease;
}

.accordion-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 25px rgba(112, 21, 0, 0.15);
}

.accordion-btn span {
    display: flex;
    align-items: center;
    gap: 10px;
}

.accordion-icon {
    transition: transform 0.25s ease;
}

.accordion-btn.active .accordion-icon {
    transform: rotate(180deg);
}

.accordion-content {
    display: none;
    margin-top: 15px;
}

.accordion-content.open {
    display: block;
}

.sub-section {
    background: var(--bg-secondary);
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 15px;
    border-left: 4px solid var(--secondary);
}

.sub-section h3 {
    color: var(--primary);
    margin-bottom: 12px;
}

.sub-section ul {
    margin-left: 20px;
    color: var(--text-primary);
}

.sub-section li {
    margin-bottom: 8px;
}
\n.hero-badge {
    display: inline-block;
    padding: 8px 20px;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    margin-bottom: 15px;
    border: 2px solid rgba(255,255,255,0.3);
    font-weight: 600;
    animation: fadeInDown 1s ease;
}
@keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}

.achievement-card, .quick-link-card, .announcement-card, .content-card, .gallery-item {
    animation: fadeInUp 0.8s ease forwards;
}
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}
.gradient-text {
    background: linear-gradient(90deg, #fff 0%, #FF70A6 50%, #F4E06A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
#main-content {
    padding-top: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}
